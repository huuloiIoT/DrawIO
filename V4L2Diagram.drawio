        <mxCell id="CcBiSWCES-1M4_b4SoTJ-7" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;gradientColor=none;" value="&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;extern&lt;/span&gt; &lt;span style=&quot;color: rgb(255, 123, 114);&quot;&gt;int&lt;/span&gt; &lt;span style=&quot;color: rgb(210, 168, 255);&quot;&gt;__platform_driver_register&lt;/span&gt;(&lt;span style=&quot;color: rgb(255, 123, 114);&quot;&gt;struct&lt;/span&gt; &lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;platform_driver&lt;/span&gt; &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;*&lt;/span&gt;, &lt;span style=&quot;color: rgb(255, 123, 114);&quot;&gt;struct&lt;/span&gt; &lt;span style=&quot;color: rgb(78, 201, 176);&quot;&gt;module&lt;/span&gt; &lt;span style=&quot;color: rgb(86, 156, 214);&quot;&gt;*&lt;/span&gt;);&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
