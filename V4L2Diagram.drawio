        <mxCell id="CcBiSWCES-1M4_b4SoTJ-14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;gradientColor=none;" value="&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: rgb(197, 134, 192);&quot;&gt;&lt;div style=&quot;color: rgb(187, 190, 191); line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;/**&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* module_driver() - Helper macro for drivers that don&#39;t do anything&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* special in module init/exit. This eliminates a lot of boilerplate.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* Each module may only use this macro once, and calling it replaces&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* module_init() and module_exit().&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;*&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* &lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;@__driver:&lt;/span&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt; driver name&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* &lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;@__register:&lt;/span&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt; register function for this driver type&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* &lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;@__unregister:&lt;/span&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt; unregister function for this driver type&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* @...: Additional arguments to be passed to __register and __unregister.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;*&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* Use this macro to construct bus specific macros for registering&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* drivers, and do not use it on its own.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;*/&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;#define&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;module_driver&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #ffa657;&quot;&gt;__driver&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: #ffa657;&quot;&gt;__register&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;, &lt;/span&gt;&lt;span style=&quot;color: #ffa657;&quot;&gt;__unregister&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;, ...) &lt;/span&gt;&lt;span style=&quot;color: #d7ba7d;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;static &lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;int&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;__init&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt; __driver&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;##_init&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;void&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;) &lt;/span&gt;&lt;span style=&quot;color: #d7ba7d;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;{ &lt;/span&gt;&lt;span style=&quot;color: #d7ba7d;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #c586c0;&quot;&gt;return&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #d2a8ff;&quot;&gt;__register&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;amp;&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;(__driver) , ##__VA_ARGS__); &lt;/span&gt;&lt;span style=&quot;color: #d7ba7d;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;module_init&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;(__driver&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;##_init&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;); &lt;/span&gt;&lt;span style=&quot;color: #d7ba7d;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;static &lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;void&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;__exit&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt; __driver&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;##_exit&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;void&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;) &lt;/span&gt;&lt;span style=&quot;color: #d7ba7d;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;{ &lt;/span&gt;&lt;span style=&quot;color: #d7ba7d;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;&amp;nbsp; &amp;nbsp; &lt;/span&gt;&lt;span style=&quot;color: #d2a8ff;&quot;&gt;__unregister&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #d4d4d4;&quot;&gt;&amp;amp;&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;(__driver) , ##__VA_ARGS__); &lt;/span&gt;&lt;span style=&quot;color: #d7ba7d;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;}&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;\&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;module_exit&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;(__driver&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt;##_exit&lt;/span&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;);&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="470" width="570" x="850" y="320" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-17" edge="1" parent="1" source="CcBiSWCES-1M4_b4SoTJ-16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="CcBiSWCES-1M4_b4SoTJ-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;gradientColor=none;" value="&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: rgb(197, 134, 192);&quot;&gt;&lt;div style=&quot;color: rgb(187, 190, 191); line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;1. &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;##__VA_ARGS__&lt;/code&gt;&lt;/h1&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;...&lt;/code&gt; trong danh sách tham số nghĩa là macro &lt;strong&gt;nhận thêm số tham số tùy ý&lt;/strong&gt;. &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__VA_ARGS__&lt;/code&gt; là chỗ để dán đám tham số dư đó vào.&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;#define module_driver(__driver, __register, __unregister, ...) \&lt;br/&gt;&#x9;return __register(&amp;amp;(__driver) , ##__VA_ARGS__); \&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;Tại sao có dấu &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;##&lt;/code&gt; trước nó&lt;/h2&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Đây &lt;strong&gt;không phải&lt;/strong&gt; token pasting như &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__driver##_init&lt;/code&gt;. Đây là &lt;strong&gt;GNU extension &quot;comma swallowing&quot;&lt;/strong&gt; — một ý nghĩa hoàn toàn khác của &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;##&lt;/code&gt; khi nó đứng giữa dấu phẩy và &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__VA_ARGS__&lt;/code&gt;:&lt;/p&gt;&lt;blockquote style=&quot;background: none 0% 0% / auto repeat scroll padding-box border-box rgb(36, 37, 38); border-color: rgb(42, 43, 44); color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: normal;&quot;&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em;&quot;&gt;Nếu &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__VA_ARGS__&lt;/code&gt; rỗng thì &lt;strong&gt;xoá luôn dấu phẩy đứng ngay trước&lt;/strong&gt;.&lt;/p&gt;&lt;/blockquote&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Không có &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;##&lt;/code&gt;, khi bạn gọi macro với đúng 3 tham số:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;return platform_driver_register(&amp;amp;(vt_sovra_driver) , );&lt;br/&gt;                                                    ^^^ dấu phẩy thừa → lỗi compile&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Có &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;##&lt;/code&gt;, preprocessor nuốt dấu phẩy đó đi:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;return platform_driver_register(&amp;amp;(vt_sovra_driver));&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Đó chính là lý do sau khi preprocess bạn &lt;strong&gt;không còn thấy gì&lt;/strong&gt; — cả &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__VA_ARGS__&lt;/code&gt; lẫn dấu phẩy đều biến mất, vì &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;module_platform_driver&lt;/code&gt; chỉ truyền xuống 3 tham số, phần variadic rỗng.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="510" width="700" x="1645" y="20" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-19" edge="1" parent="1" source="CcBiSWCES-1M4_b4SoTJ-18" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="CcBiSWCES-1M4_b4SoTJ-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;gradientColor=none;" value="&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: rgb(197, 134, 192);&quot;&gt;&lt;div style=&quot;color: rgb(187, 190, 191); line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;2. &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__init&lt;/code&gt;&lt;/h1&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; font-size: 13px; font-weight: 400;&quot;&gt;Không phải kiểu dữ liệu, mà là &lt;strong&gt;attribute đặt hàm vào một section riêng của ELF&lt;/strong&gt;. Định nghĩa ở &lt;a href=&quot;vscode-webview://0g1coahr3ppelg5ie47k0qapenccacs370n9rs6rekdp7h3ffhkr/usr/src/linux-hwe-6.17-headers-6.17.0-35/include/linux/init.h#L52&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;init.h:52&lt;/a&gt;:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; font-size: 13px; font-weight: 400;&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;#define __init&#x9;&#x9;__section(&quot;.init.text&quot;) __cold __latent_entropy ...&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; font-size: 13px; font-weight: 400;&quot;&gt;Nên &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static int __init vt_sovra_driver_init(void)&lt;/code&gt; đọc là: &lt;em&gt;hàm &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static&lt;/code&gt;, trả &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;int&lt;/code&gt;, và code của nó nằm trong section &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.init.text&lt;/code&gt;.&lt;/em&gt;&lt;/p&gt;&lt;/h1&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;Mục đích: thu hồi bộ nhớ&lt;/h2&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; font-size: 13px; font-weight: 400;&quot;&gt;Hàm init chỉ chạy &lt;strong&gt;đúng một lần&lt;/strong&gt; lúc nạp module rồi vô dụng mãi mãi. Kernel gom mọi hàm &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.init.text&lt;/code&gt; vào một vùng liền nhau; chạy xong &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;do_initcalls()&lt;/code&gt;, nó &lt;strong&gt;free toàn bộ vùng đó&lt;/strong&gt; trả lại cho page allocator. Bạn thấy dòng này lúc boot:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; font-size: 13px; font-weight: 400;&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;Freeing unused kernel image (initmem) memory: 2048K&lt;br&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; font-size: 13px; font-weight: 400;&quot;&gt;Với module thì tương tự: &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;module_init&lt;/code&gt; section được unload ngay sau khi hàm init chạy xong. Trên hệ nhúng như con ISP bạn đang làm, vài trăm KB tiết kiệm được là đáng kể.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; font-size: 13px; font-weight: 400;&quot;&gt;Các attribute đi kèm: &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__cold&lt;/code&gt; báo GCC hàm này hiếm chạy → tối ưu theo hướng nhỏ gọn thay vì nhanh, và đẩy nó ra xa khỏi hot path để đỡ bẩn i-cache.&lt;/p&gt;&lt;/h1&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;Cái bẫy thường gặp&lt;/h2&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; white-space: normal; background-color: rgb(25, 26, 27);&quot;&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; font-size: 13px; font-weight: 400;&quot;&gt;Đây là lý do bạn phải cẩn thận với con trỏ: nếu một hàm &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__init&lt;/code&gt; bị lưu lại và gọi sau khi init xong, bạn gọi vào vùng nhớ đã free → oops. Vì thế &lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.probe&lt;/code&gt; tuyệt đối không được đánh dấu &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__init&lt;/code&gt;&lt;/strong&gt; — probe có thể chạy lại bất cứ lúc nào khi device được bind (hotplug, deferred probe, unbind/bind qua sysfs).&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; font-size: 13px; font-weight: 400;&quot;&gt;Trong &lt;a href=&quot;vscode-webview://0g1coahr3ppelg5ie47k0qapenccacs370n9rs6rekdp7h3ffhkr/ISP_DRIVER/vt-sovra-core.c#L486&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;vt-sovra-core.c:486&lt;/a&gt; bạn để &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.probe = vt_sovra_probe&lt;/code&gt; với &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;vt_sovra_probe&lt;/code&gt; không có &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__init&lt;/code&gt; — như vậy là đúng. Nếu lỡ thêm vào, script &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;scripts/mod/modpost&lt;/code&gt; lúc build sẽ cảnh báo &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;Section mismatch in reference from ... to .init.text&lt;/code&gt;.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; font-size: 13px; font-weight: 400;&quot;&gt;Họ attribute cùng nhóm, dùng cho dữ liệu thay vì code: &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__initdata&lt;/code&gt;, &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__initconst&lt;/code&gt;, &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__exitdata&lt;/code&gt;, &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__devinit&lt;/code&gt; (đã bỏ từ 3.8).&lt;/p&gt;&lt;/h1&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="620" width="700" x="1645" y="540" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-24" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;gradientColor=none;" value="&lt;div style=&quot;background-color: rgb(18, 19, 20); line-height: 19px; color: rgb(187, 190, 191);&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: rgb(197, 134, 192);&quot;&gt;&lt;div style=&quot;line-height: 19px; color: rgb(187, 190, 191);&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;font color=&quot;#8b949e&quot; face=&quot;Consolas, Courier New, monospace&quot;&gt;&lt;span style=&quot;font-size: 14px; white-space: pre;&quot;&gt;/* ---- phần 1: hàm init ---- */&lt;br/&gt;static int __attribute__((__section__(&quot;.init.text&quot;)))&lt;br/&gt;           __attribute__((__cold__))&lt;br/&gt;vt_sovra_driver_init(void)&lt;br/&gt;{&lt;br/&gt;&#x9;return platform_driver_register(&amp;amp;(vt_sovra_driver));&lt;br/&gt;}&lt;br/&gt;&lt;br/&gt;/* ---- phần 2: module_init(vt_sovra_driver_init) ---- */&lt;br/&gt;static inline initcall_t __attribute__((__unused__)) __inittest(void)&lt;br/&gt;{&lt;br/&gt;&#x9;return vt_sovra_driver_init;&lt;br/&gt;}&lt;br/&gt;&lt;br/&gt;int init_module(void)&lt;br/&gt;&#x9;__attribute__((__copy__(vt_sovra_driver_init)))&lt;br/&gt;&#x9;__attribute__((alias(&quot;vt_sovra_driver_init&quot;)));&lt;br/&gt;&lt;br/&gt;static void * __attribute__((__used__)) __initdata&lt;br/&gt;&#x9;__addressable_init_module_42 = (void *)(uintptr_t)&amp;amp;init_module;&lt;br/&gt;&lt;br/&gt;/* ---- phần 3: hàm exit ---- */&lt;br/&gt;static void __attribute__((__section__(&quot;.exit.text&quot;)))&lt;br/&gt;            __exitused&lt;br/&gt;            __attribute__((__cold__))&lt;br/&gt;            notrace&lt;br/&gt;vt_sovra_driver_exit(void)&lt;br/&gt;{&lt;br/&gt;&#x9;platform_driver_unregister(&amp;amp;(vt_sovra_driver));&lt;br/&gt;}&lt;br/&gt;&lt;br/&gt;/* ---- phần 4: module_exit(vt_sovra_driver_exit) ---- */&lt;br/&gt;static inline exitcall_t __attribute__((__unused__)) __exittest(void)&lt;br/&gt;{&lt;br/&gt;&#x9;return vt_sovra_driver_exit;&lt;br/&gt;}&lt;br/&gt;&lt;br/&gt;void cleanup_module(void)&lt;br/&gt;&#x9;__attribute__((__copy__(vt_sovra_driver_exit)))&lt;br/&gt;&#x9;__attribute__((alias(&quot;vt_sovra_driver_exit&quot;)));&lt;br/&gt;&lt;br/&gt;static void * __attribute__((__used__)) __exitdata&lt;br/&gt;&#x9;__addressable_cleanup_module_43 = (void *)(uintptr_t)&amp;amp;cleanup_module;&lt;/span&gt;&lt;/font&gt;&lt;br/&gt;&lt;/div&gt;&lt;div style=&quot;color: light-dark(rgb(187, 190, 191), rgb(73, 75, 76)); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; white-space: pre;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="900" width="560" x="855" y="860" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;gradientColor=none;" value="&lt;div style=&quot;background-color: rgb(18, 19, 20); line-height: 19px; color: rgb(187, 190, 191);&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: rgb(197, 134, 192);&quot;&gt;&lt;div style=&quot;line-height: 19px; color: rgb(187, 190, 191);&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; background-color: rgb(25, 26, 27);&quot;&gt;Phần 1 — Hàm init&lt;/h1&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static int __attribute__((__section__(&quot;.init.text&quot;)))&lt;br/&gt;           __attribute__((__cold__))&lt;br/&gt;vt_sovra_driver_init(void)&lt;br/&gt;{&lt;br/&gt;&#x9;return platform_driver_register(&amp;amp;(vt_sovra_driver));&lt;br/&gt;}&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static&lt;/code&gt;&lt;/strong&gt; — symbol chỉ hiện trong file này. Nghe mâu thuẫn với việc kernel phải gọi được nó, nhưng không: kernel gọi qua alias &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;init_module&lt;/code&gt; (phần 2), còn bản thân tên này không cần lộ ra ngoài. Giữ &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static&lt;/code&gt; để tránh đụng tên với driver khác.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__section__(&quot;.init.text&quot;)&lt;/code&gt;&lt;/strong&gt; — nhét code hàm vào section ELF riêng thay vì &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.text&lt;/code&gt; mặc định. Với module, loader &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;kernel/module/main.c&lt;/code&gt; cấp phát vùng nhớ cho &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.init.text&lt;/code&gt;, chạy hàm, rồi &lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;module_memfree()&lt;/code&gt; trả vùng đó về page allocator&lt;/strong&gt;. Từ đó trở đi module chỉ còn chiếm phần &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.text&lt;/code&gt; thật sự cần.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__cold__&lt;/code&gt;&lt;/strong&gt; — hint cho GCC rằng nhánh này hiếm khi chạy. Ba hệ quả: tối ưu theo &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;-Os&lt;/code&gt; thay vì &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;-O2&lt;/code&gt; cho riêng hàm này, mọi nhánh dẫn tới nó bị coi là unlikely, và code được gom về vùng &quot;cold&quot; tách khỏi hot path để không làm bẩn i-cache.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;Thân hàm&lt;/strong&gt; — &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;&amp;amp;(vt_sovra_driver)&lt;/code&gt; có ngoặc thừa là do macro viết &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;&amp;amp;(__driver)&lt;/code&gt; phòng trường hợp tham số là biểu thức. Ở đây vô hại.&lt;/p&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; background-color: rgb(25, 26, 27);&quot;&gt;Phần 2 — &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;module_init&lt;/code&gt; bung ra&lt;/h1&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; background-color: rgb(25, 26, 27);&quot;&gt;2a. Type check không tốn byte nào&lt;/h2&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static inline initcall_t __attribute__((__unused__)) __inittest(void)&lt;br/&gt;{&lt;br/&gt;&#x9;return vt_sovra_driver_init;&lt;br/&gt;}&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Như đã nói ở lượt trước: ép compiler kiểm tra chữ ký hàm khớp &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;int (*)(void)&lt;/code&gt;. &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static inline&lt;/code&gt; + &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__unused__&lt;/code&gt; → không sinh code, không cảnh báo.&lt;/p&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; background-color: rgb(25, 26, 27);&quot;&gt;2b. Tạo entry point mà loader tìm được&lt;/h2&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;int init_module(void)&lt;br/&gt;&#x9;__attribute__((__copy__(vt_sovra_driver_init)))&lt;br/&gt;&#x9;__attribute__((alias(&quot;vt_sovra_driver_init&quot;)));&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;alias&lt;/code&gt;&lt;/strong&gt; tạo symbol thứ hai trỏ vào &lt;strong&gt;cùng địa chỉ&lt;/strong&gt;. &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;insmod&lt;/code&gt;/&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;finit_module&lt;/code&gt; tra bảng symbol tìm đúng tên &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;init_module&lt;/code&gt; — đó là giao ước cố định giữa kernel và mọi &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.ko&lt;/code&gt;.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__copy__(f)&lt;/code&gt;&lt;/strong&gt; là attribute ít gặp, đáng nói kỹ. Nó bảo GCC: &lt;em&gt;sao chép toàn bộ attribute của &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;f&lt;/code&gt; sang symbol này&lt;/em&gt;. Cần thiết vì &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;alias&lt;/code&gt; chỉ nối địa chỉ, &lt;strong&gt;không nối attribute&lt;/strong&gt;. Không có &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__copy__&lt;/code&gt;, &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;init_module&lt;/code&gt; sẽ là một symbol &quot;bình thường&quot; trong khi thứ nó trỏ tới lại nằm ở &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.init.text&lt;/code&gt; — GCC phát cảnh báo mismatch, và tệ hơn là các attribute như &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__cold&lt;/code&gt;, &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;noreturn&lt;/code&gt;, hay CFI type-id không được kế thừa đúng. Nó được thêm vào kernel năm 2019 chính vì lỗi cảnh báo dạng này.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Kiểm chứng bằng chính &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.ko&lt;/code&gt; của bạn — hai dòng sẽ cùng địa chỉ:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-bash&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;nm -n ISP_DRIVER/vt-sovra.ko | grep -E &quot;init_module|vt_sovra_driver_init&quot;&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; background-color: rgb(25, 26, 27);&quot;&gt;2c. Neo symbol để linker không cắt&lt;/h2&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static void * __attribute__((__used__)) __initdata&lt;br/&gt;&#x9;__addressable_init_module_42 = (void *)(uintptr_t)&amp;amp;init_module;&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Định nghĩa gốc &lt;a href=&quot;vscode-webview://0g1coahr3ppelg5ie47k0qapenccacs370n9rs6rekdp7h3ffhkr/usr/src/linux-hwe-6.17-headers-6.17.0-35/include/linux/compiler.h#L284-L286&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;compiler.h:284-286&lt;/a&gt;, và &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__initdata&lt;/code&gt; = &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__section(&quot;.init.data&quot;)&lt;/code&gt; (&lt;a href=&quot;vscode-webview://0g1coahr3ppelg5ie47k0qapenccacs370n9rs6rekdp7h3ffhkr/usr/src/linux-hwe-6.17-headers-6.17.0-35/include/linux/init.h#L55&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;init.h:55&lt;/a&gt;).&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Vấn đề nó giải quyết: &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;init_module&lt;/code&gt; chỉ là alias, &lt;strong&gt;không có lệnh nào trong file gọi nó&lt;/strong&gt;. Với &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;-ffunction-sections --gc-sections&lt;/code&gt;, hoặc nhất là khi bật LTO, linker thấy symbol không ai tham chiếu và cắt bỏ → module load lên báo lỗi vô nghĩa. Biến con trỏ này tạo ra một tham chiếu &lt;strong&gt;thật&lt;/strong&gt; ở tầng object file, còn &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__used__&lt;/code&gt; cấm compiler xoá chính biến đó dù không ai đọc nó.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Vì sao đặt ở &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.init.data&lt;/code&gt;: con trỏ này chỉ có ý nghĩa lúc load, nên nó được free cùng lúc với &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.init.text&lt;/code&gt;. Neo mà không tốn bộ nhớ vĩnh viễn.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Hậu tố &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;_42&lt;/code&gt; do &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__UNIQUE_ID()&lt;/code&gt; sinh từ &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__COUNTER__&lt;/code&gt; — mỗi lần dùng ra một số khác, để nhiều &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;___ADDRESSABLE&lt;/code&gt; trong cùng file không trùng tên. (Số 42/43 là stub của mình, số thật tuỳ vị trí trong file.)&lt;/p&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; background-color: rgb(25, 26, 27);&quot;&gt;Phần 3 — Hàm exit&lt;/h1&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static void __attribute__((__section__(&quot;.exit.text&quot;)))&lt;br/&gt;            __exitused&lt;br/&gt;            __attribute__((__cold__))&lt;br/&gt;            notrace&lt;br/&gt;vt_sovra_driver_exit(void)&lt;br/&gt;{&lt;br/&gt;&#x9;platform_driver_unregister(&amp;amp;(vt_sovra_driver));&lt;br/&gt;}&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.exit.text&lt;/code&gt;&lt;/strong&gt; — đối xứng với &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.init.text&lt;/code&gt;. Khác biệt quan trọng: nếu kernel build &lt;strong&gt;không&lt;/strong&gt; bật &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;CONFIG_MODULE_UNLOAD&lt;/code&gt;, linker script vứt thẳng section này lúc link, vì driver built-in không bao giờ gỡ.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__exitused&lt;/code&gt;&lt;/strong&gt; — &lt;a href=&quot;vscode-webview://0g1coahr3ppelg5ie47k0qapenccacs370n9rs6rekdp7h3ffhkr/usr/src/linux-hwe-6.17-headers-6.17.0-35/include/linux/init.h#L81-L85&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;init.h:81-85&lt;/a&gt; cho thấy nó có điều kiện:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;#ifdef MODULE&lt;br/&gt;#define __exitused&lt;br/&gt;#else&lt;br/&gt;#define __exitused  __used&lt;br/&gt;#endif&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Build thành &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.ko&lt;/code&gt; (trường hợp của bạn) → &lt;strong&gt;rỗng, biến mất hoàn toàn&lt;/strong&gt;. Build built-in → thành &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__used&lt;/code&gt; để compiler đừng xoá hàm trước khi linker kịp quyết định giữ hay bỏ section.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;notrace&lt;/code&gt;&lt;/strong&gt; — trên x86 là &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__no_instrument_function__&lt;/code&gt; (&lt;a href=&quot;vscode-webview://0g1coahr3ppelg5ie47k0qapenccacs370n9rs6rekdp7h3ffhkr/usr/src/linux-hwe-6.17-headers-6.17.0-35/include/linux/compiler_types.h#L231&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;compiler_types.h:231&lt;/a&gt;). Cấm GCC chèn lệnh &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;call __fentry__&lt;/code&gt; ở đầu hàm — cái móc mà ftrace dùng để trace function. Cần thiết vì hàm nằm trong section có thể bị free/discard: nếu ftrace đăng ký được một trampoline trỏ vào đây rồi vùng nhớ biến mất, bạn có một con trỏ treo trong hạ tầng tracing.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Để ý &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__init&lt;/code&gt; &lt;strong&gt;không&lt;/strong&gt; có &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;notrace&lt;/code&gt;, còn &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__exit&lt;/code&gt; thì có — bất đối xứng có chủ ý, vì đường gỡ module chạy trong ngữ cảnh khó xử lý hơn.&lt;/p&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; background-color: rgb(25, 26, 27);&quot;&gt;Phần 4 — &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;module_exit&lt;/code&gt; bung ra&lt;/h1&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Đối xứng hoàn toàn với phần 2, ba khác biệt:&lt;/p&gt;&lt;ul style=&quot;padding-inline-start: 2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;&lt;li&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;exitcall_t&lt;/code&gt; là &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;void (*)(void)&lt;/code&gt; (&lt;a href=&quot;vscode-webview://0g1coahr3ppelg5ie47k0qapenccacs370n9rs6rekdp7h3ffhkr/usr/src/linux-hwe-6.17-headers-6.17.0-35/include/linux/init.h#L118&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199);&quot;&gt;init.h:118&lt;/a&gt;) — không trả giá trị, vì gỡ module thì không có đường lùi, thất bại cũng không làm gì được&lt;/li&gt;&lt;li&gt;symbol cố định là &lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;cleanup_module&lt;/code&gt;&lt;/strong&gt;, cái &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;rmmod&lt;/code&gt; đi tìm&lt;/li&gt;&lt;li&gt;neo đặt ở &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.exit.data&lt;/code&gt; thay vì &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.init.data&lt;/code&gt;&lt;/li&gt;&lt;/ul&gt;&lt;h1 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; background-color: rgb(25, 26, 27);&quot;&gt;Tóm lại một dòng macro đó làm gì&lt;/h1&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background-color: rgb(25, 26, 27);&quot;&gt;Đặt code init/exit vào section có thể thu hồi, tạo hai symbol tên cố định để &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;insmod&lt;/code&gt;/&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;rmmod&lt;/code&gt; bám vào, ép compiler check chữ ký, và neo symbol để linker/LTO không cắt nhầm. Bốn việc, không việc nào rườm rà — nhưng viết tay đủ 4 thì lặp lại y hệt ở hàng nghìn driver, nên kernel gói thành macro.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="2030" width="810" x="-20" y="840" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-32" edge="1" parent="1" source="CcBiSWCES-1M4_b4SoTJ-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="CcBiSWCES-1M4_b4SoTJ-31">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-29" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;gradientColor=none;" value="&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;MODULE_DESCRIPTION&lt;/span&gt;(&lt;span style=&quot;color: #a5d6ff;&quot;&gt;&quot;VT Sovra DDR-split imaging subsystem&quot;&lt;/span&gt;);&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="20" width="450" x="3399.5" y="-770" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-34" edge="1" parent="1" source="CcBiSWCES-1M4_b4SoTJ-31" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="CcBiSWCES-1M4_b4SoTJ-33">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-31" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="315" width="629" x="3310" y="-707" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1A3300;" value="&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Chuỗi macro&lt;/h2&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/include/linux/module.h#L239&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;module.h:239&lt;/a&gt; → &lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/include/linux/moduleparam.h#L33&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;moduleparam.h:33&lt;/a&gt;:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_DESCRIPTION(_description)  →  MODULE_INFO(description, _description)&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_INFO&lt;/code&gt; sinh ra &lt;strong&gt;hai thứ tách biệt&lt;/strong&gt;, và điểm mấu chốt là: cả hai đều &lt;strong&gt;không tạo ra code chạy lúc runtime&lt;/strong&gt;.&lt;/p&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;1. &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static_assert&lt;/code&gt; — kiểm tra lúc biên dịch&lt;/h2&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static_assert(sizeof(info) - 1 == __builtin_strlen(info),&lt;br/&gt;              &quot;MODULE_INFO(&quot; #tag &quot;, ...) contains embedded NUL byte&quot;);&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Hai cách đo độ dài chuỗi:&lt;/p&gt;&lt;ul style=&quot;padding-inline-start: 2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;li&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;sizeof(&quot;...&quot;) - 1&lt;/code&gt; → kích thước mảng trừ NUL cuối = &lt;strong&gt;35&lt;/strong&gt; (đếm toàn bộ byte)&lt;/li&gt;&lt;li&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__builtin_strlen(&quot;...&quot;)&lt;/code&gt; → dừng ở &lt;strong&gt;NUL đầu tiên&lt;/strong&gt; gặp phải&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Bình thường hai giá trị bằng nhau. Nếu chuỗi lẫn NUL ở giữa (vd &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;&quot;abc\0def&quot;&lt;/code&gt;), &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;strlen&lt;/code&gt; trả 3 còn &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;sizeof-1&lt;/code&gt; trả 7 → assert fail. Cần thiết vì &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.modinfo&lt;/code&gt; là chuỗi các string phân tách bằng NUL — một NUL lạc giữa chuỗi sẽ &lt;strong&gt;cắt đứt&lt;/strong&gt; phần còn lại khi parse. Đây là &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;_Static_assert&lt;/code&gt;, chỉ tồn tại lúc compile, biến mất hoàn toàn trong binary.&lt;/p&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;2. Biến đặt vào section &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.modinfo&lt;/code&gt;&lt;/h2&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static const char __UNIQUE_ID_modinfo_2[] __used __section(&quot;.modinfo&quot;) __aligned(1)&lt;br/&gt;        = &quot;description&quot; &quot;=&quot; &quot;VT Sovra DDR-split imaging subsystem&quot;;&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Ba attribute, mỗi cái giải một vấn đề cụ thể:&lt;/p&gt;&lt;table style=&quot;border-collapse: collapse; border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;Attribute&lt;/th&gt;&lt;th style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;Ý nghĩa&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__used&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;Biến static không ai đọc → compiler sẽ xóa. &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__used&lt;/code&gt; ép giữ lại.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__section(&quot;.modinfo&quot;)&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;Đẩy vào ELF section riêng thay vì &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.rodata&lt;/code&gt;.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__aligned(1)&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;&lt;strong&gt;Cấm chèn padding.&lt;/strong&gt; Các chuỗi nằm sát nhau, &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.modinfo&lt;/code&gt; thành dãy &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;&quot;key=value\0key=value\0...&quot;&lt;/code&gt; liền mạch để parser duyệt tuần tự.&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__UNIQUE_ID(modinfo)&lt;/code&gt; dùng &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__COUNTER__&lt;/code&gt; (&lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/include/linux/compiler.h#L164&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;compiler.h:164&lt;/a&gt;) tạo tên duy nhất — nếu không, ba dòng &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_DESCRIPTION&lt;/code&gt;/&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_AUTHOR&lt;/code&gt;/&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_LICENSE&lt;/code&gt; ở &lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/drivers/media/IP_ISP_SYSTEM/ISP_DRIVER/vt-sovra-core.c#L495-L497&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;vt-sovra-core.c:495-497&lt;/a&gt; sẽ đụng tên nhau. Hậu tố &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;_2&lt;/code&gt; chính là giá trị &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__COUNTER__&lt;/code&gt; tại điểm đó.&lt;/p&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;3. Kết quả thực tế&lt;/h2&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Sau khi build, chuỗi nằm trong &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;vt-sovra.ko&lt;/code&gt;. Lệnh &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;modinfo&lt;/code&gt; đọc đúng section này:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;$ modinfo vt-sovra.ko&lt;br/&gt;description:    VT Sovra DDR-split imaging subsystem&lt;br/&gt;author:         Sovra&lt;br/&gt;license:        GPL&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Ngoài &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;modinfo&lt;/code&gt;, &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;depmod&lt;/code&gt;/&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;modprobe&lt;/code&gt; cũng parse &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.modinfo&lt;/code&gt; để lấy &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;license&lt;/code&gt; (quyết định có tainted kernel không), &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;alias&lt;/code&gt;, &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;depends&lt;/code&gt;, &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;vermagic&lt;/code&gt;.&lt;/p&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;4. Chi tiết dễ bỏ sót: prefix rỗng&lt;/h2&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Trong ảnh, giá trị là &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;&quot;description&quot; &quot;=&quot; ...&lt;/code&gt; — &lt;strong&gt;không có prefix&lt;/strong&gt;. Đó là vì &lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/include/linux/moduleparam.h#L23-L30&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;moduleparam.h:23-30&lt;/a&gt;:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;#ifdef MODULE&lt;br/&gt;#define __MODULE_INFO_PREFIX /* empty */&lt;br/&gt;#else&lt;br/&gt;#define __MODULE_INFO_PREFIX KBUILD_MODNAME &quot;.&quot;&lt;br/&gt;#endif&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Cùng một dòng code cho ra &lt;strong&gt;hai kết quả khác nhau&lt;/strong&gt; tùy cách build:&lt;/p&gt;&lt;ul style=&quot;padding-inline-start: 2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;li&gt;Build thành module (&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;obj-m&lt;/code&gt;, đúng trường hợp của bạn) → &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;&quot;description=VT Sovra...&quot;&lt;/code&gt;. Không cần prefix vì mỗi &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.ko&lt;/code&gt; có &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.modinfo&lt;/code&gt; riêng.&lt;/li&gt;&lt;li&gt;Build built-in vào vmlinux (&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;obj-y&lt;/code&gt;) → &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;&quot;vt_sovra.description=VT Sovra...&quot;&lt;/code&gt;. Lúc này mọi driver dồn chung một &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.modinfo&lt;/code&gt; của vmlinux, phải có tên module đứng trước để không lẫn.&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Nói cách khác, hover đang cho bạn xem đúng biến thể module — nhờ &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;-DMODULE&lt;/code&gt;. Nếu bỏ flag đó khỏi &lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/compile_flags.txt&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;compile_flags.txt&lt;/a&gt;, hover sẽ hiện thêm &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;KBUILD_MODNAME &quot;.&quot;&lt;/code&gt; phía trước.&lt;/p&gt;" vertex="1">
          <mxGeometry height="1060" width="1000" x="3124.5" y="-310" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-38" edge="1" parent="1" source="CcBiSWCES-1M4_b4SoTJ-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="CcBiSWCES-1M4_b4SoTJ-39">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="4625.000000000001" y="-730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-35" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;gradientColor=none;" value="&lt;div style=&quot;color: rgb(187, 190, 191); background-color: rgb(18, 19, 20); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;div style=&quot;line-height: 19px;&quot;&gt;&lt;span style=&quot;color: #569cd6;&quot;&gt;MODULE_DEVICE_TABLE&lt;/span&gt;(of, &lt;span style=&quot;color: #79c0ff;&quot;&gt;vt_sovra_of_match&lt;/span&gt;);&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="20" width="330" x="4460" y="-780" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-41" edge="1" parent="1" source="CcBiSWCES-1M4_b4SoTJ-39" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="CcBiSWCES-1M4_b4SoTJ-40">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-39" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="268" width="628" x="4340" y="-720" as="geometry" />
        </mxCell>
        <mxCell id="CcBiSWCES-1M4_b4SoTJ-40" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#000000;" value="&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Macro expand ra gì&lt;/h2&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/include/linux/module.h#L246-L257&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;module.h:246-257&lt;/a&gt; — dòng &lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/drivers/media/IP_ISP_SYSTEM/ISP_DRIVER/vt-sovra-core.c#L483&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;483&lt;/a&gt; thành:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;static typeof(vt_sovra_of_match)&lt;br/&gt;    __mod_device_table__kmod_vt_sovra__of__vt_sovra_of_match&lt;br/&gt;    __attribute__((used, alias(&quot;vt_sovra_of_match&quot;)));&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Điểm cốt lõi: &lt;strong&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;alias&lt;/code&gt; không tạo biến mới.&lt;/strong&gt; Nó chỉ gắn thêm một cái tên thứ hai cho mảng &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;vt_sovra_of_match&lt;/code&gt; đã có sẵn ở dòng 479. Không tốn thêm một byte bộ nhớ nào — thuần túy là metadata trong bảng symbol.&lt;/p&gt;&lt;table style=&quot;border-collapse: collapse; border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;thead&gt;&lt;tr&gt;&lt;th style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;Thành phần&lt;/th&gt;&lt;th style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;Vai trò&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;&lt;tr&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;typeof(name)&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;Lấy đúng kiểu &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;const struct of_device_id[2]&lt;/code&gt; mà không cần macro biết trước kiểu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;alias(...)&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;Tên thứ hai trỏ vào cùng mảng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;used&lt;/code&gt;&lt;/td&gt;&lt;td style=&quot;border-color: rgb(42, 43, 44); border-style: solid; border-width: 1px; border-image: none 100% / 1 / 0 stretch; padding: 2px;&quot;&gt;Không ai tham chiếu trong C → compiler sẽ xóa; &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;used&lt;/code&gt; ép giữ&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Vì sao tên lại được mã hóa kỳ quặc như vậy&lt;/h2&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Comment ở &lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/include/linux/module.h#L242&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;module.h:242&lt;/a&gt; ghi rõ format:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__mod_device_table__kmod_&amp;lt;modname&amp;gt;__&amp;lt;type&amp;gt;__&amp;lt;name&amp;gt;&lt;br/&gt;                    ^^^^^^         ^^          ^^&lt;br/&gt;                    delimiter      delimiter   delimiter&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Tên chính là &lt;strong&gt;kênh truyền dữ liệu&lt;/strong&gt; sang công cụ build. &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;modpost&lt;/code&gt; (&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;scripts/mod/file2alias.c&lt;/code&gt;) quét bảng symbol của file &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.o&lt;/code&gt;, thấy symbol bắt đầu bằng &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__mod_device_table__&lt;/code&gt;, rồi tách chuỗi theo &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__kmod_&lt;/code&gt; và &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;__&lt;/code&gt; để biết: module tên &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;vt_sovra&lt;/code&gt;, loại bus là &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;of&lt;/code&gt;, bảng tên &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;vt_sovra_of_match&lt;/code&gt;. Chuỗi &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;_2&lt;/code&gt; hay tên biến ngẫu nhiên không dùng được ở đây — nên kernel nhét thông tin vào chính tên symbol.&lt;/p&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Mục đích thật: &lt;strong&gt;tự động nạp module&lt;/strong&gt;&lt;/h2&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Chuỗi hoạt động, nối tiếp phần &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_INFO&lt;/code&gt; bạn hỏi lúc nãy:&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;Lúc build&lt;/strong&gt; — modpost biết &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;type = of&lt;/code&gt; nên gọi handler &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;of_device_id&lt;/code&gt;, đọc nội dung mảng thật trong ELF (thấy &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.compatible = &quot;vt,sovra-isp&quot;&lt;/code&gt;), sinh ra trong &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;vt-sovra.mod.c&lt;/code&gt;:&lt;/p&gt;&lt;div class=&quot;codeBlockWrapper_-a7MRw&quot; style=&quot;position: relative; margin: 8px 0px; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;button class=&quot;copyButton_CEmTFw copyButton_-a7MRw&quot; title=&quot;Copy code&quot; aria-label=&quot;Copy code to clipboard&quot; style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(18, 19, 20); border-color: rgb(42, 43, 44); border-image: none 100% / 1 / 0 stretch; cursor: pointer; opacity: 0; display: flex; justify-content: center; align-items: center; padding: 4px; transition: opacity 0.15s, background 0.15s; position: absolute; top: 4px; right: 4px;&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 20 20&quot; fill=&quot;currentColor&quot; aria-hidden=&quot;true&quot; data-slot=&quot;icon&quot; class=&quot;copyIcon_CEmTFw&quot;&gt;&lt;path fill-rule=&quot;evenodd&quot; d=&quot;M15.988 3.012A2.25 2.25 0 0 1 18 5.25v6.5A2.25 2.25 0 0 1 15.75 14H13.5v-3.379a3 3 0 0 0-.879-2.121l-3.12-3.121a3 3 0 0 0-1.402-.791 2.252 2.252 0 0 1 1.913-1.576A2.25 2.25 0 0 1 12.25 1h1.5a2.25 2.25 0 0 1 2.238 2.012ZM11.5 3.25a.75.75 0 0 1 .75-.75h1.5a.75.75 0 0 1 .75.75v.25h-3v-.25Z&quot; clip-rule=&quot;evenodd&quot;&gt;&lt;/path&gt;&lt;path d=&quot;M3.5 6A1.5 1.5 0 0 0 2 7.5v9A1.5 1.5 0 0 0 3.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L8.44 6.439A1.5 1.5 0 0 0 7.378 6H3.5Z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/button&gt;&lt;pre style=&quot;overflow-x: auto; box-sizing: border-box; border-radius: 4px; max-width: 100%; margin: 0px; padding: 8px;&quot;&gt;&lt;code class=&quot;language-c&quot; style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 0px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_ALIAS(&quot;of:N*T*Cvt,sovra-isp&quot;);&lt;br/&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_ALIAS&lt;/code&gt; lại chính là &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_INFO(alias, ...)&lt;/code&gt; → nằm trong section &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.modinfo&lt;/code&gt;. Sau đó &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;depmod&lt;/code&gt; gom hết alias của mọi module vào &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;/lib/modules/$(uname -r)/modules.alias&lt;/code&gt;.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;strong&gt;Lúc chạy&lt;/strong&gt; — kernel duyệt device tree, gặp node &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;compatible = &quot;vt,sovra-isp&quot;&lt;/code&gt; chưa có driver nào nhận, phát uevent kèm &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODALIAS=of:N...Cvt,sovra-isp&lt;/code&gt;. udev/kmod tra &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;modules.alias&lt;/code&gt;, khớp, và gọi &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;modprobe vt-sovra&lt;/code&gt;.&lt;/p&gt;&lt;h2 style=&quot;color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Phân biệt với &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.of_match_table&lt;/code&gt; ở dòng 490&lt;/h2&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Hai thứ dùng &lt;strong&gt;cùng một mảng&lt;/strong&gt; nhưng phục vụ hai giai đoạn khác hẳn nhau — đây là chỗ hay nhầm:&lt;/p&gt;&lt;ul style=&quot;padding-inline-start: 2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;&lt;li&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.of_match_table&lt;/code&gt; (&lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/drivers/media/IP_ISP_SYSTEM/ISP_DRIVER/vt-sovra-core.c#L490&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199);&quot;&gt;dòng 490&lt;/a&gt;) → &lt;strong&gt;binding&lt;/strong&gt;, lúc runtime, &lt;em&gt;sau khi&lt;/em&gt; module đã nằm trong bộ nhớ. Kernel so &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;compatible&lt;/code&gt; để quyết định gọi &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;.probe&lt;/code&gt;.&lt;/li&gt;&lt;li&gt;&lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_DEVICE_TABLE&lt;/code&gt; → &lt;strong&gt;discovery&lt;/strong&gt;, metadata sinh lúc build, giúp userspace biết &lt;em&gt;cần nạp module nào&lt;/em&gt;.&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Nếu xóa dòng 483, driver vẫn chạy đúng khi bạn &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;insmod vt-sovra.ko&lt;/code&gt; thủ công — nhưng sẽ không bao giờ tự nạp. Đây là lỗi kinh điển: driver &quot;không hoạt động&quot; trên board dù code hoàn toàn đúng, chỉ vì thiếu &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;MODULE_DEVICE_TABLE&lt;/code&gt;.&lt;/p&gt;&lt;p style=&quot;white-space: pre-wrap; margin-top: 0.1em; margin-bottom: 0.2em; color: rgb(191, 191, 191); font-family: -apple-system, BlinkMacSystemFont, &amp;quot;Segoe UI&amp;quot;, Roboto, sans-serif; font-size: 13px; text-align: start; background-color: rgb(25, 26, 27);&quot;&gt;Tên &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;kmod_vt_sovra&lt;/code&gt; lấy từ &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;obj-m += vt-sovra.o&lt;/code&gt; trong &lt;a href=&quot;vscode-webview://1l9h8vmfum86tbvcsh47hdfuik4hr4ud1021t5rdar8u9t0d0amn/drivers/media/IP_ISP_SYSTEM/ISP_DRIVER/Makefile#L14&quot; target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; style=&quot;color: rgb(72, 160, 199); text-decoration: rgb(72, 160, 199);&quot;&gt;Makefile&lt;/a&gt; (dấu &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;-&lt;/code&gt; được đổi thành &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;_&lt;/code&gt;). Trong môi trường clangd của bạn nó sẽ hiện &lt;code style=&quot;color: rgb(140, 140, 140); background-color: rgb(38, 38, 38); padding: 2px 4px; border-radius: 3px; word-break: break-word; font-size: 0.9em;&quot;&gt;kmod_clangd&lt;/code&gt;, vì đó là giá trị giả tôi đặt — không ảnh hưởng gì đến index.&lt;/p&gt;" vertex="1">
          <mxGeometry height="870" width="1000" x="4220" y="-400" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="6iRf6-OEiH_Xoti-7y9j" name="Probe sequece compare">
