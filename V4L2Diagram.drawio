        <mxCell id="N05NifUaknlFWR_aCDva-10" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;div style=&quot;color: #bbbebf;background-color: #121314;font-family: Consolas, &#39;Courier New&#39;, monospace;font-weight: normal;font-size: 14px;line-height: 19px;white-space: pre;&quot;&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;/**&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* struct vimc_device - main device for vimc driver&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;*&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* &lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;@pipe_cfg:&lt;/span&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt; &amp;nbsp; pointer to the vimc pipeline configuration structure&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* &lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;@ent_devs:&lt;/span&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt; &amp;nbsp; array of vimc_ent_device pointers&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* &lt;/span&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;@mdev:&lt;/span&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt; &amp;nbsp; the associated media_device parent&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;* @v4l2_dev: &amp;nbsp; Internal v4l2 parent device&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #8b949e;&quot;&gt;&amp;nbsp;*/&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #ff7b72;&quot;&gt;struct&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: #4ec9b0;&quot;&gt;vimc_device&lt;/span&gt;&lt;span style=&quot;color: #c9d1d9;&quot;&gt; {&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: #c9d1d9;&q