        <mxCell id="SPCflWGgvfJZjvGfxSiW-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;h2 data-start=&quot;0&quot; data-end=&quot;38&quot; style=&quot;text-align: start;&quot;&gt;&lt;font style=&quot;font-size: 40px;&quot;&gt;Khối MUX trong vi điều khiển là gì?&lt;/font&gt;&lt;/h2&gt;&lt;div class=&quot;no-scrollbar flex min-h-36 flex-nowrap gap-0.5 overflow-auto sm:gap-1 sm:overflow-hidden xl:min-h-44 mt-1 mb-5 not-first:mt-4&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;div class=&quot;border-token-border-default relative w-32 shrink-0 overflow-hidden rounded-xl border-[0.5px] md:shrink max-h-64 sm:w-[calc((100%-0.5rem)/3)] rounded-s-xl&quot;&gt;&lt;div class=&quot;group/search-image @container/search-image relative rounded-[inherit] h-full w-full&quot;&gt;&lt;button type=&quot;button&quot; class=&quot;h-full w-full overflow-hidden rounded-[inherit]&quot; aria-label=&quot;Open image details for Peripherals on MCU | MadMachine&quot;&gt;&lt;img alt=&quot;https://images.openai.com/static-rsc-4/YXcJ9FNq2HOjx5P3oa9mYlWaayZYNBbMvbFO7ivF-jHp_1eJsc-rz1gQAqo0o-aRKcUbf1NURS9W6KyMt3_eDM_Wa8c511WGNufz5Z8qZiHbUX9NFIAnMfgNLCndBAazKHMsEuBgfnessSf2D047OgTnRwl2aL7g8HHz4W1HrTVCrnTRCOO6B-ftlC18MRnD?purpose=fullsize&quot; class=&quot;bg-token-main-surface-tertiary m-0 h-full w-full object-cover&quot; src=&quot;https://images.openai.com/static-rsc-4/ZT5Nip2QoEALcbCvs64LASDSRJkLVOh1y4yB4qzA5SiwnERFGmU-ymnIhuZGBWW-2OauAM1RhEVeTzPsZ3Bvl8O69e2mouO4bKn3aX5EjmF48EFS78vlvoB5iXY8HT8xJfp1tn38LsaSt9F4Bc6NrgHxWsMZkdaofN6TtZXof60?purpose=inline&quot;&gt;&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;border-token-border-default relative w-32 shrink-0 overflow-hidden rounded-xl border-[0.5px] md:shrink max-h-64 sm:w-[calc((100%-0.5rem)/3)]&quot;&gt;&lt;div class=&quot;group/search-image @container/search-image relative rounded-[inherit] h-full w-full&quot;&gt;&lt;button type=&quot;button&quot; class=&quot;h-full w-full overflow-hidden rounded-[inherit]&quot; aria-label=&quot;Open image details for Digital Electronics 1st Year (Unit 2) - Progiez&quot;&gt;&lt;img alt=&quot;https://images.openai.com/static-rsc-4/hsMnXwsRp6C5OiREbEP0ZoSJ8FNnBZxvIlxuu5dzHg11ZqU3Jjp-XnZTbc892SEnkAcCe9VkSsVgR8DmG5UPGLtCmQ4TQKGQpMvGyIxwpsWsXhjO0U65s-who8jOGpihaV-UWSAzQ67yZd8hecFZpiYbbwCdLgyXaHYsXmXWrQgyuNo7r3jna4OVOKf7i6i-?purpose=fullsize&quot; class=&quot;bg-token-main-surface-tertiary m-0 h-full w-full object-cover&quot; src=&quot;https://images.openai.com/static-rsc-4/44Ys4noccJBFCwop27hsOIYE2h0yyCiKzIcXazyyvhFYq8i9ZjQs2gRxszp3Rp0NM1ZkiQdBLlQE77IfspCFggujqiGyBozbZ8aPkM5E2d2Az6w0cAP-jGoyUU8QePxCjSA-32p-KGyEMWqzS6ripHjjX9GLmkeNYwvqUmMkpYY?purpose=inline&quot;&gt;&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;border-token-border-default relative w-32 shrink-0 overflow-hidden rounded-xl border-[0.5px] md:shrink max-h-64 sm:w-[calc((100%-0.5rem)/3)] rounded-e-xl&quot;&gt;&lt;div class=&quot;group/search-image @container/search-image relative rounded-[inherit] h-full w-full&quot;&gt;&lt;button type=&quot;button&quot; class=&quot;h-full w-full overflow-hidden rounded-[inherit]&quot; aria-label=&quot;Open image details for GPIO Concepts | Tutorials on Electronics | Next Electronics&quot;&gt;&lt;img alt=&quot;https://images.openai.com/static-rsc-4/tw3tr9JbyESFImbAt9il2NwyJCA3n0C3bMKOl6_mbi-1t664k2LBN-XCQQxSKvkXmh2FC9ET2DV4HTzVFjTHU8OWTCqbOn34p-MCtTOR1mmRsm_lxSS9anAw17qgM_pgE9kkGbQwRleh7cmFgYPRBaLbTryWmwyRq2jTPoAMgjOB8F-QfnwMS3lBsTibujcn?purpose=fullsize&quot; class=&quot;bg-token-main-surface-tertiary m-0 h-full w-full object-cover&quot; src=&quot;https://images.openai.com/static-rsc-4/yX7eKrVhG7q-CVajOoc7x35yVfkYuWjhTtuxsOcH1nTEdtTyw--TLj0arV77nuKldXOrGkVlxBWpzxXkZBETiKZ20je6SeE2aeyoRZ1N5Yv9lLO2mXY9RELdt74iyRFUJUa7SxOEjVbJvBxjFfCXoh9aKmfdOUjKs3iCKotzqsw?purpose=inline&quot;&gt;&lt;/button&gt;&lt;div class=&quot;pointer-events-none absolute inset-x-2 bottom-2 z-10 flex max-w-[calc(100%-1rem)] flex-wrap items-end justify-end gap-1.5&quot;&gt;&lt;div class=&quot;shrink-0&quot;&gt;&lt;div class=&quot;flex items-center gap-1 rounded-full px-2 py-1.5 text-white backdrop-blur-md backdrop-brightness-75&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;20&quot; height=&quot;20&quot; aria-hidden=&quot;true&quot; class=&quot;h-4 w-4&quot;&gt;&lt;/svg&gt;&lt;span class=&quot;text-xs font-semibold&quot;&gt;5&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;p data-start=&quot;82&quot; data-end=&quot;283&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;strong data-start=&quot;82&quot; data-end=&quot;103&quot;&gt;MUX (Multiplexer)&lt;/strong&gt; trong vi điều khiển là một &lt;strong data-start=&quot;131&quot; data-end=&quot;153&quot;&gt;khối chọn tín hiệu&lt;/strong&gt; — nó cho phép &lt;strong data-start=&quot;168&quot; data-end=&quot;192&quot;&gt;nhiều nguồn (inputs)&lt;/strong&gt; dùng chung &lt;strong data-start=&quot;204&quot; data-end=&quot;226&quot;&gt;một đường (output)&lt;/strong&gt; bằng cách chọn một trong các nguồn đó tại một thời điểm.&lt;/p&gt;&lt;hr data-start=&quot;285&quot; data-end=&quot;288&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;290&quot; data-end=&quot;309&quot; style=&quot;text-align: start;&quot;&gt;1. Hiểu đơn giản&lt;/h2&gt;&lt;p data-start=&quot;310&quot; data-end=&quot;357&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Hãy tưởng tượng MUX như &lt;strong data-start=&quot;334&quot; data-end=&quot;356&quot;&gt;công tắc chọn kênh&lt;/strong&gt;:&lt;/p&gt;&lt;ul data-start=&quot;359&quot; data-end=&quot;519&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;359&quot; data-end=&quot;407&quot;&gt;Có nhiều tín hiệu vào: GPIO, UART, SPI, ADC...&lt;/li&gt;&lt;li data-start=&quot;408&quot; data-end=&quot;519&quot;&gt;Nhưng chỉ có &lt;strong data-start=&quot;423&quot; data-end=&quot;468&quot;&gt;một đường ra vật lý (pin hoặc bus nội bộ)&lt;/strong&gt;&lt;br data-start=&quot;468&quot; data-end=&quot;471&quot;&gt;→ MUX sẽ quyết định &lt;strong data-start=&quot;491&quot; data-end=&quot;519&quot;&gt;tín hiệu nào được đi qua&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;521&quot; data-end=&quot;524&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;526&quot; data-end=&quot;567&quot; style=&quot;text-align: start;&quot;&gt;2. MUX trong vi điều khiển dùng ở đâu?&lt;/h2&gt;&lt;h3 data-start=&quot;569&quot; data-end=&quot;609&quot; style=&quot;text-align: start;&quot;&gt;a. Pin multiplexing (rất quan trọng)&lt;/h3&gt;&lt;p data-start=&quot;610&quot; data-end=&quot;649&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Một chân MCU thường có nhiều chức năng:&lt;/p&gt;&lt;ul data-start=&quot;651&quot; data-end=&quot;700&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;651&quot; data-end=&quot;657&quot;&gt;GPIO&lt;/li&gt;&lt;li data-start=&quot;658&quot; data-end=&quot;670&quot;&gt;UART TX/RX&lt;/li&gt;&lt;li data-start=&quot;671&quot; data-end=&quot;686&quot;&gt;SPI MOSI/MISO&lt;/li&gt;&lt;li data-start=&quot;687&quot; data-end=&quot;700&quot;&gt;I2C SDA/SCL&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;702&quot; data-end=&quot;753&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Bạn không thể dùng tất cả cùng lúc → MUX sẽ chọn&lt;/p&gt;&lt;p data-start=&quot;755&quot; data-end=&quot;761&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Ví dụ:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;762&quot; data-end=&quot;833&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;Pin PA2:&lt;br&gt;- Mode 0 → GPIO&lt;br&gt;- Mode 1 → UART_TX&lt;br&gt;- Mode 2 → SPI_MOSI&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;835&quot; data-end=&quot;876&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Thanh ghi cấu hình sẽ điều khiển MUX này.&lt;/p&gt;&lt;hr data-start=&quot;878&quot; data-end=&quot;881&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h3 data-start=&quot;883&quot; data-end=&quot;916&quot; style=&quot;text-align: start;&quot;&gt;b. Chọn nguồn tín hiệu nội bộ&lt;/h3&gt;&lt;p data-start=&quot;917&quot; data-end=&quot;949&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;MUX cũng dùng bên trong chip để:&lt;/p&gt;&lt;ul data-start=&quot;951&quot; data-end=&quot;1060&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;951&quot; data-end=&quot;1000&quot;&gt;Chọn nguồn clock (internal/external oscillator)&lt;/li&gt;&lt;li data-start=&quot;1001&quot; data-end=&quot;1021&quot;&gt;Chọn input cho ADC&lt;/li&gt;&lt;li data-start=&quot;1022&quot; data-end=&quot;1060&quot;&gt;Routing tín hiệu giữa các peripheral&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;1062&quot; data-end=&quot;1065&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h3 data-start=&quot;1067&quot; data-end=&quot;1089&quot; style=&quot;text-align: start;&quot;&gt;c. ADC multiplexer&lt;/h3&gt;&lt;p data-start=&quot;1090&quot; data-end=&quot;1127&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Một ADC thường có nhiều kênh đầu vào:&lt;/p&gt;&lt;ul data-start=&quot;1129&quot; data-end=&quot;1148&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;1129&quot; data-end=&quot;1148&quot;&gt;A0, A1, A2, A3...&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1150&quot; data-end=&quot;1224&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Nhưng chỉ có &lt;strong data-start=&quot;1163&quot; data-end=&quot;1175&quot;&gt;1 bộ ADC&lt;/strong&gt;&lt;br data-start=&quot;1175&quot; data-end=&quot;1178&quot;&gt;→ MUX sẽ chọn kênh nào để đo tại một thời điểm&lt;/p&gt;&lt;hr data-start=&quot;1226&quot; data-end=&quot;1229&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;1231&quot; data-end=&quot;1256&quot; style=&quot;text-align: start;&quot;&gt;3. Nguyên lý hoạt động&lt;/h2&gt;&lt;p data-start=&quot;1258&quot; data-end=&quot;1265&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;MUX có:&lt;/p&gt;&lt;ul data-start=&quot;1267&quot; data-end=&quot;1319&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;1267&quot; data-end=&quot;1281&quot;&gt;&lt;strong data-start=&quot;1269&quot; data-end=&quot;1281&quot;&gt;N inputs&lt;/strong&gt;&lt;/li&gt;&lt;li data-start=&quot;1282&quot; data-end=&quot;1296&quot;&gt;&lt;strong data-start=&quot;1284&quot; data-end=&quot;1296&quot;&gt;1 output&lt;/strong&gt;&lt;/li&gt;&lt;li data-start=&quot;1297&quot; data-end=&quot;1319&quot;&gt;&lt;strong data-start=&quot;1299&quot; data-end=&quot;1319&quot;&gt;Select lines (S)&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1321&quot; data-end=&quot;1335&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Ví dụ MUX 4:1:&lt;/p&gt;&lt;div class=&quot;TyagGW_tableContainer&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;group TyagGW_tableWrapper flex flex-col-reverse w-fit&quot;&gt;&lt;table data-start=&quot;1337&quot; data-end=&quot;1462&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;1337&quot; data-end=&quot;1357&quot;&gt;&lt;tr data-start=&quot;1337&quot; data-end=&quot;1357&quot;&gt;&lt;th data-start=&quot;1337&quot; data-end=&quot;1342&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;S1&lt;/th&gt;&lt;th data-start=&quot;1342&quot; data-end=&quot;1347&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;S0&lt;/th&gt;&lt;th data-start=&quot;1347&quot; data-end=&quot;1357&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Output&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;1379&quot; data-end=&quot;1462&quot;&gt;&lt;tr data-start=&quot;1379&quot; data-end=&quot;1399&quot;&gt;&lt;td data-start=&quot;1379&quot; data-end=&quot;1384&quot; data-col-size=&quot;sm&quot;&gt;0&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1384&quot; data-end=&quot;1389&quot;&gt;0&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1389&quot; data-end=&quot;1399&quot;&gt;I0&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1400&quot; data-end=&quot;1420&quot;&gt;&lt;td data-start=&quot;1400&quot; data-end=&quot;1405&quot; data-col-size=&quot;sm&quot;&gt;0&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1405&quot; data-end=&quot;1410&quot;&gt;1&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1410&quot; data-end=&quot;1420&quot;&gt;I1&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1421&quot; data-end=&quot;1441&quot;&gt;&lt;td data-start=&quot;1421&quot; data-end=&quot;1426&quot; data-col-size=&quot;sm&quot;&gt;1&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1426&quot; data-end=&quot;1431&quot;&gt;0&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1431&quot; data-end=&quot;1441&quot;&gt;I2&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1442&quot; data-end=&quot;1462&quot;&gt;&lt;td data-start=&quot;1442&quot; data-end=&quot;1447&quot; data-col-size=&quot;sm&quot;&gt;1&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1447&quot; data-end=&quot;1452&quot;&gt;1&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1452&quot; data-end=&quot;1462&quot;&gt;I3&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;p data-start=&quot;1464&quot; data-end=&quot;1531&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Trong MCU, các bit trong thanh ghi đóng vai trò &lt;strong data-start=&quot;1515&quot; data-end=&quot;1531&quot;&gt;select lines&lt;/strong&gt;&lt;/p&gt;&lt;hr data-start=&quot;1533&quot; data-end=&quot;1536&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;1538&quot; data-end=&quot;1574&quot; style=&quot;text-align: start;&quot;&gt;4. Liên hệ thực tế trong embedded&lt;/h2&gt;&lt;h3 data-start=&quot;1576&quot; data-end=&quot;1592&quot; style=&quot;text-align: start;&quot;&gt;Ví dụ STM32:&lt;/h3&gt;&lt;ul data-start=&quot;1593&quot; data-end=&quot;1688&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;1593&quot; data-end=&quot;1632&quot;&gt;Thanh ghi: &lt;code data-start=&quot;1606&quot; data-end=&quot;1619&quot;&gt;GPIOx_MODER&lt;/code&gt;, &lt;code data-start=&quot;1621&quot; data-end=&quot;1632&quot;&gt;GPIOx_AFR&lt;/code&gt;&lt;/li&gt;&lt;li data-start=&quot;1633&quot; data-end=&quot;1688&quot;&gt;Bạn set bit → MUX route tín hiệu từ peripheral ra pin&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;1690&quot; data-end=&quot;1693&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;1695&quot; data-end=&quot;1724&quot; style=&quot;text-align: start;&quot;&gt;5. Tại sao MUX quan trọng?&lt;/h2&gt;&lt;ul data-start=&quot;1726&quot; data-end=&quot;1835&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;1726&quot; data-end=&quot;1767&quot;&gt;Giảm số lượng chân (pin) → chip nhỏ hơn&lt;/li&gt;&lt;li data-start=&quot;1768&quot; data-end=&quot;1788&quot;&gt;Linh hoạt cấu hình&lt;/li&gt;&lt;li data-start=&quot;1789&quot; data-end=&quot;1835&quot;&gt;Cho phép nhiều peripheral chia sẻ tài nguyên&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;1837&quot; data-end=&quot;1840&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;1842&quot; data-end=&quot;1869&quot; style=&quot;text-align: start;&quot;&gt;6. Một hiểu lầm phổ biến&lt;/h2&gt;&lt;p data-start=&quot;1871&quot; data-end=&quot;1961&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;❌ “MUX là phần mềm”&lt;br data-start=&quot;1890&quot; data-end=&quot;1893&quot;&gt;→ Sai: MUX là &lt;strong data-start=&quot;1907&quot; data-end=&quot;1920&quot;&gt;phần cứng&lt;/strong&gt;, bạn chỉ &lt;strong data-start=&quot;1930&quot; data-end=&quot;1961&quot;&gt;điều khiển nó bằng phần mềm&lt;/strong&gt;&lt;/p&gt;&lt;hr data-start=&quot;1963&quot; data-end=&quot;1966&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;1968&quot; data-end=&quot;1981&quot; style=&quot;text-align: start;&quot;&gt;7. Tóm lại&lt;/h2&gt;&lt;ul data-start=&quot;1983&quot; data-end=&quot;2136&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;1983&quot; data-end=&quot;2011&quot;&gt;MUX = &lt;strong data-start=&quot;1991&quot; data-end=&quot;2011&quot;&gt;bộ chọn tín hiệu&lt;/strong&gt;&lt;/li&gt;&lt;li data-start=&quot;2012&quot; data-end=&quot;2105&quot;&gt;Có mặt ở:&lt;ul data-start=&quot;2026&quot; data-end=&quot;2105&quot;&gt;&lt;li data-start=&quot;2026&quot; data-end=&quot;2050&quot;&gt;Pin function selection&lt;/li&gt;&lt;li data-start=&quot;2053&quot; data-end=&quot;2076&quot;&gt;ADC channel selection&lt;/li&gt;&lt;li data-start=&quot;2079&quot; data-end=&quot;2105&quot;&gt;Clock &amp;amp; internal routing&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;li data-start=&quot;2106&quot; data-end=&quot;2136&quot;&gt;Điều khiển bằng &lt;strong data-start=&quot;2124&quot; data-end=&quot;2136&quot;&gt;register&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
