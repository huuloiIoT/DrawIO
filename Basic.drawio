e/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute inset-x-4 top-12 bottom-4&quot;&gt;&lt;div class=&quot;pointer-events-none sticky z-40 shrink-0 z-1!&quot;&gt;&lt;div class=&quot;sticky bg-token-border-light&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span class=&quot;ͼg&quot;&gt;if&lt;/span&gt;&lt;span&gt; (&lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;x&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;0&lt;/span&gt;&lt;span&gt;)&lt;/span&gt;&lt;br&gt;&lt;span&gt;   &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;A&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼg&quot;&gt;else&lt;/span&gt;&lt;br&gt;&lt;span&gt;   &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;B&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;1581&quot; data-end=&quot;1628&quot;&gt;👉 CPU chưa biết đi A hay B → pipeline bị “kẹt”&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;1630&quot; data-end=&quot;1633&quot;&gt;&lt;br&gt;&lt;h2 data-start=&quot;1635&quot; data-end=&quot;1647&quot;&gt;🧠 Vấn đề&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;1649&quot; data-end=&quot;1732&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1649&quot; data-end=&quot;1688&quot;&gt;&lt;br&gt;Quyết định branch thường ở stage EX&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1689&quot; data-end=&quot;1732&quot;&gt;&lt;br&gt;Nhưng IF đã fetch lệnh tiếp theo rồi 😬&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;hr data-start=&quot;1734&quot; data-end=&quot;1737&quot;&gt;&lt;br&gt;&lt;h2 data-start=&quot;1739&quot; data-end=&quot;1755&quot;&gt;🛠 Cách xử lý&lt;/h2&gt;&lt;br&gt;&lt;h3 data-start=&quot;1757&quot; data-end=&quot;1771&quot;&gt;✅ 1. Stall&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;1772&quot; data-end=&quot;1804&quot;&gt;👉 Đợi kết quả branch → rất chậm&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;1806&quot; data-end=&quot;1809&quot;&gt;&lt;br&gt;&lt;h3 data-start=&quot;1811&quot; data-end=&quot;1854&quot;&gt;✅ 2. Branch Prediction (rất quan trọng)&lt;/h3&gt;&lt;br&gt;&lt;h4 data-start=&quot;1856&quot; data-end=&quot;1868&quot;&gt;Static:&lt;/h4&gt;&lt;br&gt;&lt;ul data-start=&quot;1869&quot; data-end=&quot;1895&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1869&quot; data-end=&quot;1895&quot;&gt;&lt;br&gt;Always taken / not taken&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;h4 data-start=&quot;1897&quot; data-end=&quot;1910&quot;&gt;Dynamic:&lt;/h4&gt;&lt;br&gt;&lt;ul data-start=&quot;1911&quot; data-end=&quot;1947&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1911&quot; data-end=&quot;1947&quot;&gt;&lt;br&gt;Dựa lịch sử (branch history table)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p data-start=&quot;1949&quot; data-end=&quot;1985&quot;&gt;➡️ CPU hiện đại đoán cực tốt (~95%+)&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;1987&quot; data-end=&quot;1990&quot;&gt;&lt;br&gt;&lt;h3 data-start=&quot;1992&quot; data-end=&quot;2022&quot;&gt;❌ Misprediction (đoán sai)&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;2024&quot; data-end=&quot;2050&quot;&gt;👉 Phải &lt;strong data-start=&quot;2032&quot; data-end=&quot;2050&quot;&gt;flush pipeline&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2052&quot; data-end=&quot;2070&quot;&gt;