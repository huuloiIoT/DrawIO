ung đột!&lt;/p&gt;&#xa;&lt;hr data-start=&quot;2380&quot; data-end=&quot;2383&quot;&gt;&#xa;&lt;h2 data-start=&quot;2385&quot; data-end=&quot;2401&quot;&gt;🛠 Cách xử lý&lt;/h2&gt;&#xa;&lt;h3 data-start=&quot;2403&quot; data-end=&quot;2425&quot;&gt;✅ 1. Tách resource&lt;/h3&gt;&#xa;&lt;ul data-start=&quot;2426&quot; data-end=&quot;2458&quot;&gt;&#xa;&lt;li data-start=&quot;2426&quot; data-end=&quot;2445&quot;&gt;&#xa;Instruction cache&#xa;&lt;/li&gt;&#xa;&lt;li data-start=&quot;2446&quot; data-end=&quot;2458&quot;&gt;&#xa;Data cache&#xa;&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;p data-start=&quot;2460&quot; data-end=&quot;2485&quot;&gt;➡️ (Harvard architecture)&lt;/p&gt;&#xa;&lt;hr data-start=&quot;2487&quot; data-end=&quot;2490&quot;&gt;&#xa;&lt;h3 data-start=&quot;2492&quot; data-end=&quot;2520&quot;&gt;✅ 2. Pipeline scheduling&lt;/h3&gt;&#xa;&lt;hr data-start=&quot;2522&quot; data-end=&quot;2525&quot;&gt;&#xa;&lt;h1 data-start=&quot;2527&quot; data-end=&quot;2546&quot;&gt;🔗 Tổng hợp nhanh&lt;/h1&gt;&#xa;&lt;div class=&quot;TyagGW_tableContainer&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;group TyagGW_tableWrapper flex flex-col-reverse w-fit&quot;&gt;&lt;table data-start=&quot;2548&quot; data-end=&quot;2783&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;2548&quot; data-end=&quot;2590&quot;&gt;&lt;tr data-start=&quot;2548&quot; data-end=&quot;2590&quot;&gt;&lt;th data-start=&quot;2548&quot; data-end=&quot;2557&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Hazard&lt;/th&gt;&lt;th data-start=&quot;2557&quot; data-end=&quot;2571&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Nguyên nhân&lt;/th&gt;&lt;th data-start=&quot;2571&quot; data-end=&quot;2590&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Giải pháp chính&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;2630&quot; data-end=&quot;2783&quot;&gt;&lt;tr data-start=&quot;2630&quot; data-end=&quot;2688&quot;&gt;&lt;td data-start=&quot;2630&quot; data-end=&quot;2637&quot; data-col-size=&quot;sm&quot;&gt;Data&lt;/td&gt;&lt;td data-start=&quot;2637&quot; data-end=&quot;2657&quot; data-col-size=&quot;sm&quot;&gt;Phụ thuộc dữ liệu&lt;/td&gt;&lt;td data-start=&quot;2657&quot; data-end=&quot;2688&quot; data-col-size=&quot;sm&quot;&gt;Forwarding, stall, renaming&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;2689&quot; data-end=&quot;2735&quot;&gt;&lt;td data-start=&quot;2689&quot; data-end=&quot;2699&quot; data-col-size=&quot;sm&quot;&gt;Control&lt;/td&gt;&lt;td data-start=&quot;2699&quot; data-end=&quot;2708&quot; data-col-size=&quot;sm&quot;&gt;Branch&lt;/td&gt;&lt;td data-start=&quot;2708&quot; data-end=&quot;2735&quot; data-col-size=&quot;sm&quot;&gt;Prediction, speculation&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;2736&quot; data-end=&quot;2783&quot;&gt;&lt;td data-start=&quot;2736&quot; data-end=&quot;2749&quot; data-col-size=&quot;sm&quot;&gt;Structural&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2749&quot; data-end=&quot;2766&quot;&gt;Thiếu resource&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2766&quot; data-end=&quot;2783&quot;&gt;Thêm hardware&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&lt;hr data-start=&quot;2785&quot; data-end=&quot;2788&quot;&gt;&#xa;&lt;h1 data-start=&quot;2790&quot; data-end=&quot;2845&quot;&gt;🚀 Góc nhìn “Embedded / Edge AI” (quan trọng với bạn)&lt;/h1&gt;&#xa;&lt;h3 data-start=&quot;2847&quot; data-end=&quot;2867&quot;&gt;📌 Khi bạn viết:&lt;/h3&gt;&#xa;&lt;ul data-start=&quot;2868&quot; data-end=&quot;2925&quot;&gt;&#xa;&lt;li data-start=&quot;2868&quot; data-end=&quot;2880&quot;&gt;&#xa;Driver DMA&#xa;&lt;/li&gt;&#xa;&lt;li data-start=&quot;2881&quot; data-end=&quot;2906&quot;&gt;&#xa;Code tối ưu SIMD / NEON&#xa;&lt;/li&gt;&#xa;&lt;li data-start=&quot;2907&quot; data-end=&quot;2925&quot;&gt;&#xa;Real-time system&#xa;&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;p data-start=&quot;2927&quot; data-end=&quot;2957&quot;&gt;👉 Hazard ảnh hưởng trực tiếp:&lt;/p&gt;&#xa;&lt;h3 data-start=&quot;2959&quot; data-end=&quot;3001&quot;&gt;⚡ 1. Cache miss → kéo theo data hazard&lt;/h3&gt;&#xa;&lt;p data-start=&quot;3002&quot; data-end=&quot;3030&quot;&gt;CPU đợi RAM → stall pipeline&lt;/p&gt;&#xa;&lt;hr data-start=&quot;3032&quot; data-end=&quot;3035&quot;&gt;&#xa;&lt;h3 data-start=&quot;3037&quot; data-end=&quot;3075&quot;&gt;⚡ 2. Branch nhiều → control hazard&lt;/h3&gt;&#xa;&lt;p data-start=&quot;3076&quot; data-end=&quot;3086&quot;&gt;Code kiểu:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3087&quot; data-end=&quot;3113&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute inset-x-4 top-12 bottom-4&quot;&gt;&lt;div class=&quot;pointer-events-none sticky z-40 shrink-0 z-1!&quot;&gt;&lt;div class=&quot;sticky bg-token-border-light&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span class=&quot;ͼg&quot;&gt;if&lt;/span&gt;&lt;span&gt; (...) &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;else&lt;/span&gt;&lt;span&gt; ...&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;3114&quot; data-end=&quot;3137&quot;&gt;➡️ Làm giảm performance&lt;/p&gt;&#xa;&lt;p data-start=&quot;3139&quot; data-end=&quot;3146&quot;&gt;👉 Nên:&lt;/p&gt;&#xa;&lt;ul data-start=&quot;3147&quot; data-end=&quot;3201&quot;&gt;&#xa;&lt;li data-start=&quot;3147&quot; data-end=&quot;3162&quot;&gt;&#xa;Loop đơn giản&#xa;&lt;/li&gt;&#xa;&lt;li data-start=&quot;3163&quot; data-end=&quot;3201&quot;&gt;&#xa;Giảm branch (branchless programming)&#xa;&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;hr data-start=&quot;3203&quot; data-end=&quot;3206&quot;&gt;&#xa;&lt;h3 data-start=&quot;3208&quot; data-end=&quot;3254&quot;&gt;⚡ 3. Memory contention → structural hazard&lt;/h3&gt;&#xa;&lt;ul data-start=&quot;3255&quot; data-end=&quot;3284&quot;&gt;&#xa;&lt;li data-start=&quot;3255&quot; data-end=&quot;3284&quot;&gt;&#xa;CPU + DMA cùng truy cập RAM&lt;/li&gt;&lt;/ul&gt;&#xa;&#xa;" id="fkaEeS4rG_JSd6_vGRg7-1">
