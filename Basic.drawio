688&quot;&gt;&lt;td data-start=&quot;2630&quot; data-end=&quot;2637&quot; data-col-size=&quot;sm&quot;&gt;Data&lt;/td&gt;&lt;td data-start=&quot;2637&quot; data-end=&quot;2657&quot; data-col-size=&quot;sm&quot;&gt;Phụ thuộc dữ liệu&lt;/td&gt;&lt;td data-start=&quot;2657&quot; data-end=&quot;2688&quot; data-col-size=&quot;sm&quot;&gt;Forwarding, stall, renaming&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;2689&quot; data-end=&quot;2735&quot;&gt;&lt;td data-start=&quot;2689&quot; data-end=&quot;2699&quot; data-col-size=&quot;sm&quot;&gt;Control&lt;/td&gt;&lt;td data-start=&quot;2699&quot; data-end=&quot;2708&quot; data-col-size=&quot;sm&quot;&gt;Branch&lt;/td&gt;&lt;td data-start=&quot;2708&quot; data-end=&quot;2735&quot; data-col-size=&quot;sm&quot;&gt;Prediction, speculation&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;2736&quot; data-end=&quot;2783&quot;&gt;&lt;td data-start=&quot;2736&quot; data-end=&quot;2749&quot; data-col-size=&quot;sm&quot;&gt;Structural&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2749&quot; data-end=&quot;2766&quot;&gt;Thiếu resource&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2766&quot; data-end=&quot;2783&quot;&gt;Thêm hardware&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&lt;hr data-start=&quot;2785&quot; data-end=&quot;2788&quot;&gt;&#xa;&lt;h1 data-start=&quot;2790&quot; data-end=&quot;2845&quot;&gt;🚀 Góc nhìn “Embedded / Edge AI” (quan trọng với bạn)&lt;/h1&gt;&#xa;&lt;h3 data-start=&quot;2847&quot; data-end=&quot;2867&quot;&gt;📌 Khi bạn viết:&lt;/h3&gt;&#xa;&lt;ul data-start=&quot;2868&quot; data-end=&quot;2925&quot;&gt;&#xa;&lt;li data-start=&quot;2868&quot; data-end=&quot;2880&quot;&gt;&#xa;Driver DMA&#xa;&lt;/li&gt;&#xa;&lt;li data-start=&quot;2881&quot; data-end=&quot;2906&quot;&gt;&#xa;Code tối ưu SIMD / NEON&#xa;&lt;/li&gt;&#xa;&lt;li data-start=&quot;2907&quot; data-end=&quot;2925&quot;&gt;&#xa;Real-time system&#xa;&lt;/li&gt;&#xa;&lt;/ul&gt;&#xa;&lt;p data-s