ode&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;2881&quot; data-end=&quot;2907&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Nhảy xa → miss liên tục&lt;/p&gt;&lt;hr data-start=&quot;2909&quot; data-end=&quot;2912&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;2914&quot; data-end=&quot;2947&quot; style=&quot;text-align: start;&quot;&gt;🔥 6. Cache coherence (đa core)&lt;/h1&gt;&lt;p data-start=&quot;2949&quot; data-end=&quot;2980&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Khi nhiều core cùng dùng cache:&lt;/p&gt;&lt;p data-start=&quot;2982&quot; data-end=&quot;2992&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Vấn đề:&lt;/p&gt;&lt;ul data-start=&quot;2993&quot; data-end=&quot;3046&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;2993&quot; data-end=&quot;3010&quot;&gt;Core A sửa data&lt;/li&gt;&lt;li data-start=&quot;3011&quot; data-end=&quot;3046&quot;&gt;Core B vẫn giữ bản cũ trong cache&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;3048&quot; data-end=&quot;3051&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;3053&quot; data-end=&quot;3068&quot; style=&quot;text-align: start;&quot;&gt;🧠 Giải pháp&lt;/h2&gt;&lt;ul data-start=&quot;3069&quot; data-end=&quot;3132&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3069&quot; data-end=&quot;3132&quot;&gt;Protocol như:&lt;ul data-start=&quot;3087&quot; data-end=&quot;3132&quot;&gt;&lt;li data-start=&quot;3087&quot; data-end=&quot;3132&quot;&gt;MESI (Modified, Exclusive, Shared, Invalid)&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;3134&quot; data-end=&quot;3145&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Đảm bảo:&lt;/p&gt;&lt;ul data-start=&quot;3146&quot; data-end=&quot;3190&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3146&quot; data-end=&quot;3190&quot;&gt;Dữ liệu giữa các cache luôn &lt;strong data-start=&quot;3176&quot; data-end=&quot;3190&quot;&gt;consistent&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;3192&quot; data-end=&quot;3195&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;3197&quot; data-end=&quot;3231&quot; style=&quot;text-align: start;&quot;&gt;🏭 7. Cache được ứng dụng ở đâu?&lt;/h1&gt;&lt;h2 data-start=&quot;3233&quot; data-end=&quot;3259&quot; style=&quot;text-align: start;&quot;&gt;✔ CPU (quan trọng nhất)&lt;/h2&gt;&lt;ul data-start=&quot;3260&quot; data-end=&quot;3296&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3260&quot; data-end=&quot;3296&quot;&gt;Mọi CPU hiện đại (Intel, AMD, ARM)&lt;/li&gt;&lt;/ul&gt;&lt;h2 data-start=&quot;3298&quot; data-end=&quot;3306&quot; style=&quot;text-align: start;&quot;&gt;✔ GPU&lt;/h2&gt;&lt;ul data-start=&quot;3307&quot; data-end=&quot;3334&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3307&quot; data-end=&quot;3334&quot;&gt;Cache cho texture, memory&lt;/li&gt;&lt;/ul&gt;&lt;h2 data-start=&quot;3336&quot; data-end=&quot;3359&quot; style=&quot;text-align: start;&quot;&gt;✔ Embedded / Edge AI&lt;/h2&gt;&lt;ul data-start=&quot;3360&quot; data-end=&quot;3394&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3360&quot; data-end=&quot;3394&quot;&gt;Cache cực quan trọng vì RAM chậm&lt;/li&gt;&lt;/ul&gt;&lt;h2 data-start=&quot;3396&quot; data-end=&quot;3419&quot; style=&quot;text-align: start;&quot;&gt;✔ Database / Backend&lt;/h2&gt;&lt;ul data-start=&quot;3420&quot; data-end=&quot;3458&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3420&quot; data-end=&quot;3458&quot;&gt;Performance phụ thuộc cache hit rate&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;3460&quot; data-end=&quot;3463&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;3465&quot; data-end=&quot;3498&quot; style=&quot;text-align: start;&quot;&gt;🎯 8. Tại sao cache quan trọng?&lt;/h1&gt;&lt;p data-start=&quot;3500&quot; data-end=&quot;3518&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Không có cache:&lt;/p&gt;&lt;ul data-start=&quot;3520&quot; data-end=&quot;3580&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3520&quot; data-end=&quot;3540&quot;&gt;CPU 5GHz ≠ nhanh&lt;/li&gt;&lt;li data-start=&quot;3541&quot; data-end=&quot;3580&quot;&gt;Vì:&lt;ul data-start=&quot;3549&quot; data-end=&quot;3580&quot;&gt;&lt;li data-start=&quot;3549&quot; data-end=&quot;3580&quot;&gt;RAM chậm hơn CPU &lt;strong data-start=&quot;3568&quot; data-end=&quot;3580&quot;&gt;~100 lần&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;3582&quot; data-end=&quot;3585&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;p data-start=&quot;3587&quot; data-end=&quot;3599&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Có cache:&lt;/p&gt;&lt;ul data-start=&quot;3601&quot; data-end=&quot;3742&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3601&quot; data-end=&quot;3615&quot;&gt;Giảm latency&lt;/li&gt;&lt;li data-start=&quot;3616&quot; data-end=&quot;3633&quot;&gt;Tăng throughput&lt;/li&gt;&lt;li data-start=&quot;3634&quot; data-end=&quot;3742&quot;&gt;Giúp:&lt;ul data-start=&quot;3644&quot; data-end=&quot;3742&quot;&gt;&lt;li data-start=&quot;3644&quot; data-end=&quot;3676&quot;&gt;Superscalar hoạt động hiệu quả&lt;/li&gt;&lt;li data-start=&quot;3679&quot; data-end=&quot;3705&quot;&gt;Out-of-order ít bị stall&lt;/li&gt;&lt;li data-start=&quot;3708&quot; data-end=&quot;3742&quot;&gt;Speculative execution có ý nghĩa&lt;/li&gt;&lt;/ul&gt;&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;3744&quot; data-end=&quot;3747&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;3749&quot; data-end=&quot;3772&quot; style=&quot;text-align: start;&quot;&gt;🧠 Tổng kết (cốt lõi)&lt;/h1&gt;&lt;ul data-start=&quot;3774&quot; data-end=&quot;3860&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3774&quot; data-end=&quot;3815&quot;&gt;L1 = &lt;strong data-start=&quot;3781&quot; data-end=&quot;3815&quot;&gt;nhanh nhất, nhỏ nhất, gần core&lt;/strong&gt;&lt;/li&gt;&lt;li data-start=&quot;3816&quot; data-end=&quot;3837&quot;&gt;L2 = &lt;strong data-start=&quot;3823&quot; data-end=&quot;3837&quot;&gt;trung gian&lt;/strong&gt;&lt;/li&gt;&lt;li data-start=&quot;3838&quot; data-end=&quot;3860&quot;&gt;L3 = &lt;strong data-start=&quot;3845&quot; data-end=&quot;3860&quot;&gt;lớn, shared&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;3862&quot; data-end=&quot;3882&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Cache tồn tại để:&lt;/p&gt;&lt;blockquote data-start=&quot;3883&quot; data-end=&quot;3910&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;p data-start=&quot;3885&quot; data-end=&quot;3910&quot;&gt;“che giấu độ trễ của RAM”&lt;/p&gt;&lt;/blockquote&gt;&lt;hr data-start=&quot;3912&quot; data-end=&quot;3915&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;3917&quot; data-end=&quot;3961&quot; style=&quot;text-align: start;&quot;&gt;🔥 Nếu bạn muốn đào sâu thêm (mình khuyên)&lt;/h1&gt;&lt;p data-start=&quot;3963&quot; data-end=&quot;3995&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Mấy phần này mới là “pro level”:&lt;/p&gt;&lt;ul data-start=&quot;3996&quot; data-end=&quot;4170&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;3996&quot; data-end=&quot;4044&quot;&gt;Cache mapping (direct-mapped, set-associative)&lt;/li&gt;&lt;li data-start=&quot;4045&quot; data-end=&quot;4077&quot;&gt;Cache replacement (LRU, FIFO…)&lt;/li&gt;&lt;li data-start=&quot;4078&quot; data-end=&quot;4128&quot;&gt;False sharing (rất hay gặp trong multithreading)&lt;/li&gt;&lt;li data-start=&quot;4129&quot; data-end=&quot;4170&quot;&gt;Cache optimization cho C/C++ / hệ nhúng&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="11580" width="1640" x="6800" y="-230" as="geometry" />
        </mxCell>
        <mxCell id="fkaEeS4rG_JSd6_vGRg7-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="&lt;h1 data-start=&quot;156&quot; data-end=&quot;191&quot; style=&quot;text-align: start;&quot;&gt;&lt;font style=&quot;font-size: 60px;&quot;&gt;🧠 Vấn đề: Cache coherence là gì?&lt;/font&gt;&lt;/h1&gt;&lt;p data-start=&quot;193&quot; data-end=&quot;200&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Giả sử:&lt;/p&gt;&lt;ul data-start=&quot;202&quot; data-end=&quot;318&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;202&quot; data-end=&quot;250&quot;&gt;Core 1 và Core 2 đều có biến &lt;code data-start=&quot;233&quot; data-end=&quot;236&quot;&gt;X&lt;/code&gt; trong cache&lt;/li&gt;&lt;li data-start=&quot;251&quot; data-end=&quot;279&quot;&gt;Core 1 thay đổi &lt;code data-start=&quot;269&quot; data-end=&quot;277&quot;&gt;X = 10&lt;/code&gt;&lt;/li&gt;&lt;li data-start=&quot;280&quot; data-end=&quot;318&quot;&gt;Core 2 vẫn giữ &lt;code data-start=&quot;297&quot; data-end=&quot;304&quot;&gt;X = 5&lt;/code&gt; trong cache&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;320&quot; data-end=&quot;366&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Nếu không xử lý → &lt;strong data-start=&quot;341&quot; data-end=&quot;366&quot;&gt;bug cực khó phát hiện&lt;/strong&gt;&lt;/p&gt;&lt;hr data-start=&quot;368&quot; data-end=&quot;371&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;373&quot; data-end=&quot;402&quot; style=&quot;text-align: start;&quot;&gt;🔥 Giải pháp: MESI Protocol&lt;/h1&gt;&lt;p data-start=&quot;404&quot; data-end=&quot;434&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;strong data-start=&quot;404&quot; data-end=&quot;412&quot;&gt;MESI&lt;/strong&gt; là giao thức đảm bảo:&lt;/p&gt;&lt;blockquote data-start=&quot;435&quot; data-end=&quot;480&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;p data-start=&quot;437&quot; data-end=&quot;480&quot;&gt;“Mọi core luôn nhìn thấy dữ liệu nhất quán”&lt;/p&gt;&lt;/blockquote&gt;&lt;p data-start=&quot;482&quot; data-end=&quot;514&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;MESI có 4 trạng thái cache line:&lt;/p&gt;&lt;hr data-start=&quot;516&quot; data-end=&quot;519&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;521&quot; data-end=&quot;541&quot; style=&quot;text-align: start;&quot;&gt;🧩 1. Modified (M)&lt;/h1&gt;&lt;h2 data-start=&quot;543&quot; data-end=&quot;556&quot; style=&quot;text-align: start;&quot;&gt;🧠 Ý nghĩa&lt;/h2&gt;&lt;ul data-start=&quot;557&quot; data-end=&quot;646&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;557&quot; data-end=&quot;588&quot;&gt;Cache line đã &lt;strong data-start=&quot;573&quot; data-end=&quot;588&quot;&gt;bị thay đổi&lt;/strong&gt;&lt;/li&gt;&lt;li data-start=&quot;589&quot; data-end=&quot;610&quot;&gt;&lt;strong data-start=&quot;591&quot; data-end=&quot;610&quot;&gt;KHÔNG giống RAM&lt;/strong&gt;&lt;/li&gt;&lt;li data-start=&quot;611&quot; data-end=&quot;646&quot;&gt;Chỉ tồn tại &lt;strong data-start=&quot;625&quot; data-end=&quot;646&quot;&gt;duy nhất ở 1 core&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;648&quot; data-end=&quot;651&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;653&quot; data-end=&quot;664&quot; style=&quot;text-align: start;&quot;&gt;⚙️ Ví dụ&lt;/h2&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;666&quot; data-end=&quot;713&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-supe