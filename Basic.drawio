uot;1690&quot; data-end=&quot;1735&quot;&gt;Giúp &lt;strong data-start=&quot;1697&quot; data-end=&quot;1735&quot;&gt;các core chia sẻ dữ liệu nhanh hơn&lt;/strong&gt;&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;1737&quot; data-end=&quot;1740&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;1742&quot; data-end=&quot;1787&quot; style=&quot;text-align: start;&quot;&gt;🔄 3. Cách cache hoạt động (rất quan trọng)&lt;/h1&gt;&lt;h2 data-start=&quot;1789&quot; data-end=&quot;1811&quot; style=&quot;text-align: start;&quot;&gt;🔁 Cache hit / miss&lt;/h2&gt;&lt;ul data-start=&quot;1813&quot; data-end=&quot;1904&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;1813&quot; data-end=&quot;1864&quot;&gt;&lt;strong data-start=&quot;1815&quot; data-end=&quot;1822&quot;&gt;Hit&lt;/strong&gt;: dữ liệu có sẵn trong cache → rất nhanh&lt;/li&gt;&lt;li data-start=&quot;1865&quot; data-end=&quot;1904&quot;&gt;&lt;strong data-start=&quot;1867&quot; data-end=&quot;1875&quot;&gt;Miss&lt;/strong&gt;: phải xuống L2/L3/RAM → chậm&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1906&quot; data-end=&quot;1924&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Chuỗi truy cập:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1926&quot; data-end=&quot;1958&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 