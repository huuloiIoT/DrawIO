        <UserObject label="&lt;font style=&quot;font-size: 60px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;p data-start=&quot;0&quot; data-end=&quot;208&quot;&gt;&lt;font style=&quot;font-size: 60px;&quot;&gt;Để thiết kế một hệ thống nhúng chạy &lt;strong data-start=&quot;36&quot; data-end=&quot;96&quot;&gt;Edge AI (Linux + NPU + CPU + LPU, chạy model như YOLOv8)&lt;/strong&gt;&lt;/font&gt;&lt;/p&gt;&lt;p data-start=&quot;0&quot; data-end=&quot;208&quot;&gt;, bạn không thể học kiểu “một mảng là đủ”. Nó là sự giao thoa của &lt;strong data-start=&quot;162&quot; data-end=&quot;207&quot;&gt;embedded + system + AI + tối ưu phần cứng&lt;/strong&gt;.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;210&quot; data-end=&quot;303&quot;&gt;Mình sẽ chia thẳng theo roadmap thực tế (từ nền → nâng cao → build được hệ thống hoàn chỉnh):&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;305&quot; data-end=&quot;308&quot;&gt;&lt;br&gt;&lt;h1 data-start=&quot;310&quot; data-end=&quot;354&quot;&gt;1. Nền tảng bắt buộc (không có là “toang”)&lt;/h1&gt;&lt;br&gt;&lt;h2 data-start=&quot;356&quot; data-end=&quot;391&quot;&gt;🔧 C/C++ + Embedded fundamentals&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;392&quot; data-end=&quot;513&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;392&quot; data-end=&quot;416&quot;&gt;&lt;br&gt;C (quan trọng hơn C++)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;417&quot; data-end=&quot;450&quot;&gt;&lt;br&gt;Memory (stack/heap, DMA, cache)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;451&quot; data-end=&quot;488&quot;&gt;&lt;br&gt;Bitwise, register-level programming&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;489&quot; data-end=&quot;513&quot;&gt;&lt;br&gt;Interrupt, concurrency&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p data-start=&quot;515&quot; data-end=&quot;587&quot;&gt;👉 Nếu bạn đã từng làm UART + DMA + FreeRTOS → rất tốt, đang đúng hướng.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;589&quot; data-end=&quot;592&quot;&gt;&lt;br&gt;&lt;h2 data-start=&quot;594&quot; data-end=&quot;641&quot;&gt;⚡ Kiến trúc máy tính (Computer Architecture)&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;642&quot; data-end=&quot;733&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;642&quot; data-end=&quot;674&quot;&gt;&lt;br&gt;CPU pipeline, cache (L1/L2/L3)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;675&quot; data-end=&quot;696&quot;&gt;&lt;br&gt;MMU, virtual memory&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;697&quot; data-end=&quot;712&quot;&gt;&lt;br&gt;Bus: AXI, AHB&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;713&quot; data-end=&quot;733&quot;&gt;&lt;br&gt;Peripheral mapping&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p data-start=&quot;735&quot; data-end=&quot;794&quot;&gt;👉 Đây là phần giúp bạn hiểu &lt;strong data-start=&quot;764&quot; data-end=&quot;794&quot;&gt;tại sao AI chạy nhanh/chậm&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;796&quot; data-end=&quot;799&quot;&gt;&lt;br&gt;&lt;h2 data-start=&quot;801&quot; data-end=&quot;832&quot;&gt;🔌 Digital + Hardware cơ bản&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;833&quot; data-end=&quot;927&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;833&quot; data-end=&quot;855&quot;&gt;&lt;br&gt;GPIO, SPI, I2C, UART&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;856&quot; data-end=&quot;877&quot;&gt;&lt;br&gt;Clock, power domain&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;878&quot; data-end=&quot;927&quot;&gt;&lt;br&gt;PCB basics (không cần quá sâu, nhưng phải hiểu)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;hr data-start=&quot;929&quot; data-end=&quot;932&quot;&gt;&lt;br&gt;&lt;h1 data-start=&quot;934&quot; data-end=&quot;985&quot;&gt;2. Embedded Linux (cực kỳ quan trọng cho Edge AI)&lt;/h1&gt;&lt;br&gt;&lt;h2 data-start=&quot;987&quot; data-end=&quot;1005&quot;&gt;🐧 Linux system&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;1006&quot; data-end=&quot;1070&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1006&quot; data-end=&quot;1037&quot;&gt;&lt;br&gt;Process / thread / scheduling&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1038&quot; data-end=&quot;1057&quot;&gt;&lt;br&gt;Memory management&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1058&quot; data-end=&quot;1070&quot;&gt;&lt;br&gt;Filesystem&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;hr data-start=&quot;1072&quot; data-end=&quot;1075&quot;&gt;&lt;br&gt;&lt;h2 data-start=&quot;1077&quot; data-end=&quot;1095&quot;&gt;🔧 Linux driver&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;1096&quot; data-end=&quot;1144&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1096&quot; data-end=&quot;1109&quot;&gt;&lt;br&gt;Device tree&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1110&quot; data-end=&quot;1125&quot;&gt;&lt;br&gt;Kernel module&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1126&quot; data-end=&quot;1144&quot;&gt;&lt;br&gt;Character device&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p data-start=&quot;1146&quot; data-end=&quot;1185&quot;&gt;👉 Vì NPU / camera / ISP đều cần driver&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;1187&quot; data-end=&quot;1190&quot;&gt;&lt;br&gt;&lt;h2 data-start=&quot;1192&quot; data-end=&quot;1210&quot;&gt;🧱 Build system&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;1211&quot; data-end=&quot;1294&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1211&quot; data-end=&quot;1252&quot;&gt;&lt;br&gt;&lt;span class=&quot;hover:entity-accent entity-underline inline cursor-pointer align-baseline&quot;&gt;&lt;span class=&quot;whitespace-normal&quot;&gt;Buildroot&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1253&quot; data-end=&quot;1294&quot;&gt;&lt;br&gt;&lt;span class=&quot;hover:entity-accent entity-underline inline cursor-pointer align-baseline&quot;&gt;&lt;span class=&quot;whitespace-normal&quot;&gt;Yocto Project&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p data-start=&quot;1296&quot; data-end=&quot;1354&quot;&gt;👉 Bạn sẽ build OS cho chip AI (không dùng Ubuntu sẵn đâu)&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;1356&quot; data-end=&quot;1359&quot;&gt;&lt;br&gt;&lt;h1 data-start=&quot;1361&quot; data-end=&quot;1413&quot;&gt;3. AI / Deep Learning (không cần thành researcher)&lt;/h1&gt;&lt;br&gt;&lt;h2 data-start=&quot;1415&quot; data-end=&quot;1438&quot;&gt;🤖 Hiểu core concept&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;1439&quot; data-end=&quot;1491&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1439&quot; data-end=&quot;1444&quot;&gt;&lt;br&gt;CNN&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1445&quot; data-end=&quot;1463&quot;&gt;&lt;br&gt;Object Detection&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1464&quot; data-end=&quot;1491&quot;&gt;&lt;br&gt;Quantization (INT8, FP16)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;hr data-start=&quot;1493&quot; data-end=&quot;1496&quot;&gt;&lt;br&gt;&lt;h2 data-start=&quot;1498&quot; data-end=&quot;1517&quot;&gt;🎯 Model thực tế&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;1518&quot; data-end=&quot;1584&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1518&quot; data-end=&quot;1559&quot;&gt;&lt;br&gt;&lt;span class=&quot;hover:entity-accent entity-underline inline cursor-pointer align-baseline&quot;&gt;&lt;span class=&quot;whitespace-normal&quot;&gt;YOLOv8&lt;/span&gt;&lt;/span&gt;&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1560&quot; data-end=&quot;1584&quot;&gt;&lt;br&gt;ONNX, TensorRT, TFLite&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;p data-start=&quot;1586&quot; data-end=&quot;1628&quot;&gt;👉 Bạn không cần train từ đầu, nhưng phải:&lt;/p&gt;&lt;br&gt;&lt;ul data-start=&quot;1629&quot; data-end=&quot;1669&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1629&quot; data-end=&quot;1644&quot;&gt;&lt;br&gt;Convert model&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1645&quot; data-end=&quot;1669&quot;&gt;&lt;br&gt;Optimize model cho NPU&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;hr data-start=&quot;1671&quot; data-end=&quot;1674&quot;&gt;&lt;br&gt;&lt;h1 data-start=&quot;1676&quot; data-end=&quot;1714&quot;&gt;4. Edge AI Pipeline (phần “ăn tiền”)&lt;/h1&gt;&lt;br&gt;&lt;h2 data-start=&quot;1716&quot; data-end=&quot;1740&quot;&gt;📷 Data flow thực tế:&lt;/h2&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1741&quot; data-end=&quot;1799&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Camera → ISP → CPU → NPU → CPU → Display / Network&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;1801&quot; data-end=&quot;1817&quot;&gt;👉 Bạn cần hiểu:&lt;/p&gt;&lt;br&gt;&lt;ul data-start=&quot;1818&quot; data-end=&quot;1890&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1818&quot; data-end=&quot;1841&quot;&gt;&lt;br&gt;Video pipeline (V4L2)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1842&quot; data-end=&quot;1867&quot;&gt;&lt;br&gt;Buffer (zero-copy, DMA)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1868&quot; data-end=&quot;1890&quot;&gt;&lt;br&gt;Latency optimization&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;hr data-start=&quot;1892&quot; data-end=&quot;1895&quot;&gt;&lt;br&gt;&lt;h2 data-start=&quot;1897&quot; data-end=&quot;1915&quot;&gt;🔥 Acceleration&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;1916&quot; data-end=&quot;1986&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;1916&quot; data-end=&quot;1943&quot;&gt;&lt;br&gt;NPU SDK (vendor-specific)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1944&quot; data-end=&quot;1972&quot;&gt;&lt;br&gt;OpenCL / CUDA (nếu có GPU)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;1973&quot; data-end=&quot;1986&quot;&gt;&lt;br&gt;SIMD (NEON)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;hr data-start=&quot;1988&quot; data-end=&quot;1991&quot;&gt;&lt;br&gt;&lt;h1 data-start=&quot;1993&quot; data-end=&quot;2022&quot;&gt;5. Real-time + Optimization&lt;/h1&gt;&lt;br&gt;&lt;h2 data-start=&quot;2024&quot; data-end=&quot;2048&quot;&gt;⏱️ Performance tuning&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;2049&quot; data-end=&quot;2114&quot;&gt;&lt;br&gt;&lt;li data-start=&quot;2049&quot; data-end=&quot;2078&quot;&gt;&lt;br&gt;Profiling (perf, top, htop)&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;2079&quot; data-end=&quot;2093&quot;&gt;&lt;br&gt;CPU affinity&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;li data-start=&quot;2094&quot; data-end=&quot;2114&quot;&gt;&lt;br&gt;Cache optimization&lt;br&gt;&lt;/li&gt;&lt;br&gt;&lt;/ul&gt;&lt;br&gt;&lt;hr data-start=&quot;2116&quot; data-end=&quot;2119&quot;&gt;&lt;br&gt;&lt;h2 data-start=&quot;2121&quot; data-end=&quot;2143&quot;&gt;⚙️ Real-time system&lt;/h2&gt;&lt;br&gt;&lt;ul data-start=&quot;21