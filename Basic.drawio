t;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span class=&quot;ͼg&quot;&gt;struct&lt;/span&gt; {&lt;br&gt;    &lt;span class=&quot;ͼm&quot;&gt;int&lt;/span&gt; &lt;span class=&quot;ͼm&quot;&gt;a&lt;/span&gt;; &lt;span class=&quot;ͼe&quot;&gt;// core 1 dùng&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;ͼm&quot;&gt;int&lt;/span&gt; &lt;span class=&quot;ͼm&quot;&gt;b&lt;/span&gt;; &lt;span class=&quot;ͼe&quot;&gt;// core 2 dùng&lt;/span&gt;&lt;br&gt;};&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;2494&quot; data-end=&quot;2535&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 a và b cùng cache line → false sharing&lt;/p&gt;&lt;hr data-start=&quot;2537&quot; data-end=&quot;2540&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h2 data-start=&quot;2542&quot; data-end=&quot;2558&quot; style=&quot;text-align: start;&quot;&gt;🛠 Cách xử lý&lt;/h2&gt;&lt;ul data-start=&quot;2559&quot; data-end=&quot;2599&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;2559&quot; data-end=&quot;2585&quot;&gt;Padding (align 64 bytes)&lt;/li&gt;&lt;li data-start=&quot;2586&quot; data-end=&quot;2599&quot;&gt;Tách struct&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;2601&quot; data-end=&quot;2604&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;2606&quot; data-end=&quot;2638&quot; style=&quot;text-align: start;&quot;&gt;🏗 8. Cách MESI được implement&lt;/h1&gt;&lt;h2 data-start=&quot;2640&quot; data-end=&quot;2664&quot; style=&quot;text-align: start;&quot;&gt;✔ Snooping (phổ biến)&lt;/h2&gt;&lt;ul data-start=&quot;2665&quot; data-end=&quot;2708&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;2665&quot; data-end=&quot;2686&quot;&gt;Core “nghe lén” bus&lt;/li&gt;&lt;li data-start=&quot;2687&quot; data-end=&quot;2708&quot;&gt;Theo dõi ai đọc/ghi&lt;/li&gt;&lt;/ul&gt;&lt;h2 data-start=&quot;2710&quot; data-end=&quot;2730&quot; style=&quot;text-align: start;&quot;&gt;✔ Directory-based&lt;/h2&gt;&lt;ul data-start=&quot;2731&quot; data-end=&quot;2795&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;2731&quot; data-end=&quot;2766&quot;&gt;Có bảng theo dõi cache line ở đâu&lt;/li&gt;&lt;li data-start=&quot;2767&quot; data-end=&quot;2795&quot;&gt;Dùng trong hệ lớn (server)&lt;/li&gt;&lt;/ul&gt;&lt;hr data-start=&quot;2797&quot; data-end=&quot;2800&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;2802&quot; data-end=&quot;2822&quot; style=&quot;text-align: start;&quot;&gt;🎯 Tổng kết dễ nhớ&lt;/h1&gt;&lt;ul data-start=&quot;2824&quot; data-end=&quot;2932&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;2824&quot; data-end=&quot;2854&quot;&gt;M = đã sửa, chỉ 1 core giữ&lt;/li&gt;&lt;li data-start=&quot;2855&quot; data-end=&quot;2883&quot;&gt;E = sạch, chỉ 1 core giữ&lt;/li&gt;&lt;li data-start=&quot;2884&quot; data-end=&quot;2911&quot;&gt;S = nhiều core cùng giữ&lt;/li&gt;&lt;li data-start=&quot;2912&quot; data-end=&quot;2932&quot;&gt;I = không hợp lệ&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;2934&quot; data-end=&quot;2978&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Khi ghi:&lt;br&gt;➡️ invalidate tất cả core khác&lt;/p&gt;&lt;p data-start=&quot;2980&quot; data-end=&quot;3009&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Khi đọc:&lt;br&gt;➡️ có thể share&lt;/p&gt;" vertex="1">
