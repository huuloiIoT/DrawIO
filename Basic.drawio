uot; aria-hidden=&quot;true&quot; class=&quot;h-4 w-4&quot;&gt;&lt;/svg&gt;&lt;span class=&quot;text-xs font-semibold&quot;&gt;7&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;h3 data-start=&quot;537&quot; data-end=&quot;557&quot; style=&quot;text-align: start;&quot;&gt;💡 Ý tưởng chính&lt;/h3&gt;&lt;p data-start=&quot;558&quot; data-end=&quot;644&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;Pipeline = chia việc xử lý 1 lệnh thành nhiều bước nhỏ và &lt;strong data-start=&quot;616&quot; data-end=&quot;644&quot;&gt;làm song song nhiều lệnh&lt;/strong&gt;&lt;/p&gt;&lt;hr data-start=&quot;646&quot; data-end=&quot;649&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h3 data-start=&quot;651&quot; data-end=&quot;703&quot; style=&quot;text-align: start;&quot;&gt;🧩 Các stage cơ bản (5-stage pipeline kinh điển)&lt;/h3&gt;&lt;ol data-start=&quot;705&quot; data-end=&quot;912&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;705&quot; data-end=&quot;754&quot;&gt;&lt;strong data-start=&quot;708&quot; data-end=&quot;734&quot;&gt;IF (Instruction Fetch)&lt;/strong&gt; – lấy lệnh từ RAM&lt;/li&gt;&lt;li data-start=&quot;755&quot; data-end=&quot;790&quot;&gt;&lt;strong data-start=&quot;758&quot; data-end=&quot;773&quot;&gt;ID (Decode)&lt;/strong&gt; – giải mã lệnh&lt;/li&gt;&lt;li data-start=&quot;791&quot; data-end=&quot;824&quot;&gt;&lt;strong data-start=&quot;794&quot; data-end=&quot;810&quot;&gt;EX (Execute)&lt;/strong&gt; – tính toán&lt;/li&gt;&lt;li data-start=&quot;825&quot; data-end=&quot;861&quot;&gt;&lt;strong data-start=&quot;828&quot; data-end=&quot;844&quot;&gt;MEM (Memory)&lt;/strong&gt; – truy cập RAM&lt;/li&gt;&lt;li data-start=&quot;862&quot; data-end=&quot;912&quot;&gt;&lt;strong data-start=&quot;865&quot; data-end=&quot;884&quot;&gt;WB (Write Back)&lt;/strong&gt; – ghi kết quả về register&lt;/li&gt;&lt;/ol&gt;&lt;p data-start=&quot;914&quot; data-end=&quot;938&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Thay vì chạy tuần tự:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;939&quot; data-end=&quot;979&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;Lệnh 1 -&amp;gt; xong -&amp;gt; Lệnh 2 -&amp;gt; xong&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;981&quot; data-end=&quot;1006&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Pipeline sẽ chạy kiểu:&lt;/p&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1007&quot; data-end=&quot;1099&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;Cycle 1: L1 (IF)&lt;br&gt;Cycle 2: L1 (ID) + L2 (IF)&lt;br&gt;Cycle 3: L1 (EX) + L2 (ID) + L3 (IF)&lt;br&gt;...&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;p data-start=&quot;1101&quot; data-end=&quot;1153&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;➡️ Tăng throughput rất mạnh (gần như 1 lệnh / cycle)&lt;/p&gt;&lt;hr data-start=&quot;1155&quot; data-end=&quot;1158&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h3 data-start=&quot;1160&quot; data-end=&quot;1190&quot; style=&quot;text-align: start;&quot;&gt;⚠️ Vấn đề: Pipeline Hazard&lt;/h3&gt;&lt;ol data-start=&quot;1192&quot; data-end=&quot;1450&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;1192&quot; data-end=&quot;1287&quot;&gt;&lt;strong data-start=&quot;1195&quot; data-end=&quot;1210&quot;&gt;Data hazard&lt;/strong&gt;&lt;br data-start=&quot;1210&quot; data-end=&quot;1213&quot;&gt;Lệnh sau cần kết quả lệnh trước&lt;br data-start=&quot;1247&quot; data-end=&quot;1250&quot;&gt;→ giải bằng &lt;strong data-start=&quot;1265&quot; data-end=&quot;1287&quot;&gt;forwarding / stall&lt;/strong&gt;&lt;/li&gt;&lt;li data-start=&quot;1289&quot; data-end=&quot;1390&quot;&gt;&lt;strong data-start=&quot;1292&quot; data-end=&quot;1319&quot;&gt;Control hazard (branch)&lt;/strong&gt;&lt;br data-start=&quot;1319&quot; data-end=&quot;1322&quot;&gt;Gặp &lt;code data-start=&quot;1329&quot; data-end=&quot;1338&quot;&gt;if/else&lt;/code&gt; không biết đi đâu&lt;br data-start=&quot;1356&quot; data-end=&quot;1359&quot;&gt;→ dùng &lt;strong data-start=&quot;1369&quot; data-end=&quot;1390&quot;&gt;branch prediction&lt;/strong&gt;&lt;/li&gt;&lt;li data-start=&quot;1392&quot; data-end=&quot;1450&quot;&gt;&lt;strong data-start=&quot;1395&quot; data-end=&quot;1416&quot;&gt;Structural hazard&lt;/strong&gt;&lt;br data-start=&quot;1416&quot; data-end=&quot;1419&quot;&gt;Thiếu tài nguyên phần cứng&lt;/li&gt;&lt;/ol&gt;&lt;hr data-start=&quot;1452&quot; data-end=&quot;1455&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h3 data-start=&quot;1457&quot; data-end=&quot;1480&quot; style=&quot;text-align: start;&quot;&gt;🔥 Thực tế nâng cao&lt;/h3&gt;&lt;ul data-start=&quot;1481&quot; data-end=&quot;1576&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;1481&quot; data-end=&quot;1523&quot;&gt;Superscalar: chạy nhiều lệnh mỗi cycle&lt;/li&gt;&lt;li data-start=&quot;1524&quot; data-end=&quot;1550&quot;&gt;Out-of-order execution&lt;/li&gt;&lt;li data-start=&quot;1551&quot; data-end=&quot;1576&quot;&gt;Speculative execution&lt;/li&gt;&lt;/ul&gt;&lt;p data-start=&quot;1578&quot; data-end=&quot;1702&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;👉 Đây là t