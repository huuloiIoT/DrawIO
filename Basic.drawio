nd=&quot;2115&quot; data-col-size=&quot;sm&quot;&gt;E → Write&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2115&quot; data-end=&quot;2124&quot;&gt;Update&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2124&quot; data-end=&quot;2129&quot;&gt;M&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;2130&quot; data-end=&quot;2167&quot;&gt;&lt;td data-start=&quot;2130&quot; data-end=&quot;2142&quot; data-col-size=&quot;sm&quot;&gt;S → Write&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2142&quot; data-end=&quot;2162&quot;&gt;Invalidate others&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2162&quot; data-end=&quot;2167&quot;&gt;M&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;2168&quot; data-end=&quot;2206&quot;&gt;&lt;td data-start=&quot;2168&quot; data-end=&quot;2188&quot; data-col-size=&quot;sm&quot;&gt;M → Read by other&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2188&quot; data-end=&quot;2201&quot;&gt;Write back&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;2201&quot; data-end=&quot;2206&quot;&gt;S&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;hr data-start=&quot;2208&quot; data-end=&quot;2211&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;h1 data-start=&quot;2213&quot; data-end=&quot;2250&quot; style=&quot;text-align: start;&quot;&gt;💥 7. Vấn đề thực tế: False Sharing&lt;/h1&gt;&lt;h2 data-start=&quot;2252&quot; data-end=&quot;2268&quot; style=&quot;text-align: start;&quot;&gt;🧠 Hiện tượng&lt;/h2&gt;&lt;p data-start=&quot;2269&quot; data-end=&quot;2309&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;2 core &lt;strong data-start=&quot;2276&quot; data-end=&quot;2301&quot;&gt;không dùng chung biến&lt;/strong&gt;, nhưng:&lt;/p&gt;&lt;ul data-start=&quot;2310&quot; data-end=&quot;2338&quot; style=&quot;font-size: medium; text-align: start;&quot;&gt;&lt;li data-start=&quot;2310&quot; data-end=&quot;2338&quot;&gt