lt;br&gt;&lt;span&gt; ├── D0&lt;/span&gt;&lt;br&gt;&lt;span&gt; ├── D1&lt;/span&gt;&lt;br&gt;&lt;span&gt; ├── D2&lt;/span&gt;&lt;br&gt;&lt;span&gt; ├── ...&lt;/span&gt;&lt;br&gt;&lt;span&gt; ├── D7&lt;/span&gt;&lt;br&gt;&lt;span&gt; ├── PCLK&lt;/span&gt;&lt;br&gt;&lt;span&gt; ├── HSYNC&lt;/span&gt;&lt;br&gt;&lt;span&gt; └── VSYNC&lt;/span&gt;&lt;br&gt;&lt;span&gt;      ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;SoC&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;h3 data-section-id=&quot;18iolje&quot; data-start=&quot;5973&quot; data-end=&quot;5984&quot;&gt;Ưu điểm&lt;/h3&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;5986&quot; data-end=&quot;6109&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Dễ hiểu&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Dễ debug bằng logic analyzer&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Phù hợp camera độ phân giải thấp&lt;/span&gt;&lt;br&gt;&lt;span&gt;- RTL/FPGA xử lý đơn giản hơn CSI-2&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;h3 data-section-id=&quot;tkzsee&quot; data-start=&quot;6111&quot; data-end=&quot;6125&quot;&gt;Nhược điểm&lt;/h3&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6127&quot; data-end=&quot;6285&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Cần nhiều chân tín hiệu&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Tốc độ không cao bằng CSI-2&lt;/span&gt;&lt;br&gt;&lt;span&gt;- EMI/nhiễu nhiều hơn ở tốc độ cao&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Không phù hợp module nhỏ, điện thoại, camera hiện đại&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;6287&quot; data-end=&quot;6370&quot;&gt;DVP phù hợp với camera kiểu OV7670, OV2640, một số MCU camera, bài học FPGA cơ bản.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;6372&quot; data-end=&quot;6375&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;3qvs8e&quot; data-start=&quot;6377&quot; data-end=&quot;6398&quot;&gt;10. SLVS / SLVS-EC&lt;/h2&gt;&#xa;&lt;p data-start=&quot;6400&quot; data-end=&quot;6507&quot;&gt;&lt;strong data-start=&quot;6400&quot; data-end=&quot;6408&quot;&gt;SLVS&lt;/strong&gt; và &lt;strong data-start=&quot;6412&quot; data-end=&quot;6423&quot;&gt;SLVS-EC&lt;/strong&gt; là các giao tiếp tốc độ cao thường gặp ở một số cảm biến Sony công nghiệp/high-end.&lt;/p&gt;&#xa;&lt;p data-start=&quot;6509&quot; data-end=&quot;6521&quot;&gt;Có thể hiểu:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6523&quot; data-end=&quot;6627&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;SLVS/SLVS-EC = giao tiếp sensor tốc độ cao, thường dùng trong industrial/high-speed imaging.&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;h3 data-section-id=&quot;18iolje&quot; data-start=&quot;6629&quot; data-end=&quot;6640&quot;&gt;Ưu điểm&lt;/h3&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6642&quot; data-end=&quot;6773&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Tốc độ cao&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Phù hợp sensor độ phân giải lớn/frame rate cao&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Hay dùng trong camera công nghiệp hoặc cảm biến đặc thù&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;h3 data-section-id=&quot;tkzsee&quot; data-start=&quot;6775&quot; data-end=&quot;6789&quot;&gt;Nhược điểm&lt;/h3&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6791&quot; data-end=&quot;6940&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Ít phổ biến hơn CSI-2 trong SBC/SoC phổ thông&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Cần receiver hỗ trợ riêng&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Hệ sinh thái embedded Linux phổ thông không rộng bằng CSI-2&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;6942&quot; data-end=&quot;7047&quot;&gt;Nếu bạn dùng Raspberry Pi, Jetson, NXP i.MX, Rockchip, Qualcomm, Allwinner… thì CSI-2 phổ biến hơn nhiều.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;7049&quot; data-end=&quot;7052&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;1biqtji&quot; data-start=&quot;7054&quot; data-end=&quot;7076&quot;&gt;11. GMSL / FPD-Link&lt;/h2&gt;&#xa;&lt;p data-start=&quot;7078&quot; data-end=&quot;7160&quot;&gt;Đây là các chuẩn &lt;strong data-start=&quot;7095&quot; data-end=&quot;7112&quot;&gt;SerDes camera&lt;/strong&gt; thường dùng trong ô tô, robot, máy công nghiệp.&lt;/p&gt;&#xa;&lt;p data-start=&quot;7162&quot; data-end=&quot;7168&quot;&gt;Ví dụ:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;7170&quot; data-end=&quot;7266&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Camera module&lt;/span&gt;&lt;br&gt;&lt;span&gt; ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Serializer&lt;/span&gt;&lt;br&gt;&lt;span&gt; ↓ coax/twisted pair cable dài&lt;/span&gt;&lt;br&gt;&lt;span&gt;Deserializer&lt;/span&gt;&lt;br&gt;&lt;span&gt; ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;SoC / ISP&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;7268&quot; data-end=&quot;7409&quot;&gt;GMSL và FPD-Link không chỉ là “camera sensor interface ngắn trên PCB” như CSI-2. Chúng sinh ra để truyền camera qua dây dài, chống nhiễu tốt.&lt;/p&gt;&#xa;&lt;h3 data-section-id=&quot;yna9lf&quot; data-start=&quot;7411&quot; data-end=&quot;7419&quot;&gt;GMSL&lt;/h3&gt;&#xa;&lt;p data-start=&quot;7421&quot; data-end=&quot;7462&quot;&gt;GMSL thường gắn với Maxim/Analog Devices.&lt;/p&gt;&#xa;&lt;h3 data-section-id=&quot;hwsyft&quot; data-start=&quot;7464&quot; data-end=&quot;7476&quot;&gt;FPD-Link&lt;/h3&gt;&#xa;&lt;p data-start=&quot;7478&quot; data-end=&quot;7520&quot;&gt;FPD-Link thường gắn với Texas Instruments.&lt;/p&gt;&#xa;&lt;h3 data-section-id=&quot;18iolje&quot; data-start=&quot;7522&quot; data-end=&quot;7533&quot;&gt;Ưu điểm&lt;/h3&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;7535&quot; data-end=&quot;7712&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Truyền xa hơn CSI-2 rất nhiều&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Dùng được dây coax hoặc twisted pair&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Phù hợp ô tô, ADAS, robot, multi-camera&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Có thể truyền video + control + power tùy thiết kế&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;h3 data-section-id=&quot;tkzsee&quot; data-start=&quot;7714&quot; data-end=&quot;7728&quot;&gt;Nhược điểm&lt;/h3&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;7730&quot; data-end=&quot;7874&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Cần serializer/deserializer riêng&lt;/span&gt;&lt;br&gt;&lt;span&gt;- BOM cost cao hơn&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Thiết kế phức tạp hơn&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Không phải sensor nào cũng xuất thẳng GMSL/FPD-Link&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;7876&quot; data-end=&quot;8172&quot;&gt;Một nguồn về embedded vision so sánh GMSL2 và FPD-Link III cho biết cả hai thường dùng trong hệ thống camera khoảng cách xa, có thể dùng coax, hỗ trợ hub/deserializer cho nhiều camera; GMSL2 và FPD-Link III có băng thông cùng cấp cho nhiều ứng dụng 1080p/4K. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;hr data-start=&quot;8174&quot; data-end=&quot;8177&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;1nbsr2w&quot; data-start=&quot;8179&quot; data-end=&quot;8196&quot;&gt;12. MIPI A-PHY&lt;/h2&gt;&#xa;&lt;p data-start=&quot;8198&quot; data-end=&quot;8273&quot;&gt;&lt;strong data-start=&quot;8198&quot; data-end=&quot;8212&quot;&gt;MIPI A-PHY&lt;/strong&gt; là chuẩn MIPI dành cho kết nối tầm xa trong automotive/ADAS.&lt;/p&gt;&#xa;&lt;p data-start=&quot;8275&quot; data-end=&quot;8454&quot;&gt;MIPI mô tả A-PHY là physical layer SerDes tầm xa cho automotive, bao gồm ADAS, autonomous driving và surround-sensor applications như camera. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p data-start=&quot;8456&quot; data-end=&quot;8468&quot;&gt;Có thể hiểu:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;8470&quot; data-end=&quot;8590&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;CSI-2 + D-PHY/C-PHY = camera interface ngắn, trong thiết bị&lt;/span&gt;&lt;br&gt;&lt;span&gt;A-PHY = physical layer dài hơn, hướng automotive&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;8592&quot; data-end=&quot;8745&quot;&gt;A-PHY không thay thế hoàn toàn CSI-2 ở tầng protocol. Trong nhiều kiến trúc, CSI-2 vẫn có thể là dữ liệu camera được transport qua một PHY/SerDes tầm xa.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;8747&quot; data-end=&quot;8750&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;14x0dld&quot; data-start=&quot;8752&quot; data-end=&quot;8776&quot;&gt;13. USB / USB3 Vision&lt;/h2&gt;&#xa;&lt;p data-start=&quot;8778&quot; data-end=&quot;8828&quot;&gt;USB camera rất phổ biến trên PC và embedded board.&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;8830&quot; data-end=&quot;8864&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Camera&lt;/span&gt;&lt;br&gt;&lt;span&gt; ↓ USB&lt;/span&gt;&lt;br&gt;&lt;span&gt;PC / SBC&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;8866&quot; data-end=&quot;8884&quot;