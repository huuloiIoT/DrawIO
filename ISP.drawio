-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Camera Sensor&lt;/span&gt;&lt;br&gt;&lt;span&gt;   │&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ├── CLK+ / CLK-&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ├── DATA0+ / DATA0-&lt;/span&gt;&lt;br&gt;&lt;span&gt;   └── DATA1+ / DATA1-&lt;/span&gt;&lt;br&gt;&lt;span&gt;        ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;SoC CSI Receiver&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;2637&quot; data-end=&quot;2736&quot;&gt;Mỗi lane là tín hiệu vi sai, tức là dùng cặp dây &lt;code data-start=&quot;2686&quot; data-end=&quot;2689&quot;&gt;+&lt;/code&gt; và &lt;code data-start=&quot;2693&quot; data-end=&quot;2696&quot;&gt;-&lt;/code&gt;, giúp chống nhiễu tốt hơn ở tốc độ cao.&lt;/p&gt;&#xa;&lt;p data-start=&quot;2738&quot; data-end=&quot;2785&quot;&gt;Ví dụ IMX219 thường dùng cấu hình CSI-2 2-lane:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2787&quot; data-end=&quot;2854&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;IMX219&lt;/span&gt;&lt;br&gt;&lt;span&gt; ↓ 2-lane MIPI CSI-2&lt;/span&gt;&lt;br&gt;&lt;span&gt;Raspberry Pi / Jetson / SoC&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;hr data-start=&quot;2856&quot; data-end=&quot;2859&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;wbon0f&quot; data-start=&quot;2861&quot; data-end=&quot;2922&quot;&gt;6. Vì sao MIPI CSI-2 được ứng dụng nhiều trong camera ISP?&lt;/h2&gt;&#xa;&lt;p data-start=&quot;2924&quot; data-end=&quot;2972&quot;&gt;Vì nó rất hợp với kiến trúc camera sensor → ISP.&lt;/p&gt;&#xa;&lt;h3 data-section-id=&quot;10kjxub&quot; data-start=&quot;2974&quot; data-end=&quot;3001&quot;&gt;Lý do 1: Băng thông cao&lt;/h3&gt;&#xa;&lt;p data-start=&quot;3003&quot; data-end=&quot;3103&quot;&gt;Camera cần truyền hàng trăm Mbps đến nhiều Gbps. CSI-2 được thiết kế cho video/ảnh độ phân giải cao.&lt;/p&gt;&#xa;&lt;pre cla