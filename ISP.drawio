ine-none keyboard-focused:focus-ring [.text-message+&amp;amp;]:mt-1&quot; data-turn-start-message=&quot;true&quot; tabindex=&quot;0&quot;&gt;&lt;div class=&quot;flex w-full flex-col gap-1 empty:hidden&quot;&gt;&lt;div class=&quot;markdown prose dark:prose-invert wrap-break-word w-full light markdown-new-styling&quot;&gt;&lt;h2 data-section-id=&quot;a3kd83&quot; data-start=&quot;0&quot; data-end=&quot;27&quot;&gt;1. D-PHY và C-PHY là gì?&lt;/h2&gt;&#xa;&lt;p data-start=&quot;29&quot; data-end=&quot;148&quot;&gt;&lt;strong data-start=&quot;29&quot; data-end=&quot;38&quot;&gt;D-PHY&lt;/strong&gt; và &lt;strong data-start=&quot;42&quot; data-end=&quot;51&quot;&gt;C-PHY&lt;/strong&gt; đều là &lt;strong data-start=&quot;59&quot; data-end=&quot;101&quot;&gt;lớp vật lý — Physical Layer — của MIPI&lt;/strong&gt;, dùng để truyền dữ liệu cho các giao thức như:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;150&quot; data-end=&quot;231&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;MIPI CSI-2  → camera sensor đến SoC/ISP&lt;/span&gt;&lt;br&gt;&lt;span&gt;MIPI DSI    → SoC đến display&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;233&quot; data-end=&quot;258&quot;&gt;Với camera ISP, sơ đồ là:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;260&quot; data-end=&quot;386&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Camera Sensor&lt;/span&gt;&lt;br&gt;&lt;span&gt;    ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;CSI-2 Protocol&lt;/span&gt;&lt;br&gt;&lt;span&gt;    ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;D-PHY hoặc C-PHY&lt;/span&gt;&lt;br&gt;&lt;span&gt;    ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Dây tín hiệu vật lý&lt;/span&gt;&lt;br&gt;&lt;span&gt;    ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;CSI-2 Receiver&lt;/span&gt;&lt;br&gt;&lt;span&gt;    ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;ISP&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;388&quot; data-end=&quot;645&quot;&gt;&lt;strong data-start=&quot;388&quot; data-end=&quot;409&quot;&gt;CSI-2 là protocol&lt;/strong&gt;, còn &lt;strong data-start=&quot;415&quot; data-end=&quot;466&quot;&gt;D-PHY/C-PHY là cách tín hiệu điện chạy trên dây&lt;/strong&gt;. MIPI mô tả CSI-2 là giao tiếp camera embedded được triển khai rất rộng rãi; CSI-2 có thể chạy trên các physical layer như D-PHY hoặc C-PHY. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;hr data-start=&quot;647&quot; data-end=&quot;650&quot;&gt;&#xa;&lt;h1 data-section-id=&quot;1usjf1a&quot; data-start=&quot;652&quot; data-end=&quot;673&quot;&gt;2. So sánh ngắn gọn&lt;/h1&gt;&#xa;&lt;div class=&quot;TyagGW_tableContainer&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;group TyagGW_tableWrapper flex flex-col-reverse w-fit&quot;&gt;&lt;table data-start=&quot;675&quot; data-end=&quot;1382&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;675&quot; data-end=&quot;711&quot;&gt;&lt;tr data-start=&quot;675&quot; data-end=&quot;711&quot;&gt;&lt;th data-start=&quot;675&quot; data-end=&quot;686&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Tiêu chí&lt;/th&gt;&lt;th data-start=&quot;686&quot; data-end=&quot;698&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;&lt;strong data-start=&quot;688&quot; data-end=&quot;697&quot;&gt;D-PHY&lt;/strong&gt;&lt;/th&gt;&lt;th data-start=&quot;698&quot; data-end=&quot;711&quot; data-col-size=&quot;md&quot; class=&quot;last:pe-10&quot;&gt;&lt;strong data-start=&quot;700&quot; data-end=&quot;709&quot;&gt;C-PHY&lt;/strong&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;726&quot; data-end=&quot;1382&quot;&gt;&lt;tr data-start=&quot;726&quot; data-end=&quot;799&quot;&gt;&lt;td data-start=&quot;726&quot; data-end=&quot;742&quot; data-col-size=&quot;sm&quot;&gt;Kiểu tín hiệu&lt;/td&gt;&lt;td data-start=&quot;742&quot; data-end=&quot;767&quot; data-col-size=&quot;sm&quot;&gt;Differential signaling&lt;/td&gt;&lt;td data-start=&quot;767&quot; data-end=&quot;799&quot; data-col-size=&quot;md&quot;&gt;Three-phase / trio signaling&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;800&quot; data-end=&quot;845&quot;&gt;&lt;td data-start=&quot;800&quot; data-end=&quot;818&quot; data-col-size=&quot;sm&quot;&gt;Số dây mỗi lane&lt;/td&gt;&lt;td data-start=&quot;818&quot; data-end=&quot;831&quot; data-col-size=&quot;sm&quot;&gt;2 dây/lane&lt;/td&gt;&lt;td data-start=&quot;831&quot; data-end=&quot;845&quot; data-col-size=&quot;md&quot;&gt;3 dây/trio&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;846&quot; data-end=&quot;908&quot;&gt;&lt;td data-start=&quot;846&quot; data-end=&quot;854&quot; data-col-size=&quot;sm&quot;&gt;Clock&lt;/td&gt;&lt;td data-start=&quot;854&quot; data-end=&quot;876&quot; data-col-size=&quot;sm&quot;&gt;Có clock lane riêng&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;876&quot; data-end=&quot;908&quot;&gt;Clock embedded trong dữ liệu&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;909&quot; data-end=&quot;978&quot;&gt;&lt;td data-start=&quot;909&quot; data-end=&quot;929&quot; data-col-size=&quot;sm&quot;&gt;Cấu hình phổ biến&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;929&quot; data-end=&quot;963&quot;&gt;1 clock lane + 1/2/4 data lanes&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;963&quot; data-end=&quot;978&quot;&gt;1/2/3 trios&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;979&quot; data-end=&quot;1009&quot;&gt;&lt;td data-start=&quot;979&quot; data-end=&quot;989&quot; data-col-size=&quot;sm&quot;&gt;Dễ hiểu&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;989&quot; data-end=&quot;998&quot;&gt;Dễ hơn&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;998&quot; data-end=&quot;1009&quot;&gt;Khó hơn&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1010&quot; data-end=&quot;1087&quot;&gt;&lt;td data-start=&quot;1010&quot; data-end=&quot;1024&quot; data-col-size=&quot;sm&quot;&gt;Độ phổ biến&lt;/td&gt;&lt;td data-start=&quot;1024&quot; data-end=&quot;1039&quot; data-col-size=&quot;sm&quot;&gt;Rất phổ biến&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;1039&quot; data-end=&quot;1087&quot;&gt;Ít phổ biến hơn, nhưng mạnh ở high bandwidth&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1088&quot; data-end=&quot;1145&quot;&gt;&lt;td data-start=&quot;1088&quot; data-end=&quot;1105&quot; data-col-size=&quot;sm&quot;&gt;Pin efficiency&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1105&quot; data-end=&quot;1111&quot;&gt;Tốt&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;1111&quot; data-end=&quot;1145&quot;&gt;Tốt hơn trong nhiều trường hợp&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1146&quot; data-end=&quot;1205&quot;&gt;&lt;td data-start=&quot;1146&quot; data-end=&quot;1171&quot; data-col-size=&quot;sm&quot;&gt;Băng thông trên số pin&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1171&quot; data-end=&quot;1188&quot;&gt;Thấp hơn C-PHY&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;1188&quot; data-end=&quot;1205&quot;&gt;Cao hơn D-PHY&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1206&quot; data-end=&quot;1252&quot;&gt;&lt;td data-start=&quot;1206&quot; data-end=&quot;1221&quot; data-col-size=&quot;sm&quot;&gt;Thiết kế PHY&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1221&quot; data-end=&quot;1236&quot;&gt;Đơn giản hơn&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;1236&quot; data-end=&quot;1252&quot;&gt;Phức tạp hơn&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1253&quot; data-end=&quot;1281&quot;&gt;&lt;td data-start=&quot;1253&quot; data-end=&quot;1261&quot; data-col-size=&quot;sm&quot;&gt;Debug&lt;/td&gt;&lt;td data-start=&quot;1261&quot; data-end=&quot;1270&quot; data-col-size=&quot;sm&quot;&gt;Dễ hơn&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;1270&quot; data-end=&quot;1281&quot;&gt;Khó hơn&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;1282&quot; data-end=&quot;1382&quot;&gt;&lt;td data-start=&quot;1282&quot; data-end=&quot;1293&quot; data-col-size=&quot;sm&quot;&gt;Ứng dụng&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;1293&quot; data-end=&quot;1320&quot;&gt;Camera/display phổ thông&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;1320&quot; data-end=&quot;1382&quot;&gt;Camera/display độ phân giải cao, cần ít pin/băng thông cao&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&lt;p data-start=&quot;1384&quot; data-end=&quot;1590&quot;&gt;MIPI mô tả &lt;strong data-start=&quot;1395&quot; data-end=&quot;1404&quot;&gt;D-PHY&lt;/strong&gt; là PHY tốc độ cao, công suất thấp cho imaging/display, còn &lt;strong data-start=&quot;1464&quot; data-end=&quot;1473&quot;&gt;C-PHY&lt;/strong&gt; dùng cơ chế mã hóa three-phase với embedded clock để giảm số lane và giảm EMI. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;hr data-start=&quot;1592&quot; data-end=&quot;1595&quot;&gt;&#xa;&lt;h1 data-section-id=&quot;13sziyz&quot; data-start=&quot;1597&quot; data-end=&quot;1630&quot;&gt;3. D-PHY hoạt động như thế nào?&lt;/h1&gt;&#xa;&lt;p data-start=&quot;1632&quot; data-end=&quot;1665&quot;&gt;D-PHY dùng &lt;strong data-start=&quot;1643&quot; data-end=&quot;1664&quot;&gt;differential pair&lt;/strong&gt;.&lt;/p&gt;&#xa;&lt;p data-start=&quot;1667&quot; data-end=&quot;1691&quot;&gt;Một data lane gồm 2 dây:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1693&quot; data-end=&quot;1720&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;DATA0+ / DATA0-&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;1722&quot; data-end=&quot;1759&quot;&gt;Một hệ D-PHY 2-lane camera thường có:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1761&quot; data-end=&quot;1818&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-ligh