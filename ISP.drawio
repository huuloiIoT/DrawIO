iv&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;tuser = 1 tại pixel (x=0, y=0)&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;4074&quot; data-end=&quot;4083&quot;&gt;Minh họa:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4085&quot; data-end=&quot;4215&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Frame 4x3&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Line 0: P00 P01 P02 P03&lt;/span&gt;&lt;br&gt;&lt;span&gt;        ^&lt;/span&gt;&lt;br&gt;&lt;span&gt;        tuser=1 tại P00&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Line 1: P10 P11 P12 P13&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Line 2: P20 P21 P22 P23&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;h2 data-start=&quot;4217&quot; data-end=&quot;4241&quot;&gt;&lt;span role=&quot;text&quot;&gt;&lt;code data-start=&quot;4220&quot; data-end=&quot;4227&quot;&gt;tlast&lt;/code&gt; = End of Line&lt;/span&gt;&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;4243&quot; data-end=&quot;4469&quot;&gt;&lt;code data-start=&quot;4243&quot; data-end=&quot;4250&quot;&gt;TLAST&lt;/code&gt; là &lt;strong data-start=&quot;4254&quot; data-end=&quot;4275&quot;&gt;EOL — End of Line&lt;/strong&gt;, báo pixel cuối cùng của một scan-line. AMD/Xilinx nói EOL được truyền qua &lt;code data-start=&quot;4351&quot; data-end=&quot;4358&quot;&gt;TLAST&lt;/code&gt;, rộng một valid transaction, và phải trùng với pixel cuối cùng của dòng. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;4471&quot; data-end=&quot;4487&quot;&gt;Ví dụ frame 4×3:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4489&quot; data-end=&quot;4724&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot