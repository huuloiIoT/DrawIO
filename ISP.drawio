;&lt;td data-start=&quot;3270&quot; data-end=&quot;3281&quot; data-col-size=&quot;sm&quot;&gt;&lt;code data-start=&quot;3272&quot; data-end=&quot;3280&quot;&gt;tready&lt;/code&gt;&lt;/td&gt;&lt;td data-start=&quot;3281&quot; data-end=&quot;3294&quot; data-col-size=&quot;md&quot;&gt;IP xuất ra&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;3294&quot; data-end=&quot;3309&quot;&gt;IP nhận vào&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;3310&quot; data-end=&quot;3362&quot;&gt;&lt;td data-start=&quot;3310&quot; data-end=&quot;3320&quot; data-col-size=&quot;sm&quot;&gt;&lt;code data-start=&quot;3312&quot; data-end=&quot;3319&quot;&gt;tuser&lt;/code&gt;&lt;/td&gt;&lt;td data-start=&quot;3320&quot; data-end=&quot;3341&quot; data-col-size=&quot;md&quot;&gt;Đi vào IP, báo SOF&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;3341&quot; data-end=&quot;3362&quot;&gt;Đi ra IP, báo SOF&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;3363&quot; data-end=&quot;3415&quot;&gt;&lt;td data-start=&quot;3363&quot; data-end=&quot;3373&quot; data-col-size=&quot;sm&quot;&gt;&lt;code data-start=&quot;3365&quot; data-end=&quot;3372&quot;&gt;tlast&lt;/code&gt;&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;3373&quot; data-end=&quot;3394&quot;&gt;Đi vào IP, báo EOL&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;3394&quot; data-end=&quot;3415&quot;&gt;Đi ra IP, báo EOL&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;3416&quot; data-end=&quot;3521&quot;&gt;&lt;td data-start=&quot;3416&quot; data-end=&quot;3427&quot; data-col-size=&quot;sm&quot;&gt;Ví dụ IP&lt;/td&gt;&lt;td data-start=&quot;3427&quot; data-end=&quot;3473&quot; data-col-size=&quot;md&quot;&gt;Frame Buffer Write, ISP input, scaler input&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;3473&quot; data-end=&quot;3521&quot;&gt;Frame Buffer Read, ISP output, scaler output&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;p data-start=&quot;3523&quot; data-end=&quot;3587&quot;&gt;Điểm dễ nhầm nhất: &lt;strong data-start=&quot;3542&quot; data-end=&quot;3578&quot;&gt;&lt;code data-start=&quot;3544&quot; data-end=&quot;3552&quot;&gt;tready&lt;/code&gt; luôn do bên nhận tạo ra&lt;/strong&gt;. Vì vậy:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3589&quot; data-end=&quot;3681&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;s_axis_video_tready: current IP tạo ra&lt;/span&gt;&lt;br&gt;&lt;span&gt;m_axis_video_tready: downstream IP tạo ra&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;hr data-start=&quot;3683&quot; data-end=&quot;3686&quot;&gt;&lt;br&gt;&lt;h1 data-st