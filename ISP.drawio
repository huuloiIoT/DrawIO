lip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Horizontal blanking&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Vertical blanking&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;5702&quot; data-end=&quot;5798&quot;&gt;Các khoảng này giúp điều chỉnh frame rate, exposure timing, và tạo khoảng trống giữa line/frame.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;5800&quot; data-end=&quot;5806&quot;&gt;Ví dụ:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;5808&quot; data-end=&quot;5916&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Frame 0 image data&lt;/span&gt;&lt;br&gt;&lt;span&gt;Vertical blanking&lt;/span&gt;&lt;br&gt;&lt;span&gt;Frame 1 image data&lt;/span&gt;&lt;br&gt;&lt;span&gt;Vertical blanking&lt;/span&gt;&lt;br&gt;&lt;span&gt;Frame 2 image data&lt;/span&gt;&lt;br&gt;&lt;span&gt;...&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;5918&quot; data-end=&quot;6090&quot;&gt;Các control như &lt;code data-start=&quot;5934&quot; data-end=&quot;5951&quot;&gt;V4L2_CID_HBLANK&lt;/code&gt;, &lt;code data-start=&quot;5953&quot; data-end=&quot;5970&quot;&gt;V4L2_CID_VBLANK&lt;/code&gt;, &lt;code data-start=&quot;5972&quot; data-end=&quot;5993&quot;&gt;V4L2_CID_PIXEL_RATE&lt;/code&gt; thường được dùng để tính frame timing trong driver IMX219. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;6092&quot; data-end=&quot;6095&quot;&gt;&lt;br&gt;&lt;h3 data-section-id=&quot;1x49m0y&quot; data-start=&quot;6097&quot; data-end=&quot;6153&quot;&gt;Thứ năm: receiver được cấu hình trước để khớp sensor&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;6155&quot; data-end=&quot;6213&quot;&gt;Trước khi bật streaming, driver phải cấu hình cả hai phía:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6215&quot; data-end=&quot;6422&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;IMX219:&lt;/span&gt;&lt;br&gt;&lt;span&gt;- resolution&lt;/span&gt;&lt;br&gt;&lt;span&gt;- format RAW8/RAW10&lt;/span&gt;&lt;br&gt;&lt;span&gt;- lane count&lt;/span&gt;&lt;br&gt;&lt;span&gt;- link frequency&lt;/span&gt;&lt;br&gt;&lt;span&gt;- pixel rate&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;CSI-2 Receiver:&lt;/span&gt;&lt;br&gt;&lt;span&gt;- lane count&lt;/span&gt;&lt;br&gt;&lt;span&gt;- D-PHY timing&lt;/span&gt;&lt;br&gt;&lt;span&gt;- expected data type&lt;/span&gt;&lt;br&gt;&lt;span&gt;- virtual channel&lt;/span&gt;&lt;br&gt;&lt;span&gt;- pixel format&lt;/span&gt;&lt;br&gt;&lt;span&gt;- buffer/DMA&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;6424&quot; data-end=&quot;6642&quot;&gt;Linux CSI-2 documentation nói transmitter driver cần cung cấp cho receiver thông tin bus configuration như &lt;code data-start=&quot;6531&quot; data-end=&quot;6542&quot;&gt;LINK_FREQ&lt;/code&gt;, &lt;code data-start=&quot;6544&quot; data-end=&quot;6556&quot;&gt;PIXEL_RATE&lt;/code&gt;, và callback &lt;code data-start=&quot;6570&quot; data-end=&quot;6582&quot;&gt;s_stream()&lt;/code&gt; để start/stop stream. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;6644&quot; data-end=&quot;6691&quot;&gt;Nếu hai bên cấu hình không khớp, có thể xảy ra:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6693&quot; data-end=&quot;6854&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Không lock được D-PHY&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Sai data type&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Sai line length&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Sai Bayer order&lt;/span&g