; data-end=&quot;10733&quot; data-col-size=&quot;sm&quot;&gt;&lt;code data-start=&quot;10711&quot; data-end=&quot;10717&quot;&gt;href&lt;/code&gt; / active pixel&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;10733&quot; data-end=&quot;10745&quot;&gt;&lt;code data-start=&quot;10735&quot; data-end=&quot;10743&quot;&gt;tvalid&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;10746&quot; data-end=&quot;10786&quot;&gt;&lt;td data-start=&quot;10746&quot; data-end=&quot;10775&quot; data-col-size=&quot;sm&quot;&gt;&lt;code data-start=&quot;10748&quot; data-end=&quot;10760&quot;&gt;vsync edge&lt;/code&gt; / frame start&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;10775&quot; data-end=&quot;10786&quot;&gt;&lt;code data-start=&quot;10777&quot; data-end=&quot;10784&quot;&gt;tuser&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;10787&quot; data-end=&quot;10810&quot;&gt;&lt;td data-start=&quot;10787&quot; data-end=&quot;10799&quot; data-col-size=&quot;sm&quot;&gt;cuối dòng&lt;/td&gt;&lt;td data-start=&quot;10799&quot; data-end=&quot;10810&quot; data-col-size=&quot;sm&quot;&gt;&lt;code data-start=&quot;10801&quot; data-end=&quot;10808&quot;&gt;tlast&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;10811&quot; data-end=&quot;10856&quot;&gt;&lt;td data-start=&quot;10811&quot; data-end=&quot;10844&quot; data-col-size=&quot;sm&quot;&gt;không có tương đương trực tiếp&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;10844&quot; data-end=&quot;10856&quot;&gt;&lt;code data-start=&quot;10846&quot; data-end=&quot;10854&quot;&gt;tready&lt;/code&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&lt;p data-start=&quot;10858&quot; data-end=&quot;10951&quot;&gt;Điểm khác biệt lớn nhất là &lt;strong data-start=&quot;10885&quot; data-end=&quot;10921&quot;&gt;DVP thường không có backpressure&lt;/strong&gt;, còn AXI4-Stream có &lt;code data-start=&quot;10942&quot; data-end=&quot;10950&quot;&gt;tready&lt;/code&gt;.&lt;/p&gt;&#xa;&lt;p data-start=&quot;10953&quot; data-end=&quot;11081&quot;&gt;Vì vậy khi convert DVP/MIPI-like sang AXI4-Stream, nếu downstream kéo &lt;code data-start=&quot;11023&quot; data-end=&quot;11033&quot;&gt;tready=0&lt;/code&gt;, bạn cần FIFO. Nếu không có FIFO, sẽ mất pixel.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;11083&quot; data-end=&quot;11086&quot;&gt;&#xa;&lt;h1 data-start=&quot;11088&quot; data-end=&quot;11109&quot;&gt;14. Kết luận dễ nhớ&lt;/h1&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;11111&quot; data-end=&quot;11202&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;s_axis_video = video stream đi vào IP&lt;/span&gt;&lt;br&gt;&lt;span&gt;m_axis_video = video stream đi ra khỏi IP&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;11204&quot; data-end=&quot;11227&quot;&gt;Trong pipeline của bạn:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;11229&quot; data-end=&quot;11468&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;MIPI RX bridge m_axis_video&lt;/span&gt;&lt;br&gt;&lt;span&gt;   -&amp;gt; Frame Buffer Write s_axis_video&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Frame Buffer Read m_axis_video&lt;/span&gt;&lt;br&gt;&lt;span&gt;   -&amp;gt; ISP-Lite s_axis_video&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;ISP-Lite m_axis_video&lt;/span&gt;&lt;br&gt;&lt;span&gt;   -&amp;gt; VIP s_axis_video&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;VIP m_axis_video&lt;/span&gt;&lt;br&gt;&lt;span&gt;   -&amp;gt; Frame Buffer Write s_axis_video&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;11470&quot; data-end=&quot;11494&quot;&gt;Quy tắc quan trọng nhất:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;11496&quot; data-end=&quot;11569&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;m_axis_video của upstream nối vào s_axis_video của downstream&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;11571&quot; data-end=&quot;11619&quot;&gt;Và khi debug, hãy kiểm tra 5 tín hiệu này trước:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;11621&quot; data-end=&quot;11676&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;tvalid&lt;/span&gt;&lt;br&gt;&lt;span&gt;tready&lt;/span&gt;&lt;br&gt;&lt;span&gt;tdata&lt;/span&gt;&lt;br&gt;&lt;span&gt;tuser = SOF&lt;/span&gt;&lt;br&gt;&lt;span&gt;tlast = EOL&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;11678&quot; data-end=&quot;11830&quot; data-is-last-node=&quot;&quot; data-is-only-node=&quot;&quot;&gt;Nếu sai &lt;code data-start=&quot;11686&quot; data-end=&quot;11693&quot;&gt;tuser&lt;/code&gt;, frame boundary sai. Nếu sai &lt;code data-start=&quot;11723&quot; data-end=&quot;11730&quot;&gt;tlast&lt;/code&gt;, line boundary sai. Nếu &lt;code data-start=&quot;11755&quot; data-end=&quot;11772&quot;&gt;tvalid &amp;amp; tready&lt;/code&gt; không đạt đủ throughput, stream sẽ stall hoặc drop frame.&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;&#xa;&#xa;" id="3UOazP-85POwUwZDba4x-7">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1">
            <mxGeometry height="12070" width="1140" x="12880" y="370" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="3UOazP-85POwUwZDba4x-8" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&#xa;&lt;h1 data-start=&quot;412&quot; data-end=&quot;449&quot;&gt;1. AXI4-Stream Video truyền cái gì?&lt;/h1&gt;&#xa;&lt;p data-start=&quot;451&quot; data-end=&quot;479&quot;&gt;Một video stream cơ bản gồm:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;481&quot; data-end=&quot;650&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;ACLK&lt;/span&gt;&lt;br&gt;&lt;span&gt;ARESETn&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;TDATA   : dữ liệu pixel&lt;/span&gt;&lt;br&gt;&lt;span&gt;TVALID  : bên phát báo TDATA hợp lệ&lt;/span&gt;&lt;br&gt;&lt;span&gt;TREADY  : bên nhận báo sẵn sàng nhận&lt;/span&gt;&lt;br&gt;&lt;span&gt;TUSER   : Start of Frame&lt;/span&gt;&lt;br&gt;&lt;span&gt;TLAST   : End of Line&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;652&quot; data-end=&quot;977&quot;&gt;AMD/Xilinx định nghĩa AXI4-Stream Video truyền &lt;strong data-start=&quot;699&quot; data-end=&quot;720&quot;&gt;active video data&lt;/strong&gt;, không truyền blanking period, audio hay ancillary packet. Các tín hiệu bắt buộc gồm &lt;code data-start=&quot;806&quot; data-end=&quot;813&quot;&gt;TDATA&lt;/code&gt;, &lt;code data-start=&quot;815&quot; data-end=&quot;823&quot;&gt;TVALID&lt;/code&gt;, &lt;code data-start=&quot;825&quot; data-end=&quot;833&quot;&gt;TREADY&lt;/code&gt;, &lt;code data-start=&quot;835&quot; data-end=&quot;842&quot;&gt;TUSER&lt;/code&gt;, &lt;code data-start=&quot;844&quot; data-end=&quot;851&quot;&gt;TLAST&lt;/code&gt;; trong đó &lt;code data-start=&quot;862&quot; data-end=&quot;876&quot;&gt;s_axis_video&lt;/code&gt; là phía input/slave, còn &lt;code data-start=&quot;902&quot; data-end=&quot;916&quot;&gt;m_axis_video&lt;/code&gt; là phía output/master. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p data-start=&quot;979&quot; data-end=&quot;1027&quot;&gt;Một pixel/data beat chỉ thật sự được truyền khi:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1029&quot; data-end=&quot;1062&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;TVALID = 1&lt;/span&gt;&lt;br&gt;&lt;span&gt;TREADY = 1&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;1064&quot; data-end=&quot;1172&quot;&gt;Nếu &lt;code data-start=&quot;1068&quot; data-end=&quot;1078&quot;&gt;TVALID=1&lt;/code&gt; nhưng &lt;code data-start=&quot;1085&quot; data-end=&quot;1095&quot;&gt;TREADY=0&lt;/code&gt;, bên phát phải giữ nguyên &lt;code data-start=&quot;1122&quot; data-end=&quot;1141&quot;&gt;TDATA/TUSER/TLAST&lt;/code&gt; cho đến khi bên nhận sẵn sàng.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;1174&quot; data-end=&quot;1177&quot;&gt;&#xa;&lt;h1 data-start=&quot;1179&quot; data-end=&quot;1242&quot;&gt;2. AXI4-Stream Video biết đâu là frame và line bằng cách nào?&lt;/h1&gt;&#xa;&lt;p data-start=&quot;1244&quot; data-end=&quot;1306&quot;&gt;Nó không dùng &lt;code data-start=&quot;1258&quot; data-end=&quot;1270&quot;&gt;vsync/href&lt;/code&gt; kiểu DVP truyền thống. Thay vào đó:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1308&quot; data-end=&quot;1424&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;TUSER[0] = Start of Frame, pixel đầu tiên của frame&lt;/span&gt;&lt;br&gt;&lt;span&gt;TLAST    = End of Line, pixel cuối cùng của mỗi dòng&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;1426&quot; data-end=&quot;1586&quot;&gt;Theo UG934, &lt;code data-start=&quot;1438&quot; data-end=&quot;1443&quot;&gt;SOF&lt;/code&gt; được truyền trên &lt;code data-start=&quot;1461&quot; data-end=&quot;1469&quot;&gt;TUSER0&lt;/code&gt;, rộng một valid transaction, và phải trùng với pixel đầu tiên của frame/field. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p data-start=&quot;1588&quot; data-end=&quot;1604&quot;&gt;Ví dụ frame 4×3:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1606&quot; data-end=&quot;1857&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Line 0: P00 P01 P02 P03&lt;/span&gt;&lt;br&gt;&lt;span&gt;        ^           ^&lt;/span&gt;&lt;br&gt;&lt;span&gt;        |           TLAST=1&lt;/span&gt;&lt;br&gt;&lt;span&gt;        TUSER=1&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Line 1: P10 P11 P12 P13&lt;/span&gt;&lt;br&gt;&lt;span&gt;                    ^&lt;/span&gt;&lt;br&gt;&lt;span&gt;                    TLAST=1&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Line 2: P20 P21 P22 P23&lt;/span&gt;&lt;br&gt;&lt;span&gt;                    ^&lt;/span&gt;&lt;br&gt;&lt;span&gt;                    TLAST=1&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;1859&quot; data-end=&quot;1884&quot;&gt;Nghĩa là downstream biết:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1886&quot; data-end=&quot;1992&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;TUSER = bắt đầu frame mới&lt;/span&gt;&lt;br&gt;&lt;span&gt;TLAST = kết thúc một dòng&lt;/span&gt;&lt;br&gt;&lt;span&gt;đếm số transfer = vị trí pixel trong frame&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;hr data-start=&quot;1994&quot; data-end=&quot;1997&quot;&gt;&#xa;&lt;h1 data-start=&quot;1999&quot; data-end=&quot;2044&quot;&gt;3. Vậy RAW/RGB/YUV được truyền như thế nào?&lt;/h1&gt;&#xa;&lt;p data-start=&quot;2046&quot; data-end=&quot;2082&quot;&gt;Chúng được &lt;strong data-start=&quot;2057&quot; data-end=&quot;2081&quot;&gt;đóng gói vào &lt;code data-start=&quot;2072&quot; data-end=&quot;2079&quot;&gt;TDATA&lt;/code&gt;&lt;/strong&gt;.&lt;/p&gt;&#xa;&lt;p data-start=&quot;2084&quot; data-end=&quot;2378&quot;&gt;AMD/Xilinx nói &lt;code data-start=&quot;2099&quot; data-end=&quot;2105&quot;&gt;DATA&lt;/code&gt; vector dùng để mã hóa các logical channel bên trong physical &lt;code data-start=&quot;2167&quot; data-end=&quot;2173&quot;&gt;DATA&lt;/code&gt; signal; AXI4-Stream Video có thể truyền video với nhiều độ chính xác như 8/10/12-bit mỗi kênh, nhiều format như RGB hoặc YUV 4:2:0, và nhiều pixel trên một data beat. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p data-start=&quot;2380&quot; data-end=&quot;2425&quot;&gt;Tức là &lt;code data-start=&quot;2387&quot; data-end=&quot;2394&quot;&gt;TDATA&lt;/code&gt; chỉ là một bus bit rộng N-bit:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2427&quot; data-end=&quot;2451&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;TDATA[N-1:0]&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;2453&quot; data-end=&quot;2502&quot;&gt;Còn N bit đó được hiểu là RAW, RGB hay YUV là do:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2504&quot; data-end=&quot;2625&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;C_VIDEO_FORMAT&lt;/span&gt;&lt;br&gt;&lt;span&gt;C_DATA_WIDTH&lt;/span&gt;&lt;br&gt;&lt;span&gt;pixels per clock&lt;/span&gt;&lt;br&gt;&lt;span&gt;thỏa thuận giữa IP upstream và downstream&lt;/span&gt;&lt;br&gt;&lt;span&gt;driver/software config&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;hr data-start=&quot;2627&quot; data-end=&quot;2630&quot;&gt;&#xa;&lt;h1 data-start=&quot;2632&quot; data-end=&quot;2656&quot;&gt;4. Ví dụ truyền RGB888&lt;/h1&gt;&#xa;&lt;p data-start=&quot;2658&quot; data-end=&quot;2687&quot;&gt;RGB888 nghĩa là mỗi pixel có:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2689&quot; data-end=&quot;2746&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;R = 8 bit&lt;/span&gt;&lt;br&gt;&lt;span&gt;G = 8 bit&lt;/span&gt;&lt;br&gt;&lt;span&gt;B = 8 bit&lt;/span&gt;&lt;br&gt;&lt;span&gt;=&amp;gt; 24 bit/pixel&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;2748&quot; data-end=&quot;2788&quot;&gt;Một beat AXI4-Stream có thể chở 1 pixel:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2790&quot; data-end=&quot;2840&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;TDATA[23:0] = {R[7:0], B[7:0], G[7:0]}&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;2842&quot; data-end=&quot;3067&quot;&gt;Lưu ý: trong Xilinx UG934, format RGB có thứ tự subfield hơi đặc biệt trong bảng representation: các field được liệt kê theo nhóm &lt;code data-start=&quot;2972&quot; data-end=&quot;2985&quot;&gt;[3DW-1:2DW]&lt;/code&gt;, &lt;code data-start=&quot;2987&quot; data-end=&quot;2999&quot;&gt;[2DW-1:DW]&lt;/code&gt;, &lt;code data-start=&quot;3001&quot; data-end=&quot;3011&quot;&gt;[DW-1:0]&lt;/code&gt; là &lt;code data-start=&quot;3015&quot; data-end=&quot;3018&quot;&gt;R&lt;/code&gt;, &lt;code data-start=&quot;3020&quot; data-end=&quot;3023&quot;&gt;B&lt;/code&gt;, &lt;code data-start=&quot;3025&quot; data-end=&quot;3028&quot;&gt;G&lt;/code&gt;. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p data-start=&quot;3069&quot; data-end=&quot;3080&quot;&gt;Với &lt;code data-start=&quot;3073&quot; data-end=&quot;3079&quot;&gt;DW=8&lt;/code&gt;:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3082&quot; data-end=&quot;3144&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;TDATA[23:16] = R&lt;/span&gt;&lt;br&gt;&lt;span&gt;TDATA[15:8]  = B&lt;/span&gt;&lt;br&gt;&lt;span&gt;TDATA[7:0]   = G&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;3146&quot; data-end=&quot;3377&quot;&gt;Điểm này rất quan trọng vì nhiều người mặc định RGB sẽ là &lt;code data-start=&quot;3204&quot; data-end=&quot;3213&quot;&gt;{R,G,B}&lt;/code&gt;. Nhưng trong một số IP Xilinx, cách pack thực tế có thể là &lt;code data-start=&quot;3273&quot; data-end=&quot;3282&quot;&gt;{R,B,G}&lt;/code&gt; theo format code. Vì vậy khi nối VIP → Frame Buffer Write → NPU, bạn phải chốt rõ pixel order.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;3379&quot; data-end=&quot;3382&quot;&gt;&#xa;&lt;h1 data-start=&quot;3384&quot; data-end=&quot;3411&quot;&gt;5. Ví dụ truyền YUV 4:4:4&lt;/h1&gt;&#xa;&lt;p data-start=&quot;3413&quot; data-end=&quot;3460&quot;&gt;YUV 4:4:4 nghĩa là mỗi pixel có đủ 3 component:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3462&quot; data-end=&quot;3549&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Y = độ sáng/luma&lt;/span&gt;&lt;br&gt;&lt;span&gt;U/Cb = chroma blue-difference&lt;/span&gt;&lt;br&gt;&lt;span&gt;V/Cr = chroma red-difference&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;3551&quot; data-end=&quot;3575&quot;&gt;Nếu mỗi component 8-bit:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3577&quot; data-end=&quot;3645&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;TDATA[23:16] = V/Cr&lt;/span&gt;&lt;br&gt;&lt;span&gt;TDATA[15:8]  = U/Cb&lt;/span&gt;&lt;br&gt;&lt;span&gt;TDATA[7:0]   = Y&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;3647&quot; data-end=&quot;3765&quot;&gt;Theo bảng UG934, YUV 4:4:4 được biểu diễn với các component &lt;code data-start=&quot;3707&quot; data-end=&quot;3713&quot;&gt;V/Cr&lt;/code&gt;, &lt;code data-start=&quot;3715&quot; data-end=&quot;3721&quot;&gt;U/Cb&lt;/code&gt;, &lt;code data-start=&quot;3723&quot; data-end=&quot;3726&quot;&gt;Y&lt;/code&gt;. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p data-start=&quot;3767&quot; data-end=&quot;3788&quot;&gt;Một beat = một pixel:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3790&quot; data-end=&quot;3871&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Pixel0 = {V0, U0, Y0}&lt;/span&gt;&lt;br&gt;&lt;span&gt;Pixel1 = {V1, U1, Y1}&lt;/span&gt;&lt;br&gt;&lt;span&gt;Pixel2 = {V2, U2, Y2}&lt;/span&gt;&lt;br&gt;&lt;span&gt;...&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;hr data-start=&quot;3873&quot; data-end=&quot;3876&quot;&gt;&#xa;&lt;h1 data-start=&quot;3878&quot; data-end=&quot;3905&quot;&gt;6. Ví dụ truyền YUV 4:2:2&lt;/h1&gt;&#xa;&lt;p data-start=&quot;3907&quot; data-end=&quot;4010&quot;&gt;YUV 4:2:2 có chroma bị subsample theo chiều ngang. Tức là không phải pixel nào cũng có đủ U và V riêng.&lt;/p&gt;&#xa;&lt;p data-start=&quot;4012&quot; data-end=&quot;4048&quot;&gt;Một cặp pixel thường chia sẻ chroma:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4050&quot; data-end=&quot;4073&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Y0 U0 Y1 V0&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;4075&quot; data-end=&quot;4297&quot;&gt;Trong AXI4-Stream Video, UG934 ghi rằng với 4:2:2 và 4:2:0, Cb/U và Cr/V được split qua hai data beat ở chế độ một sample mỗi clock; beat đầu chứa &lt;code data-start=&quot;4222&quot; data-end=&quot;4230&quot;&gt;Cb0:Y0&lt;/code&gt;, beat kế tiếp chứa &lt;code data-start=&quot;4250&quot; data-end=&quot;4258&quot;&gt;Cr0:Y1&lt;/code&gt;. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p data-start=&quot;4299&quot; data-end=&quot;4317&quot;&gt;Ví dụ 2 pixel đầu:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4319&quot; data-end=&quot;4382&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Beat 0: TDATA = {Cb0, Y0}&lt;/span&gt;&lt;br&gt;&lt;span&gt;Beat 1: TDATA = {Cr0, Y1}&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;4384&quot; data-end=&quot;4400&quot;&gt;Nhìn theo pixel:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4402&quot; data-end=&quot;4457&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Pixel 0 mang Y0 + Cb0&lt;/span&gt;&lt;br&gt;&lt;span&gt;Pixel 1 mang Y1 + Cr0&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;4459&quot; data-end=&quot;4520&quot;&gt;Downstream hiểu rằng &lt;code data-start=&quot;4480&quot; data-end=&quot;4485&quot;&gt;Cb0&lt;/code&gt; và &lt;code data-start=&quot;4489&quot; data-end=&quot;4494&quot;&gt;Cr0&lt;/code&gt; thuộc cùng một cặp pixel.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;4522&quot; data-end=&quot;4525&quot;&gt;&#xa;&lt;h1 data-start=&quot;4527&quot; data-end=&quot;4554&quot;&gt;7. Ví dụ truyền RAW Bayer&lt;/h1&gt;&#xa;&lt;p data-start=&quot;4556&quot; data-end=&quot;4660&quot;&gt;RAW Bayer là dữ liệu từ sensor trước demosaic. Mỗi pixel chỉ có &lt;strong data-start=&quot;4620&quot; data-end=&quot;4639&quot;&gt;một giá trị màu&lt;/strong&gt; thuộc pattern Bayer:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4662&quot; data-end=&quot;4796&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;RGGB:&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Line 0: R  G  R  G  R  G ...&lt;/span&gt;&lt;br&gt;&lt;span&gt;Line 1: G  B  G  B  G  B ...&lt;/span&gt;&lt;br&gt;&lt;span&gt;Line 2: R  G  R  G  R  G ...&lt;/span&gt;&lt;br&gt;&lt;span&gt;Line 3: G  B  G  B  G  B ...&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;4798&quot; data-end=&quot;4845&quot;&gt;Vì mỗi vị trí chỉ có một sample, RAW thường là:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4847&quot; data-end=&quot;4941&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;RAW8  = 8 bit/pixel&lt;/span&gt;&lt;br&gt;&lt;span&gt;RAW10 = 10 bit/pixel&lt;/span&gt;&lt;br&gt;&lt;span&gt;RAW12 = 12 bit/pixel&lt;/span&gt;&lt;br&gt;&lt;span&gt;RAW16 = 16 bit/pixel&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;4943&quot; data-end=&quot;5131&quot;&gt;UG934 có format code cho &lt;strong data-start=&quot;4968&quot; data-end=&quot;4993&quot;&gt;Mono/Bayer Sensor RAW&lt;/strong&gt;, và ghi rõ Bayer Sensor data cũng được gọi là RAW data, thường ở dạng RAW8/RAW10/RAW12/RAW14/RAW16. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;p data-start=&quot;5133&quot; data-end=&quot;5163&quot;&gt;Ví dụ RAW10, 1 pixel mỗi beat:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;5165&quot; data-end=&quot;5204&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;TDATA[9:0] = raw_pixel[9:0]&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;5206&quot; data-end=&quot;5298&quot;&gt;Nhưng vì AXI4-Stream &lt;code data-start=&quot;5227&quot; data-end=&quot;5234&quot;&gt;TDATA&lt;/code&gt; thường cần width theo byte, dữ liệu có thể được pad lên 16 bit:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;5300&quot; data-end=&quot;5355&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;TDATA[15:10] = 0&lt;/span&gt;&lt;br&gt;&lt;span&gt;TDATA[9:0]   = RAW10 pixel&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;5357&quot; data-end=&quot;5500&quot;&gt;UG934 cũng nói các component phải pack chặt, và nếu cần thì zero-pad MSB để width thành bội số của 8 bit. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&#xa;&lt;hr data-start=&quot;5502&quot; data-end=&quot;5505&quot;&gt;&#xa;&lt;h1 data-start=&quot;5507&quot; data-end=&quot;5564&quot;&gt;8. Tại sao cùng một protocol truyền được RAW, RGB, YUV?&lt;/h1&gt;&#xa;&lt;p data-start=&quot;5566&quot; data-end=&quot;5606&quot;&gt;Vì AXI4-Stream Video tách hai khái niệm:&lt;/p&gt;&#xa;&lt;h2 data-start=&quot;5608&quot; data-end=&quot;5629&quot;&gt;8.1 Protocol layer&lt;/h2&gt;&#xa;&lt;p data-start=&quot;5631&quot; data-end=&quot;5653&quot;&gt;Protocol chỉ quan tâm:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;5655&quot; data-end=&quot;5842&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;dữ liệu có hợp lệ không?     TVALID&lt;/span&gt;&lt;br&gt;&lt;span&gt;bên nhận có sẵn sàng không?  TREADY&lt;/span&gt;&lt;br&gt;&lt;span&gt;đây có phải đầu frame không? TUSER&lt;/span&gt;&lt;br&gt;&lt;span&gt;đây có phải cuối dòng không? TLAST&lt;/span&gt;&lt;br&gt;&lt;span&gt;payload là gì?              TDATA&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;5844&quot; data-end=&quot;5885&quot;&gt;Nó không cần biết &lt;code data-start=&quot;5862&quot; data-end=&quot;5869&quot;&gt;TDATA&lt;/code&gt; là RGB hay RAW.&lt;/p&gt;&#xa;&lt;h2 data-start=&quot;5887&quot; data-end=&quot;5912&quot;&gt;8.2 Pixel format layer&lt;/h2&gt;&#xa;&lt;p data-start=&quot;5914&quot; data-end=&quot;5966&quot;&gt;Pixel format định nghĩa cách hiểu bit trong &lt;code data-start=&quot;5958&quot; data-end=&quot;5965&quot;&gt;TDATA&lt;/code&gt;:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;5968&quot; data-end=&quot;6191&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;RAW10:&lt;/span&gt;&lt;br&gt;&lt;span&gt;  TDATA[9:0] = raw sample&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;RGB888:&lt;/span&gt;&lt;br&gt;&lt;span&gt;  TDATA[23:16] = R&lt;/span&gt;&lt;br&gt;&lt;span&gt;  TDATA[15:8]  = B&lt;/span&gt;&lt;br&gt;&lt;span&gt;  TDATA[7:0]   = G&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;YUV444:&lt;/span&gt;&lt;br&gt;&lt;span&gt;  TDATA[23:16] = V&lt;/span&gt;&lt;br&gt;&lt;span&gt;  TDATA[15:8]  = U&lt;/span&gt;&lt;br&gt;&lt;span&gt;  TDATA[7:0]   = Y&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;YUV422:&lt;/span&gt;&lt;br&gt;&lt;span&gt;  beat 0 = Cb + Y0&lt;/span&gt;&lt;br&gt;&lt;span&gt;  beat 1 = Cr + Y1&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;6193&quot; data-end=&quot;6289&quot;&gt;Vì vậy cùng một bus có thể chở nhiều loại dữ liệu, miễn là &lt;strong data-start=&quot;6252&quot; data-end=&quot;6288&quot;&gt;hai đầu nối hiểu cùng một format&lt;/strong&gt;.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;6291&quot; data-end=&quot;6294&quot;&gt;&#xa;&lt;h1 data-start=&quot;6296&quot; data-end=&quot;6346&quot;&gt;9. AXI4-Stream Video khác DVP/CSI-2 như thế nào?&lt;/h1&gt;&#xa;&lt;h2 data-start=&quot;6348&quot; data-end=&quot;6354&quot;&gt;DVP&lt;/h2&gt;&#xa;&lt;p data-start=&quot;6356&quot; data-end=&quot;6370&quot;&gt;DVP thường có:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6372&quot; data-end=&quot;6404&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;pclk&lt;/span&gt;&lt;br&gt;&lt;span&gt;data&lt;/span&gt;&lt;br&gt;&lt;span&gt;href&lt;/span&gt;&lt;br&gt;&lt;span&gt;vsync&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;6406&quot; data-end=&quot;6447&quot;&gt;Mapping sang AXI4-Stream Video thường là:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6449&quot; data-end=&quot;6538&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;data  -&amp;gt; TDATA&lt;/span&gt;&lt;br&gt;&lt;span&gt;href  -&amp;gt; TVALID&lt;/span&gt;&lt;br&gt;&lt;span&gt;vsync frame edge -&amp;gt; TUSER&lt;/span&gt;&lt;br&gt;&lt;span&gt;end of line -&amp;gt; TLAST&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;6540&quot; data-end=&quot;6606&quot;&gt;DVP thường &lt;strong data-start=&quot;6551&quot; data-end=&quot;6576&quot;&gt;không có backpressure&lt;/strong&gt;, còn AXI4-Stream có &lt;code data-start=&quot;6597&quot; data-end=&quot;6605&quot;&gt;TREADY&lt;/code&gt;.&lt;/p&gt;&#xa;&lt;h2 data-start=&quot;6608&quot; data-end=&quot;6616&quot;&gt;CSI-2&lt;/h2&gt;&#xa;&lt;p data-start=&quot;6618&quot; data-end=&quot;6643&quot;&gt;CSI-2 truyền dạng packet:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6645&quot; data-end=&quot;6834&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;short packet: Frame Start / Frame End / Line Start / Line End nếu có&lt;/span&gt;&lt;br&gt;&lt;span&gt;long packet : payload RAW/YUV/RGB&lt;/span&gt;&lt;br&gt;&lt;span&gt;Data Type   : RAW8, RAW10, RGB888, YUV422...&lt;/span&gt;&lt;br&gt;&lt;span&gt;Word Count  : số byte payload&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;6836&quot; data-end=&quot;6958&quot;&gt;MIPI CSI-2 receiver sẽ decode packet, bỏ header/ECC/CRC, lấy payload pixel ra, rồi có thể convert thành AXI4-Stream Video:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6960&quot; data-end=&quot;7122&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;CSI-2 packet payload&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; unpack RAW10 nếu cần&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; generate TDATA&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; generate TUSER từ Frame Start&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; generate TLAST từ line length / packet boundary&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;hr data-start=&quot;7124&quot; data-end=&quot;7127&quot;&gt;&#xa;&lt;h1 data-start=&quot;7129&quot; data-end=&quot;7166&quot;&gt;10. Case trong pipeline ISP của bạn&lt;/h1&gt;&#xa;&lt;p data-start=&quot;7168&quot; data-end=&quot;7190&quot;&gt;Pipeline hợp lý sẽ là:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;7192&quot; data-end=&quot;7363&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;IMX219&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; MIPI CSI-2 RX&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; AXI4-Stream RAW Bayer&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; ISP-Lite&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; AXI4-Stream YUV&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; VIP&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; AXI4-Stream RGB&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; Frame Buffer Write&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; DDR Buffer B&lt;/span&gt;&lt;br&gt;&lt;span&gt; -&amp;gt; NPU&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;7365&quot; data-end=&quot;7447&quot;&gt;Tức là cùng một protocol AXI4-Stream Video nhưng payload thay đổi theo từng stage:&lt;/p&gt;&#xa;&lt;div class=&quot;TyagGW_tableContainer&quot;&gt;&lt;div tabindex=&quot;-1&quot; class=&quot;group TyagGW_tableWrapper flex flex-col-reverse w-fit&quot;&gt;&lt;table data-start=&quot;7449&quot; data-end=&quot;7735&quot; class=&quot;w-fit min-w-(--thread-content-width)&quot;&gt;&lt;thead data-start=&quot;7449&quot; data-end=&quot;7489&quot;&gt;&lt;tr data-start=&quot;7449&quot; data-end=&quot;7489&quot;&gt;&lt;th data-start=&quot;7449&quot; data-end=&quot;7465&quot; data-col-size=&quot;sm&quot; class=&quot;last:pe-10&quot;&gt;Đoạn pipeline&lt;/th&gt;&lt;th data-start=&quot;7465&quot; data-end=&quot;7489&quot; data-col-size=&quot;md&quot; class=&quot;last:pe-10&quot;&gt;Format trong &lt;code data-start=&quot;7480&quot; data-end=&quot;7487&quot;&gt;TDATA&lt;/code&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody data-start=&quot;7500&quot; data-end=&quot;7735&quot;&gt;&lt;tr data-start=&quot;7500&quot; data-end=&quot;7547&quot;&gt;&lt;td data-start=&quot;7500&quot; data-end=&quot;7521&quot; data-col-size=&quot;sm&quot;&gt;MIPI RX → ISP-Lite&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;7521&quot; data-end=&quot;7547&quot;&gt;RAW8/RAW10/RAW12 Bayer&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;7548&quot; data-end=&quot;7596&quot;&gt;&lt;td data-start=&quot;7548&quot; data-end=&quot;7565&quot; data-col-size=&quot;sm&quot;&gt;ISP-Lite → VIP&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;7565&quot; data-end=&quot;7596&quot;&gt;YUV444 hoặc YUV dạng nội bộ&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;7597&quot; data-end=&quot;7656&quot;&gt;&lt;td data-start=&quot;7597&quot; data-end=&quot;7624&quot; data-col-size=&quot;sm&quot;&gt;VIP → Frame Buffer Write&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;7624&quot; data-end=&quot;7656&quot;&gt;RGB888/BGR888/format NPU cần&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;7657&quot; data-end=&quot;7735&quot;&gt;&lt;td data-start=&quot;7657&quot; data-end=&quot;7684&quot; data-col-size=&quot;sm&quot;&gt;Frame Buffer Write → DDR&lt;/td&gt;&lt;td data-col-size=&quot;md&quot; data-start=&quot;7684&quot; data-end=&quot;7735&quot;&gt;Không còn stream, chuyển thành AXI memory write&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&#xa;&lt;p data-start=&quot;7737&quot; data-end=&quot;7892&quot;&gt;Điểm quan trọng: &lt;strong data-start=&quot;7754&quot; data-end=&quot;7811&quot;&gt;ISP-Lite không nên nhận RGB nếu nó là ISP xử lý Bayer&lt;/strong&gt;, nó nên nhận RAW Bayer. Sau demosaic/color correction/CSC, ISP mới xuất RGB/YUV.&lt;/p&gt;&#xa;&lt;hr data-start=&quot;7894&quot; data-end=&quot;7897&quot;&gt;&#xa;&lt;h1 data-start=&quot;7899&quot; data-end=&quot;7945&quot;&gt;11. Một frame RAW 4×2 trên AXI4-Stream Video&lt;/h1&gt;&#xa;&lt;p data-start=&quot;7947&quot; data-end=&quot;7974&quot;&gt;Giả sử RAW8, 1 pixel/clock:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;7976&quot; data-end=&quot;8050&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Frame RAW 4x2&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;Line 0: R00 G01 R02 G03&lt;/span&gt;&lt;br&gt;&lt;span&gt;Line 1: G10 B11 G12 B13&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;8052&quot; data-end=&quot;8063&quot;&gt;AXI stream:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;8065&quot; data-end=&quot;8449&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quo