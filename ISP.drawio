C/DT để tổ chức và phân biệt stream. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;11706&quot; data-end=&quot;11735&quot;&gt;Vì vậy CSI-2 RX có thể route:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;11737&quot; data-end=&quot;11860&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;RAW image        → ISP&lt;/span&gt;&lt;br&gt;&lt;span&gt;Embedded metadata → CPU/RAM&lt;/span&gt;&lt;br&gt;&lt;span&gt;Second stream     → another pipeline&lt;/span&gt;&lt;br&gt;&lt;span&gt;Debug dump        → DDR&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;11862&quot; data-end=&quot;11924&quot;&gt;Nếu nhét cứng CSI-2 RX vào ISP, hệ thống sẽ kém linh hoạt hơn.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;11926&quot; data-end=&quot;11929&quot;&gt;&lt;br&gt;&lt;h3 data-section-id=&quot;n9ms6i&quot; data-start=&quot;11931&quot; data-end=&quot;11976&quot;&gt;Lý do 4: Có thể cần DMA vào RAM để buffer&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;11978&quot; data-end=&quot;12029&quot;&gt;Camera và ISP có thể chạy ở clock domain khác nhau:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;12031&quot; data-end=&quot;12097&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;CSI clock domain&lt;/span&gt;&lt;br&gt;&lt;span&gt;ISP clock domain&lt;/span&gt;&lt;br&gt;&lt;span&gt;DDR/AXI clock domain&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;12099&quot; data-end=&quot;12121&quot;&gt;Dùng DMA/AXI/DDR giúp:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;12123&quot; data-end=&quot;12277&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Hấp thụ jitter/burst&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Buffer frame&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Đồng bộ clock domain&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Cho CPU/NPU/encoder cùng truy cập frame&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Debug dễ hơn vì có thể dump RAW frame&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;12279&quot; data-end=&quot;12551&quot;&gt;TI mô tả một CSI2RX subsystem có các IP riêng: &lt;strong data-start=&quot;12326&quot; data-end=&quot;12342&quot;&gt;Cadence DPHY&lt;/strong&gt;, &lt;strong data-start=&quot;12344&quot; data-end=&quot;12369&quot;&gt;Cadence CSI2RX bridge&lt;/strong&gt;, và &lt;strong data-start=&quot;12374&quot; data-end=&quot;12399&quot;&gt;TI CSI2RX DMA wrapper&lt;/strong&gt;; nó hỗ trợ capture camera frame qua MIPI CSI-2, nhiều virtual channel, 1–4 lane, và nhiều format như YUV/RGB/RAW. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;12553&quot; data-end=&quot;12697&quot;&gt;Điều này cho thấy trong SoC thật, CSI receiver thường là một subsystem riêng, có bridge/DMA, không đơn giản chỉ là “một phần nhỏ bên trong ISP”.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;12699&quot; data-end=&quot;12702&quot;&gt;&lt;br&gt;&lt;h3 data-section-id=&quot;prkjv0&quot; data-start=&quot;12704&quot; data-end=&quot;12758&quot;&gt;Lý do 5: ISP không chỉ nhận dữ liệu từ camera live&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;12760&quot; data-end=&quot;12781&quot;&gt;ISP có thể cần xử lý:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;12783&quot; data-end=&quot;12943&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- RAW frame từ sensor live&lt;/span&gt;&lt;br&gt;&lt;span&gt;- RAW frame đã lưu trong DDR&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Test pattern&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Frame từ bridge HDMI-to-CSI&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Frame từ nhiều camera&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Frame replay để debug&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;12945&quot; data-end=&quot;13035&quot;&gt;Nếu ISP chỉ gắn cứng với CSI-2 receiver, bạn mất khả năng dùng ISP cho nguồn dữ liệu khác.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;13037&quot; data-end=&quot;13040&quot;&gt;&lt;br&gt;&lt;h1 data-section-id=&quot;c1gk4m&quot; data-start=&quot;13042&quot; data-end=&quot;13072&quot;&gt;10. Vậy AXI ở đây là AXI gì?&lt;/h1&gt;&lt;br&gt;&lt;p data-start=&quot;13074&quot; data-end=&quot;13088&quot;&gt;Cần phân biệt:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;13090&quot; data-end=&quot;13216&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;AXI4-Lite   = CPU cấu hình register&lt;/span&gt;&lt;br&gt;&lt;span&gt;AXI4        = đọc/ghi frame trong DDR&lt;/span&gt;&lt;br&gt;&lt;span&gt;AXI-Stream  = truyền pixel stream nội bộ&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;13218&quot; data-end=&quot;13240&quot;&gt;Trong camera pipeline:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;13242&quot; data-end=&quot;13407&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;CPU ──AXI4-Lite──&amp;gt; CSI RX registers&lt;/span&gt;&lt;br&gt;&lt;span&gt;CPU ──AXI4-Lite──&amp;gt; ISP registers&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;CSI RX ──AXI4/DMA──&amp;gt; DDR&lt;/span&gt;&lt;br&gt;&lt;span&gt;ISP    ──AXI4──────&amp;gt; DDR&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;hoặc&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;CSI RX ──AXI-Stream──&amp;gt; ISP&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;13409&quot; data-end=&quot;13596&quot;&gt;Không nên hiểu “AXI” chỉ là một loại. Nếu là &lt;strong data-start=&quot;13454&quot; data-end=&quot;13476&quot;&gt;AXI4 memory-mapped&lt;/strong&gt;, thường dùng để ghi frame vào RAM. Nếu là &lt;strong data-start=&quot;13519&quot; data-end=&quot;13533&quot;&gt;AXI-Stream&lt;/strong&gt;, nó có thể là đường pixel stream trực tiếp giữa CSI RX và ISP.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;13598&quot; data-end=&quot;13601&quot;&gt;&lt;br&gt;&lt;h1 data-section-id=&quot;tt7ekf&quot; data-start=&quot;13603&quot; data-end=&quot;13642&quot;&gt;11. Tóm tắt theo từng câu hỏi của bạn&lt;/h1&gt;&lt;br&gt;&lt;h3 data-section-id=&quot;vhvxaj&quot; data-start=&quot;13644&quot; data-end=&quot;13677&quot;&gt;IMX219 đã có packetizer chưa?&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;13679&quot; data-end=&quot;13830&quot;&gt;&lt;strong data-start=&quot;13679&quot; data-end=&quot;13686&quot;&gt;Có.&lt;/strong&gt; IMX219 có CSI-2 transmitter bên trong. Nó tự đóng gói RAW Bayer thành CSI-2 packets rồi truyền qua D-PHY. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;h3 data-section-id=&quot;y6mzpc&quot; data-start=&quot;13832&quot; data-end=&quot;13869&quot;&gt;Có cần cấu hình packetizer không?&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;13871&quot; data-end=&quot;13954&quot;&gt;Bạn không cấu hình packetizer như một IP rời. Bạn cấu hình &lt;strong data-start=&quot;13930&quot; data-end=&quot;13945&quot;&gt;sensor mode&lt;/strong&gt; qua I2C:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;13956&quot; data-end=&quot;14066&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;resolution, RAW8/RAW10, frame rate, exposure, gain, PLL/link frequency, lane config, stream on/off&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;14068&quot; data-end=&quot;14177&quot;&gt;Driver IMX219 trong Linux hỗ trợ các control này ở mức sensor driver. &lt;span class=&quot;&quot; data-state=&quot;closed&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;br&gt;&lt;h3 data-section-id=&quot;107oxtu&quot; data-start=&quot;14179&quot; data-end=&quot;14222&quot;&gt;CSI-2 streaming liên tục bằng cách nào?&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;14224&quot; data-end=&quot;14390&quot;&gt;Sensor liên tục tạo frame, packetizer tạo FS/long packets/FE, D-PHY truyền HS burst tốc độ cao, receiver decode packet, kiểm tra ECC/CRC, rồi đẩy payload vào ISP/DMA.&lt;/p&gt;&lt;br&gt;&lt;h3 data-section-id=&quot;1lkjf4b&quot; data-start=&quot;14392&quot; data-end=&quot;14441&quot;&gt;Hai lane cùng truyền thì biết thứ tự thế nào?&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;14443&quot; data-end=&quot;14541&quot;&gt;Hai lane không truyền packet độc lập. Packet byte stream được chia xen kẽ theo lane order cố định:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;14543&quot; data-end=&quot;14594&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=