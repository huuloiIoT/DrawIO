&gt;Một pipeline thực tế có thể như sau:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4351&quot; data-end=&quot;4544&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;IMX219&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓ RAW10 over MIPI CSI-2&lt;/span&gt;&lt;br&gt;&lt;span&gt;CSI Receiver&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;ISP&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ├── Demosaic&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ├── White balance&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ├── Color correction&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ├── Gamma&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ├── Noise reduction&lt;/span&gt;&lt;br&gt;&lt;span&gt;  └── YUV conversion&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;DDR buffer&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;