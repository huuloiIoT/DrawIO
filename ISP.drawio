646&quot; data-end=&quot;4652&quot;&gt;Ví dụ:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4654&quot; data-end=&quot;4854&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;CPU ghi register ISP_CONTROL = 1&lt;/span&gt;&lt;br&gt;&lt;span&gt;→ ISP bắt đầu chạy&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;CPU ghi register WIDTH = 1920&lt;/span&gt;&lt;br&gt;&lt;span&gt;CPU ghi register HEIGHT = 1080&lt;/span&gt;&lt;br&gt;&lt;span&gt;CPU ghi register FORMAT = YUV420&lt;/span&gt;&lt;br&gt;&lt;span&gt;CPU ghi register OUTPUT_ADDR = 0x80000000&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;4856&quot; data-end=&quot;4878&quot;&gt;Những thao tác này là:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4880&quot; data-end=&quot;4994&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;- Dữ liệu nhỏ&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Không cần burst lớn&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Không cần truyền tốc độ cao&lt;/span&gt;&lt;br&gt;&lt;span&gt;- Chủ yếu là đọc/ghi register 32-bit&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;4996&quot; data-end=&quot;5029&quot;&gt;Vì vậy &lt;strong data-start=&quot;5003&quot; data-end=&quot;5028&quot;&gt;AXI4-Lite rất phù hợp&lt;/strong&gt;.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;5031&quot; data-end=&quot;5034&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;1qx1g0r&quot; data-start=&quot;5036&quot; data-end=&quot;5058&quot;&gt;5. AXI4-Lite là gì?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;5060&quot; data-end=&quot;5137&quot;&gt;&lt;strong data-start=&quot;5060&quot; data-end=&quot;5073&quot;&gt;AXI4-Lite&lt;/strong&gt; là một phiên bản đơn giản của AXI trong chuẩn &lt;strong data-start=&quot;5120&quot; data-end=&quot;5128&quot;&gt;AMBA&lt;/strong&gt; của Arm.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;5139&quot; data-end=&quot;5191&quot;&gt;Nó dùng cho kết nối kiểu &lt;strong data-start=&quot;5164&quot; data-end=&quot;5190&quot;&gt;memory-mapped register&lt;/strong&gt;.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;5193&quot; data-end=&quot;5259&quot;&gt;Tức là CPU nhìn các register của ISP giống như các địa chỉ bộ nhớ.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;5261&quot; data-end=&quot;5267&quot;&gt;Ví dụ:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;5269&quot; data-end=&quot;5631&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute inset-x-4 top-12 bottom-4&quot;&gt;&lt;div class=&quot;pointer-events-none sticky z-40 shrink-0 z-1!&quot;&gt;&lt;div class=&quot;sticky bg-token-border-light&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_BASE        0x40000000&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_CONTROL     (*(volatile uint32_t *)(ISP_BASE + 0x00))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_STATUS      (*(volatile uint32_t *)(ISP_BASE + 0x04))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_WIDTH       (*(volatile uint32_t *)(ISP_BASE + 0x08))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_HEIGHT      (*(volatile uint32_t *)(ISP_BASE + 0x0C))&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_WIDTH&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;1920&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_HEIGHT&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;1080&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_CONTROL&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;1&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;5633&quot; data-end=&quot;5655&quot;&gt;Thực chất khi CPU ghi:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;5657&quot; data-end=&quot;5682&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;