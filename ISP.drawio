uot; data-col-size=&quot;sm&quot;&gt;RGB/YUV&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;13285&quot; data-end=&quot;13323&quot;&gt;&lt;td data-start=&quot;13285&quot; data-end=&quot;13292&quot; data-col-size=&quot;sm&quot;&gt;0x18&lt;/td&gt;&lt;td data-start=&quot;13292&quot; data-end=&quot;13308&quot; data-col-size=&quot;sm&quot;&gt;ISP_WB_R_GAIN&lt;/td&gt;&lt;td data-start=&quot;13308&quot; data-end=&quot;13323&quot; data-col-size=&quot;sm&quot;&gt;Gain kênh R&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;13324&quot; data-end=&quot;13362&quot;&gt;&lt;td data-start=&quot;13324&quot; data-end=&quot;13331&quot; data-col-size=&quot;sm&quot;&gt;0x1C&lt;/td&gt;&lt;td data-start=&quot;13331&quot; data-end=&quot;13347&quot; data-col-size=&quot;sm&quot;&gt;ISP_WB_G_GAIN&lt;/td&gt;&lt;td data-start=&quot;13347&quot; data-end=&quot;13362&quot; data-col-size=&quot;sm&quot;&gt;Gain kênh G&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;13363&quot; data-end=&quot;13401&quot;&gt;&lt;td data-start=&quot;13363&quot; data-end=&quot;13370&quot; data-col-size=&quot;sm&quot;&gt;0x20&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;13370&quot; data-end=&quot;13386&quot;&gt;ISP_WB_B_GAIN&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;13386&quot; data-end=&quot;13401&quot;&gt;Gain kênh B&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;13402&quot; data-end=&quot;13449&quot;&gt;&lt;td data-start=&quot;13402&quot; data-end=&quot;13409&quot; data-col-size=&quot;sm&quot;&gt;0x24&lt;/td&gt;&lt;td data-start=&quot;13409&quot; data-end=&quot;13424&quot; data-col-size=&quot;sm&quot;&gt;ISP_OUT_ADDR&lt;/td&gt;&lt;td data-start=&quot;13424&quot; data-end=&quot;13449&quot; data-col-size=&quot;sm&quot;&gt;Địa chỉ buffer output&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;13450&quot; data-end=&quot;13487&quot;&gt;&lt;td data-start=&quot;13450&quot; data-end=&quot;13457&quot; data-col-size=&quot;sm&quot;&gt;0x28&lt;/td&gt;&lt;td data-start=&quot;13457&quot; data-end=&quot;13470&quot; data-col-size=&quot;sm&quot;&gt;ISP_INT_EN&lt;/td&gt;&lt;td data-col-size=&quot;sm&quot; data-start=&quot;13470&quot; data-end=&quot;13487&quot;&gt;Bật interrupt&lt;/td&gt;&lt;/tr&gt;&lt;tr data-start=&quot;13488&quot; data-end=&quot;13536&quot;&gt;&lt;td data-start=&quot;13488&quot; data-end=&quot;13495&quot; data-col-size=&quot;sm&quot;&gt;0x2C&lt;/td&gt;&lt;td data-start=&quot;13495&quot; data-end=&quot;13512&quot; data-col-size=&quot;sm&quot;&gt;ISP_INT_STATUS&lt;/td&gt;&lt;td data-start=&quot;13512&quot; data-end=&quot;13536&quot; data-col-size=&quot;sm&quot;&gt;Trạng thái interrupt&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;&lt;/div&gt;&lt;br&gt;&lt;p data-start=&quot;13538&quot; data-end=&quot;13567&quot;&gt;Code firmware có thể như sau:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;13569&quot; data-end=&quot;14679&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute inset-x-4 top-12 bottom-4&quot;&gt;&lt;div class=&quot;pointer-events-none sticky z-40 shrink-0 z-1!&quot;&gt;&lt;div class=&quot;sticky bg-token-border-light&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_BASE          0x40000000&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_CTRL          (*(volatile uint32_t *)(ISP_BASE + 0x00))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_STATUS        (*(volatile uint32_t *)(ISP_BASE + 0x04))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_WIDTH         (*(volatile uint32_t *)(ISP_BASE + 0x08))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_HEIGHT        (*(volatile uint32_t *)(ISP_BASE + 0x0C))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_INPUT_FMT     (*(volatile uint32_t *)(ISP_BASE + 0x10))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_OUTPUT_FMT    (*(volatile uint32_t *)(ISP_BASE + 0x14))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_WB_R_GAIN     (*(volatile uint32_t *)(ISP_BASE + 0x18))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_WB_G_GAIN     (*(volatile uint32_t *)(ISP_BASE + 0x1C))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_WB_B_GAIN     (*(volatile uint32_t *)(ISP_BASE + 0x20))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_OUT_ADDR      (*(volatile uint32_t *)(ISP_BASE + 0x24))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼf&quot;&gt;#define ISP_INT_EN        (*(volatile uint32_t *)(ISP_BASE + 0x28))&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span class=&quot;ͼm&quot;&gt;void&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;isp_init&lt;/span&gt;&lt;span&gt;(&lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;void&lt;/span&gt;&lt;span&gt;)&lt;/span&gt;&lt;br&gt;&lt;span&gt;{&lt;/span&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_WIDTH&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;1920&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_HEIGHT&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;1080&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_INPUT_FMT&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;0&lt;/span&gt;&lt;span&gt;;   &lt;/span&gt;&lt;span class=&quot;ͼe&quot;&gt;// RAW10&lt;/span&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_OUTPUT_FMT&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;1&lt;/span&gt;&lt;span&gt;;  &lt;/span&gt;&lt;span class=&quot;ͼe&quot;&gt;// NV12/YUV&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_WB_R_GAIN&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;0x120&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_WB_G_GAIN&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;0x100&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_WB_B_GAIN&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;0x180&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_OUT_ADDR&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;0x80000000&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_INT_EN&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;1&lt;/span&gt;&lt;span&gt;;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;ISP_CTRL&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼg&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼj&quot;&gt;1&lt;/span&gt;&lt;span&gt;;        &lt;/span&gt;&lt;span class=&quot;ͼe&quot;&gt;// enable ISP&lt;/span&gt;&lt;br&gt;&lt;span&gt;}&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;14681&quot; data-end=&quot;14741&quot;&gt;Đằng sau mỗi dòng ghi register là một transaction AXI4-Lite.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;14743&quot; data-end=&quot;14746&quot;&gt;&lt;br&gt;&lt;h1 data-section-id=&quot;1wapvuk&quot; data-start=&quot;14748&quot; data-end=&quot;14771&quot;&gt;13. Kết luận ngắn gọn&lt;/h1&gt;&lt;br&gt;&lt;p data-start=&quot;14773&quot; data-end=&quot;14897&quot;&gt;&lt;strong data-start=&quot;14773&quot; data-end=&quot;14780&quot;&gt;ISP&lt;/strong&gt; là khối xử lý ảnh từ dữ liệu RAW của camera sensor thành ảnh có thể dùng được cho display, encoder, AI hoặc lưu trữ.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;14899&quot; data-end=&quot;14944&quot;&gt;&lt;strong data-start=&quot;14899&quot; data-end=&quot;14912&quot;&gt;AXI4-Lite&lt;/strong&gt; được dùng trong ISP chủ yếu để:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-star