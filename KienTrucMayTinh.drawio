gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;              +------------------+&lt;/span&gt;&lt;br&gt;&lt;span&gt;Reset event → | Reset controller |&lt;/span&gt;&lt;br&gt;&lt;span&gt;              +------------------+&lt;/span&gt;&lt;br&gt;&lt;span&gt;                       |&lt;/span&gt;&lt;br&gt;&lt;span&gt;                       v&lt;/span&gt;&lt;br&gt;&lt;span&gt;              +------------------+&lt;/span&gt;&lt;br&gt;&lt;span&gt;              | Boot selection   |&lt;/span&gt;&lt;br&gt;&lt;span&gt;              +------------------+&lt;/span&gt;&lt;br&gt;&lt;span&gt;                 |            |&lt;/span&gt;&lt;br&gt;&lt;span&gt;                 v            v&lt;/span&gt;&lt;br&gt;&lt;span&gt;          BootROM entry    Flash vector table&lt;/span&gt;&lt;br&gt;&lt;span&gt;                 |            |&lt;/span&gt;&lt;br&gt;&lt;span&gt;                 v            v&lt;/span&gt;&lt;br&gt;&lt;span&gt;          Load/jump app   Reset_Handler&lt;/span&gt;&lt;br&gt;&lt;span&gt;                 |&lt;/span&gt;&lt;br&gt;&lt;span&gt;                 v&lt;/span&gt;&lt;br&gt;&lt;span&gt;          Reset_Handler&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;hr data-start=&quot;6271&quot; data-end=&quot;6274&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;1jd9ykn&quot; data-start=&quot;6276&quot; data-end=&quot;6309&quot;&gt;9. Với STM32 thì hiểu thế nào?&lt;/h2&gt;&#xa;&lt;p data-start=&quot;6311&quot; data-end=&quot;6356&quot;&gt;Với STM32 thông dụng, khi boot từ user Flash:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6358&quot; data-end=&quot;6429&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Power-on reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;External reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;Watchdog reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;Software reset&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;6431&quot; data-end=&quot;6507&quot;&gt;thường đều quay về vector table của user Flash, sau đó chạy &lt;code data-start=&quot;6491&quot; data-end=&quot;6506&quot;&gt;Reset_Handler&lt;/code&gt;.&lt;/p&gt;&#xa;&lt;p data-start=&quot;6509&quot; data-end=&quot;6621&quot;&gt;BootROM/System Memory chỉ chạy nếu boot mode chọn vào System Memory, ví dụ qua BOOT0/option bytes tùy dòng chip.&lt;/p&gt;&#xa;&lt;p data-start=&quot;6623&quot; data-end=&quot;6666&quot;&gt;Nên với STM32, cách hiểu thực tế thường là:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;6668&quot; data-end=&quot;6815&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Bật nguồn hay watchdog reset đều chạy lại Reset_Handler trong Flash app,&lt;/span&gt;&lt;br&gt;&lt;span&gt;trừ khi boot configuration chọn vào BootROM/System bootloader.&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;hr data-start=&quot;6817&quot; data-end=&quot;6820&quot;&gt;&#xa;&lt;h2 data-section-id=&quot;vmdqm4&quot; data-start=&quot;6822&quot; data-end=&quot;6846&quot;&gt;10. Kết luận ngắn gọn&lt;/h2&gt;&#xa;&lt;p data-start=&quot;6848&quot; data-end=&quot;6860&quot;&gt;Câu của bạn:&lt;/p&gt;&#xa;&lt;blockquote data-start=&quot;6862&quot; data-end=&quot;6982&quot;&gt;&#xa;&lt;p data-start=&quot;6864&quot; data-end=&quot;6982&quot;&gt;“Khi tắt nguồn mở lại MCU sẽ chạy từ BootROM. Còn khi CPU bị treo và watchdog reset lại thì sẽ chạy từ Reset_Handler.”&lt;/p&gt;&#xa;&lt;/blockquote&gt;&#xa;&lt;p data-start=&quot;6984&quot; data-end=&quot;6998&quot;&gt;Nên sửa thành:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;7000&quot; data-end=&quot;7295&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Sau power-on reset hoặc watchdog reset, CPU đều bắt đầu lại từ reset entry.&lt;/span&gt;&lt;br&gt;&lt;span&gt;Reset entry có thể là BootROM hoặc vector table trong Flash, tùy MCU và boot configuration.&lt;/span&gt;&lt;br&gt;&lt;span&gt;Với nhiều MCU như STM32 boot từ user Flash, cả power-on reset và watchdog reset đều chạy Reset_Handler trong Flash.&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&#xa;&lt;p data-start=&quot;7297&quot; data-end=&quot;7336&quot;&gt;Còn lý do không luôn boot full BootROM:&lt;/p&gt;&#xa;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;7338&quot; data-end=&quot;7559&quot; data-is-last-node=&quot;&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;vì cần reset nhanh,&lt;/span&gt;&lt;br&gt;&lt;span&gt;vì watchdog chỉ để phục hồi app,&lt;/span&gt;&lt;br&gt;&lt;span&gt;vì BootROM có thể chờ bootloader/nạp firmware,&lt;/span&gt;&lt;br&gt;&lt;span&gt;vì không phải reset nào cũng reset toàn bộ chip,&lt;/span&gt;&lt;br&gt;&lt;span&gt;và vì boot source thường đã được chọn cố định là user Flash.&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;&#xa;&#xa;" id="AoWASO6poIcUC61nZHE8-9">
          <mxCell parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" vertex="1">
            <mxGeometry height="7710" width="860" x="1890" y="1500" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="AoWASO6poIcUC61nZHE8-11" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;font style=&quot;font-size: 61px;&quot;&gt;theo tôi hiểu chức năng boot rom ngoài việc là entry point sau reset thì nó cũng là nơi quyết định xem MCU sẽ boot từ loại bộ nhớ nào (flash, sd card, qspi...). Và hỗ trợ nạp lại app và quyết định xem việc app sẽ được nạp từ đâu (Uart, SPI, I2c, Jtag...) có đúng không ?&amp;nbsp;&lt;/font&gt;&lt;br&gt;&lt;p data-start=&quot;0&quot; data-end=&quot;69&quot;&gt;Đúng &lt;strong data-start=&quot;5&quot; data-end=&quot;17&quot;&gt;phần lớn&lt;/strong&gt;, nhưng cần tách rõ 2 vai trò khác nhau của BootROM:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;71&quot; data-end=&quot;257&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;BootROM có thể:&lt;/span&gt;&lt;br&gt;&lt;span&gt;1. Là code chạy rất sớm sau reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;2. Quyết định boot từ đâu&lt;/span&gt;&lt;br&gt;&lt;span&gt;3. Load / verify / jump vào firmware&lt;/span&gt;&lt;br&gt;&lt;span&gt;4. Hỗ trợ chế độ nạp lại firmware qua UART/USB/SPI/I2C/CAN...&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;259&quot; data-end=&quot;410&quot;&gt;Nhưng không phải MCU nào BootROM cũng làm tất cả các việc đó, và &lt;strong data-start=&quot;324&quot; data-end=&quot;409&quot;&gt;JTAG thường không phải do BootROM “hỗ trợ nạp app” theo nghĩa bootloader protocol&lt;/strong&gt;.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;412&quot; data-end=&quot;415&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;ljvomc&quot; data-start=&quot;417&quot; data-end=&quot;437&quot;&gt;1. BootROM là gì?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;439&quot; data-end=&quot;532&quot;&gt;&lt;strong data-start=&quot;439&quot; data-end=&quot;450&quot;&gt;BootROM&lt;/strong&gt; là một đoạn code cố định được nhà sản xuất chip ghi sẵn trong ROM bên trong chip.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;534&quot; data-end=&quot;574&quot;&gt;Nó thường không sửa được bởi người dùng.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;576&quot; data-end=&quot;591&quot;&gt;Nhiệm vụ chính:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;593&quot; data-end=&quot;802&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM hoặc boot logic chạy&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Xác định boot source&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Tìm firmware/app&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Có thể kiểm tra hợp lệ / secure boot&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Load hoặc map firmware&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Nhảy vào app Reset_Handler / entry point&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;hr data-start=&quot;804&quot; data-end=&quot;807&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;17vs0dy&quot; data-start=&quot;809&quot; data-end=&quot;859&quot;&gt;2. BootROM có phải entry point sau reset không?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;861&quot; data-end=&quot;887&quot;&gt;&lt;strong data-start=&quot;861&quot; data-end=&quot;887&quot;&gt;Có thể đúng, tùy chip.&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;889&quot; data-end=&quot;958&quot;&gt;Với SoC/MCU phức tạp, BootROM thường là code đầu tiên chạy sau reset.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;960&quot; data-end=&quot;966&quot;&gt;Ví dụ:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;968&quot; data-end=&quot;1051&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Load app từ QSPI/eMMC/SD/NAND...&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Jump vào app&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;1053&quot; data-end=&quot;1209&quot;&gt;Nhưng với nhiều MCU nhỏ như một số dòng Cortex-M, khi boot từ internal Flash, CPU có thể đọc trực tiếp vector table ở Flash và chạy &lt;code data-start=&quot;1185&quot; data-end=&quot;1200&quot;&gt;Reset_Handler&lt;/code&gt; của app.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1211&quot; data-end=&quot;1279&quot;&gt;Khi đó BootROM/System Bootloader chỉ chạy nếu boot mode chọn vào nó.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1281&quot; data-end=&quot;1301&quot;&gt;Vậy câu đúng hơn là:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1303&quot; data-end=&quot;1444&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;BootROM có thể là entry point đầu tiên sau reset,&lt;/span&gt;&lt;br&gt;&lt;span&gt;nhưng trên một số MCU, app Flash Reset_Handler có thể là entry point trực tiếp.&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;hr data-start=&quot;1446&quot; data-end=&quot;1449&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;1zt4uz&quot; data-start=&quot;1451&quot; data-end=&quot;1513&quot;&gt;3. BootROM có quyết định MCU boot từ loại bộ nhớ nào không?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;1515&quot; data-end=&quot;1563&quot;&gt;&lt;strong data-start=&quot;1515&quot; data-end=&quot;1523&quot;&gt;Đúng&lt;/strong&gt;, nhất là với chip có nhiều boot source.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1565&quot; data-end=&quot;1616&quot;&gt;BootROM hoặc boot hardware sẽ đọc các cấu hình như:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1618&quot; data-end=&quot;1725&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot