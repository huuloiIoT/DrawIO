ointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Reset_Handler&lt;/span&gt;&lt;br&gt;&lt;span&gt;SystemInit()&lt;/span&gt;&lt;br&gt;&lt;span&gt;main()&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;hr data-start=&quot;1383&quot; data-end=&quot;1386&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;balvyb&quot; data-start=&quot;1388&quot; data-end=&quot;1448&quot;&gt;3. Vậy khi tắt nguồn mở lại thì có chạy từ BootROM không?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;1450&quot; data-end=&quot;1470&quot;&gt;Câu trả lời đúng là:&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1472&quot; data-end=&quot;1561&quot;&gt;&lt;strong data-start=&quot;1472&quot; data-end=&quot;1561&quot;&gt;Có thể có, nhưng không phải lúc nào cũng theo nghĩa “app của bạn bắt đầu từ BootROM”.&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1563&quot; data-end=&quot;1601&quot;&gt;Tùy chip, có 2 kiểu thiết kế phổ biến.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;1603&quot; data-end=&quot;1606&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;cahwwf&quot; data-start=&quot;1608&quot; data-end=&quot;1666&quot;&gt;4. Kiểu 1: MCU đơn giản — CPU reset thẳng vào Flash app&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;1668&quot; data-end=&quot;1731&quot;&gt;Nhiều MCU như ARM Cortex-M truyền thống có cơ chế boot mapping.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1733&quot; data-end=&quot;1756&quot;&gt;Khi boot từ user Flash:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1758&quot; data-end=&quot;1859&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Power-on reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;CPU đọc vector table ở Flash&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Nhảy vào Reset_Handler của firmware&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;1861&quot; data-end=&quot;1867&quot;&gt;Ví dụ:&lt;/p&gt;&lt;br&gt;&lt;pre class=&