lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;2660&quot; data-end=&quot;2671&quot;&gt;Quan trọng:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2673&quot; data-end=&quot;2742&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Instruction/code thường ở Flash&lt;/span&gt;&lt;br&gt;&lt;span&gt;Biến runtime thường ở RAM&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;hr data-start=&quot;2744&quot; data-end=&quot;2747&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;1o1h8xy&quot; data-start=&quot;2749&quot; data-end=&quot;2811&quot;&gt;5. CPU có phải mỗi lần đọc instruction đều vào Flash không?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;2813&quot; data-end=&quot;2841&quot;&gt;Về logic thì có thể hiểu là:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2843&quot; data-end=&quot;2915&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;CPU cần instruction → fetch từ địa chỉ instruction đang chạy&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;2917&quot; data-end=&quot;2971&quot;&gt;Nếu code nằm ở Flash, thì địa chỉ đó thuộc vùng Flash.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2973&quot; data-end=&quot;3017&quot;&gt;Nhưng thực tế thường có các cơ chế tăng tốc:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3019&quot; data-end=&quot;3131&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Flash prefetch&lt;/span&gt;&lt;br&gt;&lt;span&gt;instruction cache&lt;/span&gt;&lt;br&gt;&lt;span&gt;ART accelerator&lt;/span&gt;&lt;br&gt;&lt;span&gt;line buffer&lt;/span&gt;&lt;br&gt;&lt;span&gt;ITCM&lt;/span&gt;&lt;br&gt;&lt;span&gt;branch cache&lt;/span&gt;&lt;br&gt;&lt;span&gt;wait-state controller&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;3133&quot; data-end=&quot;3213&quot;&gt;Nên không phải lúc nào cũng “đọc Flash thô” từng instruction một cách chậm chạp.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;3215&quot; data-end=&quot;3239&quot;&gt;Ví dụ trên một số STM32:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3241&quot; data-end=&quot;3379&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;CPU fetch instruction từ Flash&lt;/span&gt;&lt;br&gt;&lt;span&gt;↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Flash accelerator/prefetch/cache lấy trước nhiều instruction&lt;/span&gt;&lt;br&gt;&lt;span&gt;↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;CPU nhận instruction nhanh hơn&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;3381&quot; data-end=&quot;3454&quot;&gt;Nhưng về bản chất, code vẫn nằm trong Flash nếu không được copy sang RAM.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;3456&quot; data-end=&quot;3459&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;1wmizcj&quot; data-start=&quot;3461&quot; data-end=&quot;3509&quot;&gt;6. Vì sao không copy hết instruction lên RAM?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;3511&quot; data-end=&quot;3553&quot;&gt;Vì RAM của MCU thường nhỏ hơn Flash nhiều.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;3555&quot; data-end=&quot;3561&quot;&gt;Ví dụ:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3563&quot; data-end=&quot;3602&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Flash: 512 KB&lt;/span&gt;&lt;br&gt;&lt;span&gt;RAM:   128 KB&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;3604&quot; data-end=&quot;3700&quot;&gt;Nếu copy toàn bộ code 300 KB lên RAM thì RAM còn rất ít cho stack, heap, buffer, DMA, RTOS task.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;3702&quot; data-end=&quot;3784&quot;&gt;Flash là non-volatile memory, mất điện không mất dữ liệu. RAM thì mất điện là mất.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;3786&quot; data-end=&quot;3854&quot;&gt;Nên firmware thường được lưu trong Flash và chạy trực tiếp từ Flash.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;3856&quot; data-end=&quot;3859&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;atzl7c&quot; data-start=&quot;3861&quot; data-end=&quot;3907&quot;&gt;7. Khi nào code được copy từ Flash lên RAM?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;3909&quot; data-end=&quot;3939&quot;&gt;Có một số trường hợp đặc biệt.&lt;/p&gt;&lt;br&gt;&lt;h3 data-section-id=&quot;1b2kcg9&quot; data-start=&quot;3941&quot; data-end=&quot;3977&quot;&gt;Trường hợp 1: Hàm cần chạy nhanh&lt;/h3&gt;&lt;br&gt;&lt;p data-start=&quot;3979&quot; data-end=&quot;4023&quot;&gt;Một số hàm critical có thể được đặt vào RAM:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4025&quot; data-end=&quot;4123&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;relative h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute inset-x-4 top-12 bottom-4&quot;&gt;&lt;div class=&quot;pointer-events-none sticky z-40 shrink-0 z-1!&quot;&gt;&lt;div class=&quot;sticky bg-token-border-light&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span class=&quot;ͼl&quot;&gt;__attribute__&lt;/span&gt;&lt;span&gt;((&lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;section&lt;/span&gt;&lt;span&gt;(&lt;/span&gt;&lt;span class=&quot;ͼk&quot;&gt;&quot;.ramfunc&quot;&lt;/span&gt;&lt;span&gt;)))&lt;/span&gt;&lt;br&gt;&lt;span class=&quot;ͼm&quot;&gt;void&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;fast_function&lt;/span&gt;&lt;span&gt;(&lt;/span&gt;&lt;span class=&quot;ͼm&quot;&gt;void&lt;/span&gt;&lt;span&gt;)&lt;/span&gt;&lt;br&gt;&lt;span&gt;{&lt;/span&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼe&quot;&gt;// code chạy từ RAM&lt;/span&gt;&lt;br&gt;&lt;span&gt;}&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;4125&quot; data-end=&quot;4179&quot;&gt;Khi đó linker đặt hàm này vào section đặc biệt, ví dụ:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;4181&quot; data-end=&quot;4201&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-ful