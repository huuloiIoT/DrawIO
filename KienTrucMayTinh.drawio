;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM đọc boot mode&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Nếu boot mode = QSPI&lt;/span&gt;&lt;br&gt;&lt;span&gt;      tìm image trong QSPI Flash&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Nếu boot mode = SD&lt;/span&gt;&lt;br&gt;&lt;span&gt;      tìm image trong SD card&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Nếu boot mode = UART&lt;/span&gt;&lt;br&gt;&lt;span&gt;      chờ host gửi firmware qua UART&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Nếu image hợp lệ&lt;/span&gt;&lt;br&gt;&lt;span&gt;      nhảy vào firmware&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;hr data-start=&quot;2156&quot; data-end=&quot;2159&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;1vk4160&quot; data-start=&quot;2161&quot; data-end=&quot;2203&quot;&gt;4. BootROM có hỗ trợ nạp lại app không?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;2205&quot; data-end=&quot;2267&quot;&gt;&lt;strong data-start=&quot;2205&quot; data-end=&quot;2267&quot;&gt;Đúng, nhiều MCU có BootROM bootloader để nạp lại firmware.&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2269&quot; data-end=&quot;2315&quot;&gt;Ví dụ BootROM có thể hỗ trợ các giao tiếp như:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2317&quot; data-end=&quot;2353&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;UART&lt;/span&gt;&lt;br&gt;&lt;span&gt;USB DFU&lt;/span&gt;&lt;br&gt;&lt;span&gt;SPI&lt;/span&gt;&lt;br&gt;&lt;span&gt;I2C&lt;/span&gt;&lt;br&gt;&lt;span&gt;CAN&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;2355&quot; data-end=&quot;2442&quot;&gt;Khi vào bootloader mode, BootROM không chạy app ngay mà chờ lệnh từ máy tính hoặc host.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2444&quot; data-end=&quot;2450&quot;&gt;Ví dụ:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2452&quot; data-end=&quot;2653&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Boot mode chọn System Bootloader&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM chạy&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM chờ dữ liệu từ UART/USB&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;PC gửi firmware mới&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM ghi firmware vào Flash&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Reset lại&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;MCU chạy app mới&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;2655&quot; data-end=&quot;2723&quot;&gt;Đây là lý do nhiều MCU có thể nạp firmware mà không cần debug probe.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;2725&quot; data-end=&quot;2728&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;1ux6yh0&quot; data-start=&quot;2730&quot; data-end=&quot;2757&quot;&gt;5. Còn JTAG/SWD thì sao?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;2759&quot; data-end=&quot;2781&quot;&gt;Chỗ này cần chỉnh nhẹ.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2783&quot; data-end=&quot;2843&quot;&gt;&lt;strong data-start=&quot;2783&quot; data-end=&quot;2843&quot;&gt;JTAG/SWD thường không phải là protocol do BootROM xử lý.&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2845&quot; data-end=&quot;2916&quot;&gt;JTAG/SWD là giao tiếp debug phần cứng đi vào debug module của CPU/chip.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2918&quot; data-end=&quot;2939&quot;&gt;Nó cho phép debugger:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2941&quot; data-end=&quot;3055&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;halt CPU&lt;/span&gt;&lt;br&gt;&lt;span&gt;đọc/ghi memory&lt;/span&gt;&lt;br&gt;&lt;span&gt;ghi Flash thông qua flash algorithm&lt;/span&gt;&lt;br&gt;&lt;span&gt;set breakpoint&lt;/span&gt;&lt;br&gt;&lt;span&gt;step instruction&lt;/span&gt;&lt;br&gt;&lt;span&gt;reset chip&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;3057&quot; data-end=&quot;3135&quot;&gt;Khi bạn nạp firmware bằng ST-Link/J-Link/OpenOCD qua JTAG/SWD, thường flow là:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3137&quot; data-end=&quot;3325&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;PC debugger&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;JTAG/SWD debug port&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Debug Access Port / CoreSight / Debug Module&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Ghi RAM hoặc điều khiển CPU chạy flash programming algorithm&lt;/span&gt;&lt;br&gt;&lt;span&gt;  ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Ghi firmware vào Flash&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;3327&quot; data-end=&quot;3370&quot;&gt;Tức là &lt;strong data-start=&quot;3334&quot; data-end=&quot;3369&quot;&gt;không nhất thiết đi qua BootROM&lt;/strong&gt;.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;3372&quot; data-end=&quot;3386&quot;&gt;So sánh nhanh:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3388&quot; data-end=&quot;3537&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;UART/USB bootloader:&lt;/span&gt;&lt;br&gt;&lt;span&gt;  thường là BootROM chạy code nhận firmware&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;JTAG/SWD:&lt;/span&gt;&lt;br&gt;&lt;span&gt;  thường là debug hardware điều khiển chip, không cần BootROM&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;hr data-start=&quot;3539&quot; data-end=&quot;3542&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;oqtuw7&quot; data-start=&quot;3544&quot; data-end=&quot;3600&quot;&gt;6. BootROM có “quyết định app được nạp từ đâu” không?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;3602&quot; data-end=&quot;3668&quot;&gt;Câu này đúng nếu đang nói về &lt;strong data-start=&quot;3631&quot; data-end=&quot;3667&quot;&gt;boot/load firmware khi khởi động&lt;/strong&gt;.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;3670&quot; data-end=&quot;3700&quot;&gt;Ví dụ với SoC boot từ SD card:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3702&quot; data-end=&quot;3797&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;BootROM quyết định đọc boot image từ SD card&lt;/span&gt;&lt;br&gt;&lt;span&gt;sau đó load vào RAM&lt;/span&gt;&lt;br&gt;&lt;span&gt;rồi jump vào image&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;3799&quot; data-end=&quot;3813&quot;&gt;Hoặc với QSPI:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3815&quot; data-end=&quot;3904&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-fu