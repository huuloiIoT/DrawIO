            <mxGeometry height="7490" width="820" x="1010" y="1500" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;font style=&quot;font-size: 60px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;div class=&quot;&quot; data-turn-id-container=&quot;13b0189a-0d42-4835-ba34-2186865dcae9&quot; data-is-intersecting=&quot;true&quot;&gt;&lt;section class=&quot;text-token-text-primary w-full focus:outline-none has-data-writing-block:pointer-events-none [&amp;amp;:has([data-writing-block])&amp;gt;*]:pointer-events-auto R6Vx5W_threadScrollVars scroll-mb-[calc(var(--scroll-root-safe-area-inset-bottom,0px)+var(--thread-response-height))] scroll-mt-(--header-height)&quot; dir=&quot;auto&quot; data-turn-id=&quot;13b0189a-0d42-4835-ba34-2186865dcae9&quot; data-turn-id-container=&quot;13b0189a-0d42-4835-ba34-2186865dcae9&quot; data-testid=&quot;conversation-turn-11&quot; data-turn=&quot;user&quot;&gt;&lt;div class=&quot;text-base my-auto mx-auto pt-12 [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)&quot;&gt;&lt;div data-conversation-screenshot-content=&quot;&quot; class=&quot;[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col&quot;&gt;&lt;div class=&quot;flex max-w-full flex-col gap-4 grow&quot;&gt;&lt;div data-message-author-role=&quot;user&quot; data-message-id=&quot;13b0189a-0d42-4835-ba34-2186865dcae9&quot; dir=&quot;auto&quot; class=&quot;min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;amp;]:mt-1&quot;&gt;&lt;div class=&quot;flex w-full flex-col gap-1 empty:hidden items-end rtl:items-start&quot;&gt;&lt;div class=&quot;user-message-bubble-color corner-superellipse/0.98 relative min-w-0 overflow-hidden rounded-[22px] px-4 py-2.5 leading-6 max-w-(--user-chat-width,70%)&quot;&gt;&lt;div class=&quot;max-w-full min-w-0 [overflow-wrap:anywhere] whitespace-pre-wrap&quot;&gt;&lt;font style=&quot;font-size: 60px;&quot;&gt;THeo tôi hiểu là khi tắt nguồn mở lại MCU sẽ chạy từ boot rom. Còn khi CPU bị treo và được watch dog reset lại thì sẽ chạy từ reset handle có đúng không? nếu đúng thì giải thích tại sao không boot từ boot rom trong mọi trường hợp&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;z-0 flex justify-end&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/section&gt;&lt;/div&gt;&lt;div class=&quot;&quot; data-turn-id-container=&quot;7915e164-ef5b-4e22-8f37-98e83ecf0233&quot; data-is-intersecting=&quot;true&quot;&gt;&lt;section class=&quot;text-token-text-primary w-full focus:outline-none has-data-writing-block:pointer-events-none [&amp;amp;:has([data-writing-block])&amp;gt;*]:pointer-events-auto R6Vx5W_threadScrollVars scroll-mb-[calc(var(--scroll-root-safe-area-inset-bottom,0px)+var(--thread-response-height))] scroll-mt-[calc(var(--header-height)+min(200px,max(70px,20svh)))]&quot; dir=&quot;auto&quot; data-turn-id=&quot;7915e164-ef5b-4e22-8f37-98e83ecf0233&quot; data-turn-id-container=&quot;7915e164-ef5b-4e22-8f37-98e83ecf0233&quot; data-testid=&quot;conversation-turn-12&quot; data-turn=&quot;assistant&quot;&gt;&lt;div class=&quot;text-base my-auto mx-auto [--thread-content-margin:var(--thread-content-margin-xs,calc(var(--spacing)*4))] @w-sm/main:[--thread-content-margin:var(--thread-content-margin-sm,calc(var(--spacing)*6))] @w-lg/main:[--thread-content-margin:var(--thread-content-margin-lg,calc(var(--spacing)*16))] px-(--thread-content-margin)&quot;&gt;&lt;div data-conversation-screenshot-content=&quot;&quot; class=&quot;[--thread-content-max-width:40rem] @w-lg/main:[--thread-content-max-width:48rem] mx-auto max-w-(--thread-content-max-width) flex-1 group/turn-messages focus-visible:outline-hidden relative flex w-full min-w-0 flex-col agent-turn&quot;&gt;&lt;div class=&quot;flex max-w-full flex-col gap-4 grow&quot;&gt;&lt;div class=&quot;flex items-center justify-between&quot;&gt;&lt;div class=&quot;flex min-w-0 items-center&quot;&gt;&lt;button type=&quot;button&quot; class=&quot;text-token-text-tertiary hover:text-token-text-primary dark:hover:text-token-text-primary flex items-center gap-0.5 text-start dark:text-(--interactive-label-tertiary-default)&quot;&gt;Thought for a couple of seconds&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;20&quot; height=&quot;20&quot; aria-hidden=&quot;true&quot; data-rtl-flip=&quot;&quot; class=&quot;icon-xs&quot;&gt;&lt;/svg&gt;&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-message-author-role=&quot;assistant&quot; data-message-id=&quot;47459a60-0797-4779-8f2f-459dbdfa993b&quot; dir=&quot;auto&quot; data-message-model-slug=&quot;gpt-5-5-thinking&quot; class=&quot;min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;amp;]:mt-1&quot;&gt;&lt;div class=&quot;flex w-full flex-col gap-1 empty:hidden&quot;&gt;&lt;div class=&quot;markdown prose dark:prose-invert wrap-break-word w-full light markdown-new-styling&quot;&gt;&lt;p data-start=&quot;0&quot; data-end=&quot;63&quot;&gt;Bạn hiểu &lt;strong data-start=&quot;9&quot; data-end=&quot;21&quot;&gt;gần đúng&lt;/strong&gt;, nhưng cần chỉnh lại một điểm quan trọng:&lt;/p&gt;&lt;br&gt;&lt;blockquote data-start=&quot;65&quot; data-end=&quot;231&quot;&gt;&lt;br&gt;&lt;p data-start=&quot;67&quot; data-end=&quot;231&quot;&gt;&lt;strong data-start=&quot;67&quot; data-end=&quot;231&quot;&gt;Watchdog reset không nhảy vào một “watchdog handler” riêng. Nó reset CPU gần giống như reset bình thường, rồi CPU bắt đầu lại từ reset vector → &lt;code data-start=&quot;213&quot; data-end=&quot;228&quot;&gt;Reset_Handler&lt;/code&gt;.&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;/blockquote&gt;&lt;br&gt;&lt;p data-start=&quot;233&quot; data-end=&quot;322&quot;&gt;Còn chuyện có chạy qua &lt;strong data-start=&quot;256&quot; data-end=&quot;267&quot;&gt;BootROM&lt;/strong&gt; hay không thì &lt;strong data-start=&quot;282&quot; data-end=&quot;321&quot;&gt;phụ thuộc thiết kế của từng MCU/SoC&lt;/strong&gt;.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;324&quot; data-end=&quot;327&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;1uf6wj3&quot; data-start=&quot;329&quot; data-end=&quot;384&quot;&gt;1. Power-on reset và watchdog reset khác nhau ở đâu?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;386&quot; data-end=&quot;406&quot;&gt;Có nhiều loại reset:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;408&quot; data-end=&quot;604&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Power-on reset      : bật nguồn lên&lt;/span&gt;&lt;br&gt;&lt;span&gt;External reset pin  : nhấn chân RESET&lt;/span&gt;&lt;br&gt;&lt;span&gt;Watchdog reset      : watchdog timeout&lt;/span&gt;&lt;br&gt;&lt;span&gt;Software reset      : CPU tự yêu cầu reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;Brown-out reset     : sụt áp&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;606&quot; data-end=&quot;661&quot;&gt;Nhưng sau reset, CPU thường quay về trạng thái ban đầu:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;663&quot; data-end=&quot;771&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;PC = reset vector&lt;/span&gt;&lt;br&gt;&lt;span&gt;SP = initial stack pointer&lt;/span&gt;&lt;br&gt;&lt;span&gt;clock/peripheral về trạng thái reset tùy loại reset&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;773&quot; data-end=&quot;809&quot;&gt;Với Cortex-M thông dụng, CPU sẽ đọc:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;811&quot; data-end=&quot;920&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Vector table base + 0x00 → Initial Stack Pointer&lt;/span&gt;&lt;br&gt;&lt;span&gt;Vector table base + 0x04 → Reset_Handler address&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;922&quot; data-end=&quot;950&quot;&gt;Sau đó chạy &lt;code data-start=&quot;934&quot; data-end=&quot;949&quot;&gt;Reset_Handler&lt;/code&gt;.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;952&quot; data-end=&quot;955&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;z2z6ox&quot; data-start=&quot;957&quot; data-end=&quot;1020&quot;&gt;&lt;span role=&quot;text&quot;&gt;2. Vậy khi watchdog reset thì có chạy &lt;code data-start=&quot;998&quot; data-end=&quot;1013&quot;&gt;Reset_Handler&lt;/code&gt; không?&lt;/span&gt;&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;1022&quot; data-end=&quot;1029&quot;&gt;&lt;strong data-start=&quot;1022&quot; data-end=&quot;1029&quot;&gt;Có.&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1031&quot; data-end=&quot;1105&quot;&gt;Watchdog reset không resume lại chỗ CPU bị treo. Nó đưa CPU về reset flow.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1107&quot; data-end=&quot;1121&quot;&gt;Flow đơn giản:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1123&quot; data-end=&quot;1284&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;CPU bị treo&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Watchdog timeout&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Reset MCU/CPU&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;CPU đọc vector table&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;CPU nhảy vào Reset_Handler&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Startup code chạy lại&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;main()&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;1286&quot; data-end=&quot;1334&quot;&gt;Vì vậy watchdog reset vẫn chạy lại startup code:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1336&quot; data-end=&quot;1381&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Reset_Handler&lt;/span&gt;&lt;br&gt;&lt;span&gt;SystemInit()&lt;/span&gt;&lt;br&gt;&lt;span&gt;main()&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;hr data-start=&quot;1383&quot; data-end=&quot;1386&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;balvyb&quot; data-start=&quot;1388&quot; data-end=&quot;1448&quot;&gt;3. Vậy khi tắt nguồn mở lại thì có chạy từ BootROM không?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;1450&quot; data-end=&quot;1470&quot;&gt;Câu trả lời đúng là:&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1472&quot; data-end=&quot;1561&quot;&gt;&lt;strong data-start=&quot;1472&quot; data-end=&quot;1561&quot;&gt;Có thể có, nhưng không phải lúc nào cũng theo nghĩa “app của bạn bắt đầu từ BootROM”.&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1563&quot; data-end=&quot;1601&quot;&gt;Tùy chip, có 2 kiểu thiết kế phổ biến.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;1603&quot; data-end=&quot;1606&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;cahwwf&quot; data-start=&quot;1608&quot; data-end=&quot;1666&quot;&gt;4. Kiểu 1: MCU đơn giản — CPU reset thẳng vào Flash app&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;1668&quot; data-end=&quot;1731&quot;&gt;Nhiều MCU như ARM Cortex-M truyền thống có cơ chế boot mapping.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;1733&quot; data-end=&quot;1756&quot;&gt;Khi boot từ user Flash:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1758&quot; data-end=&quot;1859&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Power-on reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;CPU đọc vector table ở Flash&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Nhảy vào Reset_Handler của firmware&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;1861&quot; data-end=&quot;1867&quot;&gt;Ví dụ:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1869&quot; data-end=&quot;1937&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;0x08000000: Initial SP&lt;/span&gt;&lt;br&gt;&lt;span&gt;0x08000004: Reset_Handler address&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;1939&quot; data-end=&quot;1977&quot;&gt;Trong trường hợp này, bạn có thể hiểu:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;1979&quot; data-end=&quot;2033&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Bật nguồn → chạy Reset_Handler trong Flash&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;2035&quot; data-end=&quot;2134&quot;&gt;BootROM của hãng chỉ được dùng nếu chọn boot mode đặc biệt, ví dụ boot từ UART/USB để nạp firmware.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;2136&quot; data-end=&quot;2139&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;133jlqe&quot; data-start=&quot;2141&quot; data-end=&quot;2200&quot;&gt;5. Kiểu 2: SoC/MCU phức tạp — BootROM luôn chạy đầu tiên&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;2202&quot; data-end=&quot;2346&quot;&gt;Một số chip phức tạp hơn, nhất là SoC, MPU, chip có secure boot, external flash, RISC-V SoC, i.MX, ESP32, v.v., thường có BootROM chạy đầu tiên.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2348&quot; data-end=&quot;2363&quot;&gt;Flow có thể là:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2365&quot; data-end=&quot;2613&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Power-on reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM chạy trước&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM kiểm tra boot mode / strap pin / fuse&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM tìm firmware trong Flash/eMMC/SD/QSPI&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM load hoặc xác thực firmware&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Nhảy vào Reset_Handler / entry point của firmware&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;2615&quot; data-end=&quot;2684&quot;&gt;Trong kiểu này, khi bật nguồn, BootROM thực sự là code đầu tiên chạy.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;2686&quot; data-end=&quot;2689&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;ytx163&quot; data-start=&quot;2691&quot; data-end=&quot;2738&quot;&gt;6. Vậy watchdog reset có chạy BootROM không?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;2740&quot; data-end=&quot;2755&quot;&gt;Phụ thuộc chip.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2757&quot; data-end=&quot;2841&quot;&gt;Có chip watchdog reset gần như tạo lại reset toàn hệ thống, BootROM có thể chạy lại.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2843&quot; data-end=&quot;2938&quot;&gt;Có chip watchdog chỉ reset CPU core hoặc một phần system, rồi CPU quay về reset vector của app.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2940&quot; data-end=&quot;2967&quot;&gt;Có chip có nhiều mức reset:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2969&quot; data-end=&quot;3110&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Core reset       : reset CPU core thôi&lt;/span&gt;&lt;br&gt;&lt;span&gt;System reset     : reset CPU + bus + peripheral&lt;/span&gt;&lt;br&gt;&lt;span&gt;Power-on reset   : reset gần như toàn chip&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;3112&quot; data-end=&quot;3148&quot;&gt;Vì vậy không nên nói tuyệt đối rằng:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;3150&quot; data-end=&quot;3221&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content