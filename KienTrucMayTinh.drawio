        </UserObject>
        <UserObject label="&lt;div&gt;&lt;font style=&quot;font-size: 60px;&quot;&gt;Reset_Handler nằm trong bootrom hay flash nơi chứa startup code&lt;/font&gt;&lt;/div&gt;&lt;br&gt;&lt;div class=&quot;flex items-center justify-between&quot;&gt;&lt;div class=&quot;flex min-w-0 items-center&quot;&gt;&lt;button type=&quot;button&quot; class=&quot;text-token-text-tertiary hover:text-token-text-primary dark:hover:text-token-text-primary flex items-center gap-0.5 text-start dark:text-(--interactive-label-tertiary-default)&quot;&gt;Thought for a couple of seconds&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;20&quot; height=&quot;20&quot; aria-hidden=&quot;true&quot; data-rtl-flip=&quot;&quot; class=&quot;icon-xs&quot;&gt;&lt;/svg&gt;&lt;/button&gt;&lt;/div&gt;&lt;/div&gt;&lt;div data-message-author-role=&quot;assistant&quot; data-message-id=&quot;47459a60-0797-4779-8f2f-459dbdfa993b&quot; dir=&quot;auto&quot; data-message-model-slug=&quot;gpt-5-5-thinking&quot; class=&quot;min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;amp;]:mt-1&quot;&gt;&lt;div class=&quot;flex w-full flex-col gap-1 empty:hidden&quot;&gt;&lt;div class=&quot;markdown prose dark:prose-invert wrap-break-word w-full light markdown-new-styling&quot;&gt;&lt;p data-start=&quot;0&quot; data-end=&quot;63&quot;&gt;Bạn hiểu &lt;strong data-start=&quot;9&quot; data-end=&quot;21&quot;&gt;gần đúng&lt;/strong&gt;, nhưng cần chỉnh lại một điểm quan trọng:&lt;/p&gt;&lt;br&gt;&lt;blockquote data-start=&quot;65&quot; data-end=&quot;231&quot;&gt;&lt;br&gt;&lt;p data-start=&quot;67&quot; data-end=&quot;231&quot;&gt;&lt;strong data-start=&quot;67&quot; data-end=&quot;231&quot;&gt;Watchdog reset không nhảy vào một “watchdog handler” riêng. Nó reset CPU gần giống như reset bình thường, rồi CPU bắt đầu lại từ reset vector → &lt;code data-start=&quot;213&quot; data-end=&quot;228&quot;&gt;Reset_Handler&lt;/code&gt;.&lt;/strong&gt;&lt;/p&gt;&lt;br&gt;&lt;/blockquote&gt;&lt;br&gt;&lt;p data-start=&quot;233&quot; data-end=&quot;322&quot;&gt;Còn chuyện có chạy qua &lt;strong data-start=&quot;256&quot; data-end=&quot;267&quot;&gt;BootROM&lt;/strong&gt; hay không thì &lt;strong data-start=&quot;282&quot; data-end=&quot;321&quot;&gt;phụ thuộc thiết kế của từng MCU/SoC&lt;/strong&gt;.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;324&quot; data-end=&quot;327&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;1uf6wj3&quot; data-start=&quot;329&quot; data-end=&quot;384&quot;&gt;1. Power-on reset và watchdog reset khác nhau ở đâu?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;386&quot; data-end=&quot;406&quot;&gt;Có nhiều loại reset:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;408&quot; data-end=&quot;604&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Power-on reset      : bật nguồn lên&lt;/span&gt;&lt;br&gt;&lt;span&gt;External reset pin  : nhấn chân RESET&lt;/span&gt;&lt;br&gt;&lt;span&gt;Watchdog reset      : watchdog timeout&lt;/span&gt;&lt;br&gt;&lt;span&gt;Software reset      : CPU tự yêu cầu reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;Brown-out reset     : sụt áp&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;606&quot; data-end=&quot;661&quot;&gt;Nhưng sau reset, CPU thường quay về trạng thái ban đầu:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;663&quot; data-end=&quot;771&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;PC = reset vector&lt;/span&gt;&lt;br&gt;&lt;span&gt;SP = initial stack pointer&lt;/span&gt;&lt;br&gt;&lt;span&gt;clock/peripheral về trạng thái reset tùy loại reset&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;773&quot; data-end=&quot;809&quot;&gt;Với Cortex-M thông dụng, CPU sẽ đọc:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;811&quot; data-end=&quot;920&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Vector table base + 0x00 → Initial Stack Pointer&lt;/span&gt;&lt;br&gt;&lt;span&gt;Vector table base + 0x04 → Reset_Handler address&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div