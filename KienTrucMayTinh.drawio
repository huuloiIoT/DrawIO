min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Bật nguồn → chạy Reset_Handler trong Flash&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;2035&quot; data-end=&quot;2134&quot;&gt;BootROM của hãng chỉ được dùng nếu chọn boot mode đặc biệt, ví dụ boot từ UART/USB để nạp firmware.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;2136&quot; data-end=&quot;2139&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;133jlqe&quot; data-start=&quot;2141&quot; data-end=&quot;2200&quot;&gt;5. Kiểu 2: SoC/MCU phức tạp — BootROM luôn chạy đầu tiên&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;2202&quot; data-end=&quot;2346&quot;&gt;Một số chip phức tạp hơn, nhất là SoC, MPU, chip có secure boot, external flash, RISC-V SoC, i.MX, ESP32, v.v., thường có BootROM chạy đầu tiên.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2348&quot; data-end=&quot;2363&quot;&gt;Flow có thể là:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2365&quot; data-end=&quot;2613&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span&gt;Power-on reset&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM chạy trước&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM kiểm tra boot mode / strap pin / fuse&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM tìm firmware trong Flash/eMMC/SD/QSPI&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;BootROM load hoặc xác thực firmware&lt;/span&gt;&lt;br&gt;&lt;span&gt;   ↓&lt;/span&gt;&lt;br&gt;&lt;span&gt;Nhảy vào Reset_Handler / entry point của firmware&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/pre&gt;&lt;br&gt;&lt;p data-start=&quot;2615&quot; data-end=&quot;2684&quot;&gt;Trong kiểu này, khi bật nguồn, BootROM thực sự là code đầu tiên chạy.&lt;/p&gt;&lt;br&gt;&lt;hr data-start=&quot;2686&quot; data-end=&quot;2689&quot;&gt;&lt;br&gt;&lt;h2 data-section-id=&quot;ytx163&quot; data-start=&quot;2691&quot; data-end=&quot;2738&quot;&gt;6. Vậy watchdog reset có chạy BootROM không?&lt;/h2&gt;&lt;br&gt;&lt;p data-start=&quot;2740&quot; data-end=&quot;2755&quot;&gt;Phụ thuộc chip.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2757&quot; data-end=&quot;2841&quot;&gt;Có chip watchdog reset gần như tạo lại reset toàn hệ thống, BootROM có thể chạy lại.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2843&quot; data-end=&quot;2938&quot;&gt;Có chip watchdog chỉ reset CPU core hoặc một phần system, rồi CPU quay về reset vector của app.&lt;/p&gt;&lt;br&gt;&lt;p data-start=&quot;2940&quot; data-end=&quot;2967&quot;&gt;Có chip có nhiều mức reset:&lt;/p&gt;&lt;br&gt;&lt;pre class=&quot;overflow-visible! px-0!&quot; data-start=&quot;2969&quot; data-end=&quot;3110&quot;&gt;&lt;div class=&quot;relative w-full mt-4 mb-1&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;contents&quot;&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;h-full min-h-0 min-w-0&quot;&gt;&lt;div class=&quot;border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl&quot;&gt;&lt;div class=&quot;h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback&quot;&gt;&lt;div class=&quot;pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1&quot;&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;pe-11 pt-3&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; c